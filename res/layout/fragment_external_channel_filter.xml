<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:id="@id/list_frame" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.github.mmin18.widget.FlexLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <FrameLayout android:layout_width="match_parent" app:layout_height="70%" app:layout_right="100%-8dp" app:layout_width="78%">
            <com.narvii.widget.PopupBubble android:id="@id/popup_bubble" android:layout_width="match_parent" android:layout_height="match_parent" app:popupBubbleColor="#ff4a4a4a" app:popupBubbleStrokeWidth="0.0dp">
                <com.narvii.widget.SpinningView android:layout_gravity="center" android:id="@android:id/progress" android:layout_width="@dimen/spin_large_size" android:layout_height="@dimen/spin_large_size" />
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
                    <include android:layout_width="match_parent" android:layout_height="match_parent" layout="@layout/list_view" />
                </LinearLayout>
                <include layout="@layout/empty_view" />
            </com.narvii.widget.PopupBubble>
        </FrameLayout>
    </com.github.mmin18.widget.FlexLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout android:id="@id/not_checked_today" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent">
        <View android:id="@id/green" android:background="@drawable/green_oval" android:layout_width="match_parent" android:layout_height="match_parent" />
        <ImageView android:id="@id/white" android:background="@drawable/white_oval" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="@dimen/check_in_streak_cell_stroke" />
    </FrameLayout>
    <FrameLayout android:id="@id/main_layout" android:layout_width="match_parent" android:layout_height="match_parent">
        <View android:id="@id/bg" android:background="@drawable/white_oval" android:layout_width="match_parent" android:layout_height="match_parent" />
        <ImageView android:id="@id/icon" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="@dimen/check_in_streak_cell_stroke" />
    </FrameLayout>
</FrameLayout>

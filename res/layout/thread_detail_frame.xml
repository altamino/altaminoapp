<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <include android:id="@id/disabled_bar" layout="@layout/detail_disabled_bar" />
    <com.narvii.widget.NVListOverlay android:id="@id/fake_actionbar" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_weight="1.0">
            <include android:layout_width="match_parent" android:layout_height="match_parent" layout="@layout/list_layout" />
            <FrameLayout android:layout_gravity="bottom" android:id="@id/bottom_container" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <FrameLayout android:id="@id/background_picker_container" android:layout_width="match_parent" android:layout_height="match_parent" />
        </FrameLayout>
        <com.narvii.list.overlay.OverlayLayout android:id="@id/list_header" android:clipChildren="false" android:layout_width="match_parent" android:layout_height="wrap_content" app:listOverlayMaxHeight="@dimen/thread_detail_header_height" />
        <include layout="@layout/not_available_layout" />
    </FrameLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout android:id="@id/_frame_layout_root" android:layout_width="match_parent" android:layout_height="match_parent">
        <com.narvii.widget.FullscreenBackgroundView android:id="@id/background" android:layout_width="match_parent" android:layout_height="match_parent" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
                <com.narvii.list.overlay.OverlayListPlaceholder android:id="@id/action_bar_overlay" android:visibility="visible" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <FrameLayout android:id="@id/list_frame" android:layout_width="match_parent" android:layout_height="0.0dp" android:layout_weight="1.0">
                    <com.narvii.widget.SpinningView android:layout_gravity="center" android:id="@android:id/progress" android:layout_width="@dimen/spin_large_size" android:layout_height="@dimen/spin_large_size" />
                    <include android:layout_width="match_parent" android:layout_height="match_parent" layout="@layout/list_view" />
                    <include layout="@layout/empty_view" />
                    <FrameLayout android:id="@id/video_overlay" android:layout_width="match_parent" android:layout_height="match_parent" />
                </FrameLayout>
                <FrameLayout android:layout_gravity="bottom" android:id="@id/bottom_container" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="5.0dp" />
            <solid android:color="#99164f00" />
            <stroke android:width="1.0dp" android:color="#ff58cc00" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="5.0dp" />
            <solid android:color="#99258200" />
            <stroke android:width="1.0dp" android:color="#ff6fff00" />
        </shape>
    </item>
</selector>

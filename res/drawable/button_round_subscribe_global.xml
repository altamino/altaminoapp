<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="5.0dp" />
            <gradient android:startColor="#bbffc200" android:endColor="#bbffaf00" android:angle="0.0" />
            <stroke android:width="0.5sp" android:color="#11000000" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="5.0dp" />
            <gradient android:startColor="#ffffc200" android:endColor="#ffffaf00" android:angle="0.0" />
            <stroke android:width="0.5sp" android:color="#11000000" />
        </shape>
    </item>
</selector>

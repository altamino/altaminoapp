<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="4.0dp" />
            <solid android:color="#ffc2c1c3" />
            <stroke android:width="0.5sp" android:color="#22000000" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="4.0dp" />
            <solid android:color="@color/chat_theme_color_pressed" />
            <stroke android:width="0.5sp" android:color="#22000000" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="4.0dp" />
            <solid android:color="@color/chat_theme_color_pressed" />
            <stroke android:width="0.5sp" android:color="#22000000" />
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape>
            <corners android:radius="4.0dp" />
            <solid android:color="@color/chat_theme_color" />
            <stroke android:width="0.5sp" android:color="#22000000" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="4.0dp" />
            <solid android:color="#ff2c5421" />
            <stroke android:width="0.5sp" android:color="#22000000" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="18.0dp" />
            <solid android:color="#aa00cd7b" />
            <stroke android:width="0.5sp" android:color="#11000000" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="18.0dp" />
            <solid android:color="#ff8bfccf" />
            <stroke android:width="0.5sp" android:color="#11000000" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="18.0dp" />
            <solid android:color="#ff00cd7b" />
            <stroke android:width="0.5sp" android:color="#11000000" />
        </shape>
    </item>
</selector>

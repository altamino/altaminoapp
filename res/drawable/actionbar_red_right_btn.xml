        <shape>
            <corners android:radius="@dimen/actionbar_button_corner_radius" />
            <solid android:color="#ffa2a2a2" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/actionbar_button_corner_radius" />

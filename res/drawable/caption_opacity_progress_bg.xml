<?xml version="1.0" encoding="utf-8"?>
<layer-list android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="3.0dp" />
            <solid android:color="@color/media_audio_seek_bar_bg_color" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="3.0dp" />
                <solid android:color="#fff5a623" />
            </shape>
        </clip>
    </item>
</layer-list>

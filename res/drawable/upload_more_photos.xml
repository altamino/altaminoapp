        <shape>
            <corners android:radius="6.0dp" />
            <solid android:color="#22000000" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="6.0dp" />
            <solid android:color="#22000000" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="6.0dp" />
            <solid android:color="#32ffffff" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="99999.0dp" />
            <solid android:color="#fff4ab24" />
            <stroke android:width="0.5dp" android:color="#ffff7800" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="99999.0dp" />
            <solid android:color="#ffff7800" />
            <stroke android:width="1.0dp" android:color="#fff4ab24" />
        </shape>
    </item>
</selector>

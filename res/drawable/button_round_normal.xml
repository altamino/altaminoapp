<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="4.0dp" />
            <solid android:color="#ffaaaaaa" />
            <stroke android:width="0.5sp" android:color="#ffa8a8a8" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="4.0dp" />
            <solid android:color="#ffaaaaaa" />
            <stroke android:width="0.5sp" android:color="#ffa8a8a8" />
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape>
            <corners android:radius="4.0dp" />
            <solid android:color="#ffdddddd" />
            <stroke android:width="0.5sp" android:color="#ffd8d8d8" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="4.0dp" />
            <solid android:color="#88dddddd" />
            <stroke android:width="0.5sp" android:color="#80d8d8d8" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="5.0dp" />
            <gradient android:startColor="#ff9349b3" android:endColor="#ff8e40b3" android:angle="0.0" />
            <stroke android:width="0.5sp" android:color="#11000000" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="5.0dp" />
            <gradient android:startColor="#ffd168ff" android:endColor="#ffca5bff" android:angle="0.0" />
            <stroke android:width="0.5sp" android:color="#11000000" />
        </shape>
    </item>
</selector>

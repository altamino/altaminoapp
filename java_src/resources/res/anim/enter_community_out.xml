<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" android:duration="165">
    <alpha
        android:interpolator="@android:interpolator/accelerate_quad"
        android:fromAlpha="1"
        android:toAlpha="0"/>
    <scale
        android:interpolator="@android:interpolator/accelerate_quad"
        android:pivotX="50%"
        android:pivotY="50%"
        android:fromXScale="1"
        android:toXScale="2"
        android:fromYScale="1"
        android:toYScale="2"/>
</set>

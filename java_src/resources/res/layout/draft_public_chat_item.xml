<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp">
    <ImageView
        android:id="@+id/delete"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="-10dp"
        android:src="@drawable/ic_item_delete"
        android:layout_marginStart="-10dp"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_marginEnd="10dp">
        <com.narvii.widget.ThumbImageView
            android:id="@+id/image"
            android:layout_width="60dp"
            android:layout_height="42dp"
            narvii:defaultDrawable="@color/placeholder"
            narvii:imageType="chat-cover"
            narvii:strokeColor="#888"
            narvii:strokeWidth="0.5dp"/>
        <TextView
            android:textSize="9dp"
            android:textColor="#aaa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_public_chat"
            android:singleLine="true"/>
    </LinearLayout>
    <include layout="@layout/draft_item_base"/>
</LinearLayout>

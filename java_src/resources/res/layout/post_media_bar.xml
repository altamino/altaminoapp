<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#fafafa"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="38dp">
    <View
        android:background="@drawable/shadow_drop"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_alignParentTop="true"/>
    <HorizontalScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="15dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="15dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/fans_only_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <include
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    layout="@layout/influencer_post_indicator"/>
                <View
                    android:background="#d2d2d4"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginRight="15dp"
                    android:layout_marginBottom="4dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="15dp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/pick_media"
                android:background="@drawable/button_round_transparent"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="1dp"
                android:src="@drawable/ic_camera"
                android:layout_marginStart="1dp"/>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.narvii.widget.ThumbImageView
                    android:id="@+id/media_preview"
                    android:background="@drawable/button_border_normal"
                    android:padding="0.5dp"
                    android:layout_width="20dp"
                    android:layout_height="22dp"
                    android:layout_marginLeft="5dp"
                    android:scaleType="centerCrop"
                    android:cropToPadding="true"
                    android:layout_marginStart="5dp"/>
                <TextView
                    android:textSize="9dp"
                    android:textStyle="bold"
                    android:textColor="#eee"
                    android:gravity="center"
                    android:layout_gravity="end|top"
                    android:id="@+id/media_count"
                    android:background="@drawable/number_bubble"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="-2dp"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="16dp"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/pick_item"
                android:background="@drawable/button_round_transparent"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="15dp"
                android:src="@drawable/ic_blog_favorite"
                android:layout_marginStart="15dp"/>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/item_preview_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.narvii.widget.CardView
                    android:id="@+id/item_card_preview"
                    android:layout_width="20dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginStart="5dp">
                    <com.narvii.widget.ThumbImageView
                        android:id="@+id/image"
                        android:duplicateParentState="true"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        narvii:cornerRadius="2dp"
                        narvii:defaultDrawable="@color/item_card_placeholder"
                        narvii:strokeColor="@color/item_card_stroke"
                        narvii:strokeWidth="@dimen/item_card_stroke_width"/>
                    <View
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"/>
                </com.narvii.widget.CardView>
                <TextView
                    android:textSize="9dp"
                    android:textStyle="bold"
                    android:textColor="#eee"
                    android:gravity="center"
                    android:id="@+id/item_count"
                    android:background="@drawable/number_bubble"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="18dp"
                    android:layout_marginTop="-2dp"
                    android:layout_marginStart="18dp"/>
            </FrameLayout>
            <com.narvii.widget.BackgroundPickerView
                android:id="@+id/background_picker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginStart="15dp"
                narvii:isLite="true"/>
            <ImageView
                android:id="@+id/pick_location"
                android:background="@drawable/button_round_transparent"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="16dp"
                android:src="@drawable/ic_location"
                android:layout_marginStart="16dp"/>
            <com.narvii.widget.SpinningView
                android:id="@+id/pick_locating_progress"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp"
                narvii:spinColor="@color/post_inactive_bg"
                narvii:spinSize="@dimen/spin_tiny_size"
                narvii:spinStyle="2"/>
            <Button
                android:textSize="12dp"
                android:textColor="#282a2b"
                android:gravity="center"
                android:id="@+id/post_categories"
                android:paddingLeft="10dp"
                android:paddingTop="0px"
                android:paddingRight="10dp"
                android:paddingBottom="0px"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="10dp"
                android:text="@string/categories"
                android:singleLine="true"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="10dp"/>
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.github.mmin18.widget.FlexLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#3a3b41"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.widget.StatusBarPlaceHolder
        android:id="@+id/status_bar_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_top="0dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/contentPanel"
        android:background="@drawable/editor_component_panel_bg"
        android:paddingBottom="40dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_bottom="100%">
        <com.narvii.video.widget.MediaOptionPanel
            android:id="@+id/options_panel"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_margin="10dp"/>
        <com.narvii.video.widget.MediaSpeedSelectView
            android:id="@+id/speed_select_view"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/progress_ll"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_bottom="contentPanel.top">
        <TextView
            android:textSize="12dp"
            android:textColor="#88ffffff"
            android:gravity="center"
            android:id="@+id/time_view"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="0:00.0"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="10dp"/>
        <SeekBar
            android:id="@+id/seekbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:max="1000"
            android:thumb="@drawable/dynamic_cropping_seekbar_thumb"
            android:layout_weight="1"
            android:thumbTint="@color/white"
            style="@style/DynamicCroppingSeekbarStyle"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#88ffffff"
            android:gravity="center"
            android:id="@+id/total_time_view"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:text="00:00.0"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginEnd="10dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/video_container"
        android:background="#000000"
        android:layout_height="match_parent"
        app:layout_bottom="progress_ll.top-4dp"
        app:layout_centerX="50%"
        app:layout_top="status_bar_placeholder.bottom+10dp"
        app:layout_width="this.height*0.5625">
        <com.narvii.video.widget.videoview.NVEditorPreviewVideoVIew
            android:id="@+id/video_view_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/pause_shadow"
            android:background="#18000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/player_button"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_action_play"/>
    </FrameLayout>
</com.github.mmin18.widget.FlexLayout>

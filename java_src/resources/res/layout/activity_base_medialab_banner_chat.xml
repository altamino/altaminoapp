<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <FrameLayout
        android:id="@+id/activity_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/frame_singleton"/>
    <FrameLayout
        android:id="@+id/frame_singleton"
        android:background="@android:color/black"
        android:paddingTop="@dimen/ad_top_padding"
        android:paddingBottom="@dimen/ad_bottom_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <ai.medialab.medialabads2.banners.MediaLabSingletonBanner
            android:id="@+id/media_lab_ad_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:adaptive="true"
            app:bannerGravity="center"
            app:bannerHeight="@dimen/ad_height"
            app:screenName="chat"/>
    </FrameLayout>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.narvii.livelayer.detailview.LiveLayerDetailListItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="10dp"
    android:paddingTop="5dp"
    android:paddingRight="10dp"
    android:paddingBottom="5dp"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="146dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <com.narvii.widget.ThumbImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        narvii:cornerRadius="5dp"
        narvii:defaultDrawable="@drawable/live_layer_detail_item_placeholder"
        narvii:hidePlayButton="true"
        narvii:imageType="chat-cover"/>
    <com.narvii.widget.MarqueeTextView
        android:textSize="11dp"
        android:textColor="#fff"
        android:id="@+id/screen_room_playing"
        android:background="@drawable/live_layer_screen_room_title_background"
        android:paddingLeft="20dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginLeft="-15dp"
        android:layout_marginTop="8dp"
        android:maxWidth="200dp"
        android:layout_toRightOf="@+id/rtc_indicator_view"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:layout_marginStart="-15dp"
        android:layout_toEndOf="@+id/rtc_indicator_view"/>
    <com.narvii.widget.RtcIndicatorView
        android:id="@+id/rtc_indicator_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="22dp"
        android:textStyle="bold"
        android:textColor="#f2f2f2"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="40dp"
        android:maxLines="2"
        android:shadowColor="#0000"
        android:shadowDy="3"
        android:shadowRadius="8"
        android:textAlignment="viewStart"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="40dp"/>
    <include layout="@layout/fans_only_content_indicator_layout_live_chat"/>
    <com.github.mmin18.widget.FlexLayout
        android:id="@+id/organizer_speaking_layout"
        android:clipChildren="false"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="10dp"
        android:layout_marginBottom="10dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="10dp"
        android:layout_alignParentStart="true">
        <com.narvii.chat.video.view.UserSpeakingView
            android:id="@+id/user_speaking"
            android:minWidth="40dp"
            android:minHeight="40dp"
            narvii:layout_height="this.width"
            narvii:layout_width="100%"
            narvii:rippleScale="1.6"/>
        <com.narvii.widget.ThumbImageView
            android:id="@+id/organizer_avatar"
            android:padding="2dp"
            android:minWidth="40dp"
            android:minHeight="40dp"
            narvii:layout_height="this.width"
            narvii:layout_width="100%"
            style="@style/AvatarImageView"/>
    </com.github.mmin18.widget.FlexLayout>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/sr_anim"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="43dp"
        android:layout_marginLeft="10dp"
        android:layout_marginBottom="2dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="10dp"
        android:layout_alignParentStart="true"
        narvii:lottie_fileName="live_layer_sr.json"
        narvii:lottie_loop="true"/>
    <include layout="@layout/live_layer_detail_item_bar"/>
</com.narvii.livelayer.detailview.LiveLayerDetailListItemView>

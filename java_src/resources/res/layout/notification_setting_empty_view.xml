<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">
    <com.narvii.app.theme.view.NVThemeTextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/empty_text_color"
        android:gravity="center"
        android:paddingTop="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/join_community_hint"
        app:nv_dark_textColor="@android:color/white"/>
    <com.narvii.widget.FontAwesomeView
        android:textSize="36dp"
        android:textColor="@color/button_text_gray_w"
        android:gravity="center"
        android:id="@+id/empty_retry"
        android:padding="12dp"
        android:clickable="true"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:text="@string/ion_refresh"/>
</LinearLayout>

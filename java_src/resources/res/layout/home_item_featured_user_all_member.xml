<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="18dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:background="#ffff"
        android:layout_width="1dp"
        android:layout_height="45dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="35dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="35dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/all_member_container"
        android:background="@drawable/home_item_all_members_bg"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginRight="5dp"
        android:layout_marginEnd="5dp">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/ic_home_all_members"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="18dp"
            android:layout_marginEnd="18dp">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:id="@+id/member_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.narvii.widget.AutoSizingTextView
                android:textSize="13dp"
                android:textColor="#fff"
                android:id="@+id/all_members"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="150dp"
                android:text="@string/community_all_members"
                android:maxLines="1"
                android:singleLine="true"
                app:autoSizeTextMaxSize="13dp"
                app:autoSizeTextMinSize="8dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

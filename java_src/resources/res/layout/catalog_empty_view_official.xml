<?xml version="1.0" encoding="utf-8"?>
<com.github.mmin18.widget.FlexLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/empty_view_text_size"
        android:textStyle="bold"
        android:textColor="@color/gold"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/empty_content"
        android:paddingTop="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/folder_empty"
        app:layout_centerX="50%"
        app:layout_centerY="35%"/>
    <com.narvii.widget.FontAwesomeView
        android:textColor="@color/gold"
        android:gravity="center"
        android:id="@+id/empty_retry"
        android:padding="12dp"
        android:clickable="true"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="@string/ion_refresh"
        app:layout_centerX="50%"
        app:layout_top="prev.bottom+10dp"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_centerX="50%"
        app:layout_top="prev.bottom+10dp"
        layout="@layout/catalog_submit_favorite"/>
</com.github.mmin18.widget.FlexLayout>

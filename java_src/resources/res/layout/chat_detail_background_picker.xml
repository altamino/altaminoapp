<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/background_picker_layout"
        android:background="#e6000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:textSize="14dp"
                android:textColor="#fff"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_a_background"/>
            <com.narvii.widget.NVImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/cancel"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_p2a_custom_cancel"
                android:scaleType="centerInside"/>
            <com.narvii.widget.NVImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/done"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_p2a_custom_confirm"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <View
            android:background="#4dffffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <com.narvii.chat.ChatBackgroundPickerRecycler
            android:id="@+id/chat_background_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="25dp"
            narvii:show_upload="false"/>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.github.mmin18.widget.FlexLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#3a3b41"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.widget.StatusBarPlaceHolder
        android:id="@+id/status_bar_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_top="0dp"/>
    <RelativeLayout
        android:id="@+id/contentPanel"
        android:background="@drawable/editor_component_panel_bg"
        android:paddingBottom="40dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_bottom="100%">
        <com.narvii.video.widget.MediaOptionPanel
            android:id="@+id/options_panel"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_margin="10dp"
            android:layout_alignParentTop="true"/>
        <com.narvii.video.widget.MediaTimeLineComponent
            android:id="@+id/video_time_line_component"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/scene_editor_time_line_item_height"
            android:layout_marginTop="8dp"
            android:layout_below="@+id/options_panel"
            app:frameCountInBaseRect="22"
            app:frameOffset="11">
            <com.narvii.widget.HorizontalRecyclerView
                android:id="@+id/video_time_line"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
            <View
                android:layout_gravity="center"
                android:background="@drawable/media_timeline_pointer_bg"
                android:layout_width="@dimen/scene_editor_time_line_pointer_width"
                android:layout_height="@dimen/scene_editor_time_line_pointer_height"/>
        </com.narvii.video.widget.MediaTimeLineComponent>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:id="@+id/video_playback_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_below="@+id/video_time_line_component"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/do_split"
            android:layout_width="50dp"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/ic_do_split"
            android:scaleType="fitCenter"
            android:layout_below="@+id/video_playback_time"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/undo_split"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="18dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/ic_undo"
            android:scaleType="fitCenter"
            android:layout_below="@+id/video_playback_time"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/video_container"
        android:background="#000000"
        android:layout_height="match_parent"
        app:layout_bottom="contentPanel.top-10dp"
        app:layout_centerX="50%"
        app:layout_top="status_bar_placeholder.bottom+10dp"
        app:layout_width="this.height*0.5625">
        <com.narvii.video.widget.videoview.NVEditorPreviewVideoVIew
            android:id="@+id/video_view_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/pause_shadow"
            android:background="#18000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/player_button"
            android:visibility="gone"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:src="@drawable/ic_sr_media_play"/>
    </FrameLayout>
</com.github.mmin18.widget.FlexLayout>

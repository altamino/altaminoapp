<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <FrameLayout
        android:id="@+id/media_container"
        android:paddingTop="@dimen/detail_link_post_padding_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.narvii.widget.FlexSizeImageView
            android:layout_gravity="center"
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitCenter"
            narvii:defaultDrawable="@drawable/placeholder_photo_transparent"
            narvii:keepRatio="true"
            narvii:preferredRatio="0.65"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#f2f2f2"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/text"
            android:background="#0000"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <com.narvii.widget.ShareMediaBar
            android:id="@+id/share_media_bar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/recent_activity_entry"
    android:background="@color/light_blue"
    android:paddingLeft="11dp"
    android:paddingTop="8dp"
    android:paddingRight="11dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="11dp"
    android:paddingEnd="11dp">
    <TextView
        android:textSize="13dp"
        android:textColor="#fff"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="5dp"
        android:maxLines="2"
        android:layout_toLeftOf="@+id/chevron_right"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:textAlignment="viewStart"
        android:layout_marginEnd="5dp"
        android:layout_toStartOf="@+id/chevron_right"
        android:layout_alignParentStart="true"/>
    <com.narvii.widget.FontAwesomeView
        android:gravity="center"
        android:id="@+id/chevron_right"
        android:background="@drawable/on_boarding_chevron_mirror"
        android:layout_width="8dp"
        android:layout_height="12dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>

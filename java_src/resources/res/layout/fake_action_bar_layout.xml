<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.narvii.widget.TintButton
        android:id="@+id/actionbar_back"
        android:background="@drawable/actionbar_left_btn"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_back_mirror"
        android:minWidth="46dp"
        android:minHeight="30dp"/>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@+id/actionbar_title"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:shadowColor="#0000"
        android:shadowDy="1"
        android:shadowRadius="5"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"/>
    <com.narvii.widget.TintButton
        android:layout_gravity="end|center_vertical"
        android:id="@+id/actionbar_right"
        android:background="@drawable/actionbar_left_btn"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="46dp"
        android:minHeight="30dp"/>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_toLeftOf="@+id/fans_only_content_indicator"
    android:layout_alignParentLeft="true"
    android:layout_alignParentTop="true"
    android:layout_alignParentRight="true"
    android:layout_toStartOf="@+id/fans_only_content_indicator"
    android:layout_alignParentStart="true"
    android:layout_alignParentEnd="true">
    <RelativeLayout
        android:id="@+id/user_click"
        android:paddingBottom="2dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="@dimen/user_click_right_padding"
        android:minWidth="100dp"
        android:layout_marginEnd="@dimen/user_click_right_padding">
        <include
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="10dp"
            android:layout_alignParentTop="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            layout="@layout/user_avatar_layout_mini"/>
        <com.narvii.widget.NicknameView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:id="@+id/nickname"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@+id/user_avatar_layout"
            android:layout_alignParentTop="true"
            android:paddingEnd="10dp"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/user_avatar_layout"
            narvii:hideRole="true"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/datetime"
            android:id="@+id/datetime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@+id/user_avatar_layout"
            android:layout_below="@+id/nickname"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/user_avatar_layout"/>
    </RelativeLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:background="@drawable/selector_membership_warning"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:src="@drawable/membership_bar_card_active"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#717379"
            android:ellipsize="end"
            android:id="@+id/expire_content"
            android:layout_width="0pt"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_weight="1"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/selector_orange"
            android:gravity="center"
            android:id="@+id/renew"
            android:background="@drawable/selector_orange_stroke"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/membership_renew"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <View
        android:background="#ccc"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="@dimen/item_padding_left_right"
    android:paddingTop="8dp"
    android:paddingRight="@dimen/item_padding_left_right"
    android:paddingBottom="8dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/item_padding_left_right"
    android:paddingEnd="@dimen/item_padding_left_right">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.narvii.widget.ThumbImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/avatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            style="@style/AvatarImageView"/>
        <LinearLayout
            android:layout_gravity="start|center_vertical"
            android:orientation="vertical"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <com.narvii.widget.NicknameView
                android:textSize="14dp"
                android:textColor="#2a87fa"
                android:id="@+id/nickname"
                android:background="@drawable/button_rect_transparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:hideRankingBadge="true"
                app:hideRole="true"/>
            <TextView
                android:textSize="10dp"
                android:textColor="#555"
                android:layout_gravity="start"
                android:id="@+id/logtime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:textSize="11dp"
            android:textColor="#fff"
            android:ellipsize="end"
            android:gravity="left"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/operation_name"
            android:padding="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="130dp"
            android:maxLines="3"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/target_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <TextView
            android:textSize="12dp"
            android:textColor="#737373"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/moderation_op_target_to"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#0f86ff"
            android:ellipsize="end"
            android:id="@+id/target_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="#3c3c3c"
        android:id="@+id/note"
        android:paddingTop="6dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>

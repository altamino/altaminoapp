<?xml version="1.0" encoding="utf-8"?>
<com.narvii.app.theme.view.NVThemeRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/prefs_default_size"
    app:nv_dark_background="#1affffff">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/prefs_left_margin"
        android:layout_marginRight="80dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/prefs_left_margin"
        android:layout_marginEnd="80dp">
        <com.narvii.app.theme.view.NVThemeTextView
            android:textSize="16dp"
            android:textColor="#4a4a4a"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            app:nv_dark_textColor="@color/prefs_text_color_dark"/>
        <com.narvii.app.theme.view.NVThemeTextView
            android:textSize="14dp"
            android:textColor="@color/pref_desc_default_color"
            android:id="@+id/desc"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            app:nv_dark_textColor="@color/prefs_text_color_dark"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/toggle_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp"
        android:layout_alignParentEnd="true">
        <CheckBox
            android:id="@+id/check_box"
            android:layout_width="52dp"
            android:layout_height="30dp"
            android:button="@drawable/switch_bg"/>
    </FrameLayout>
</com.narvii.app.theme.view.NVThemeRelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="108dp">
    <com.narvii.widget.CardView
        android:id="@+id/item_card3"
        android:visibility="invisible"
        android:layout_width="46dp"
        android:layout_height="55dp"
        android:layout_marginRight="10dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp"
        android:layout_alignParentEnd="true">
        <com.narvii.widget.SecretImageView
            android:id="@+id/image_3"
            android:tag="@string/image_tag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            narvii:cornerRadius="4dp"
            narvii:defaultDrawable="@color/item_card_placeholder"
            narvii:strokeColor="@color/item_card_stroke"
            narvii:strokeWidth="@dimen/item_card_stroke_width"/>
        <TextView
            android:textSize="8dp"
            android:textColor="#333"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title_3"
            android:tag="@string/title_tag"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:singleLine="true"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"/>
        <include layout="@layout/fans_only_content_indicator_layout_wiki"/>
    </com.narvii.widget.CardView>
    <com.narvii.widget.CardView
        android:id="@+id/item_card2"
        android:visibility="invisible"
        android:layout_width="62dp"
        android:layout_height="74dp"
        android:layout_marginRight="-24dp"
        android:layout_toLeftOf="@+id/item_card3"
        android:layout_centerVertical="true"
        android:layout_marginEnd="-24dp"
        android:layout_toStartOf="@+id/item_card3">
        <com.narvii.widget.SecretImageView
            android:id="@+id/image_2"
            android:tag="@string/image_tag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            narvii:cornerRadius="5dp"
            narvii:defaultDrawable="@color/item_card_placeholder"
            narvii:strokeColor="@color/item_card_stroke"
            narvii:strokeWidth="@dimen/item_card_stroke_width"/>
        <TextView
            android:textSize="9dp"
            android:textColor="#333"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title_2"
            android:tag="@string/title_tag"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:singleLine="true"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"/>
        <include layout="@layout/fans_only_content_indicator_layout_wiki"/>
    </com.narvii.widget.CardView>
    <com.narvii.widget.CardView
        android:id="@+id/item_card1"
        android:visibility="invisible"
        android:layout_width="72dp"
        android:layout_height="86dp"
        android:layout_marginRight="-30dp"
        android:layout_toLeftOf="@+id/item_card2"
        android:layout_centerVertical="true"
        android:layout_marginEnd="-30dp"
        android:layout_toStartOf="@+id/item_card2">
        <com.narvii.widget.SecretImageView
            android:id="@+id/image_1"
            android:tag="@string/image_tag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            narvii:cornerRadius="6dp"
            narvii:defaultDrawable="@color/item_card_placeholder"
            narvii:strokeColor="@color/item_card_stroke"
            narvii:strokeWidth="@dimen/item_card_stroke_width"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#333"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title_1"
            android:tag="@string/title_tag"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:singleLine="true"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"/>
        <include layout="@layout/fans_only_content_indicator_layout_wiki"/>
    </com.narvii.widget.CardView>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="10dp"
        android:layout_toLeftOf="@+id/item_card1"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:layout_toStartOf="@+id/item_card1"
        android:layout_alignParentStart="true">
        <TextView
            android:textSize="22dp"
            android:textColor="#fff"
            android:ellipsize="end"
            android:id="@+id/label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <TextView
            android:textSize="11dp"
            android:textColor="#ffff"
            android:ellipsize="end"
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"/>
    </LinearLayout>
</RelativeLayout>

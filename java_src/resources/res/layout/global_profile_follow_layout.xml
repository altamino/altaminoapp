<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="160dp"
    android:layout_height="34dp">
    <FrameLayout
        android:orientation="horizontal"
        android:id="@+id/follow_button"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/follow_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_follow_plus_padding"/>
            <com.narvii.widget.AutoSizingTextView
                android:textSize="13dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/follow_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:maxWidth="90dp"
                android:text="@string/user_follow"
                android:maxLines="1"
                android:layout_marginStart="6dp"
                app:autoSizeTextMaxSize="13dp"/>
        </LinearLayout>
        <com.narvii.widget.SpinningView
            android:layout_gravity="center"
            android:id="@+id/follow_progress"
            android:layout_width="@dimen/spin_tiny_size"
            android:layout_height="@dimen/spin_tiny_size"
            app:spinColor="#eee"
            app:spinStyle="2"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/user_follow_notification"
        android:paddingLeft="6dp"
        android:paddingRight="0dp"
        android:layout_width="40dp"
        android:layout_height="34dp"
        android:paddingStart="6dp"
        android:paddingEnd="0dp">
        <com.narvii.widget.GradientView
            android:id="@+id/follow_gradient"
            android:layout_width="34dp"
            android:layout_height="34dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/follow_notification_ring"
            android:layout_width="34dp"
            android:layout_height="34dp"/>
        <com.narvii.widget.SpinningView
            android:layout_gravity="center"
            android:id="@+id/follow_notification_progress"
            android:layout_width="26dp"
            android:layout_height="26dp"
            app:spinColor="#eee"
            app:spinStyle="2"/>
    </FrameLayout>
</LinearLayout>

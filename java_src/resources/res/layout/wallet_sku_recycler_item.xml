<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="horizontal"
        android:paddingLeft="15dp"
        android:paddingTop="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="15dp"
        android:paddingEnd="10dp">
        <com.narvii.widget.NVImageView
            android:id="@+id/icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:showPressedMask="false"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_weight="1"
            android:layout_marginStart="20dp">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#333"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#555"
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <com.github.mmin18.widget.FlexLayout
            android:id="@+id/purchase"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">
            <com.narvii.widget.ThumbImageView
                android:id="@+id/purchase_btn"
                android:duplicateParentState="true"
                android:layout_height="28dp"
                app:cornerRadius="5dp"
                app:layout_centerX="50%"
                app:layout_centerY="50%"
                app:layout_width="next.width"
                app:shadowColor="#0000"
                app:shadowOffsetX="0px"
                app:shadowOffsetY="1dp"
                app:shadowSize="3dp"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#fff"
                android:gravity="center"
                android:id="@+id/price"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="58dp"
                android:singleLine="true"
                android:shadowColor="#0000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="4"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                app:layout_centerX="50%"
                app:layout_centerY="50%"/>
        </com.github.mmin18.widget.FlexLayout>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/list_divider"
        android:background="#55000000"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_divider_height"/>
</FrameLayout>

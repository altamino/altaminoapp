<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.account.mobile.MyPhoneCountryCodePicker
        android:textSize="26sp"
        android:textColor="@color/white"
        android:id="@+id/country_picker"
        android:background="@drawable/button_rect_transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/country_divider"
        android:background="@color/white_50a"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@+id/country_picker"
        app:layout_constraintStart_toStartOf="@+id/country_picker"
        app:layout_constraintTop_toBottomOf="@+id/country_picker"/>
    <com.narvii.widget.ClearEditText
        android:textSize="26sp"
        android:textColor="@color/white"
        android:textColorHint="@color/white_50a"
        android:gravity="center_vertical"
        android:id="@+id/edit"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:hint="@string/account_phone_number"
        android:singleLine="true"
        android:layout_weight="1"
        android:inputType="phone"
        android:textCursorDrawable="@drawable/account_edit_cursor_white"
        android:layout_marginStart="22dp"
        app:layout_constraintBottom_toBottomOf="@+id/country_picker"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/country_picker"
        app:layout_constraintTop_toTopOf="@+id/country_picker"/>
    <View
        android:id="@+id/phone_divider"
        android:background="@color/white_50a"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="@+id/edit"
        app:layout_constraintStart_toStartOf="@+id/edit"
        app:layout_constraintTop_toTopOf="@+id/country_divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="14dp"
        android:textColor="#ffffff"
        android:id="@+id/invite_talk_btn"
        android:background="@drawable/button_round_waiting_list_accept"
        android:paddingLeft="14dp"
        android:paddingTop="11dp"
        android:paddingRight="14dp"
        android:paddingBottom="11dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/invite_members_to_talk"
        android:layout_centerInParent="true"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#88000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_one_wants_to_talk"
        android:layout_above="@+id/invite_talk_btn"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="4dp"
    android:layout_marginRight="4dp">
    <FrameLayout
        android:layout_gravity="center"
        android:background="#fff"
        android:layout_width="match_parent"
        android:layout_height="100dp">
        <com.narvii.widget.NVImageView
            android:id="@+id/store_item_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            app:defaultDrawable="@color/sticker_placeholder"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/amino_plus_badge"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:src="@drawable/ic_amino_plus_mini_new"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textSize="10dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="center"
                android:id="@+id/_new"
                android:background="@drawable/shared_sticker_pack_new_bg"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="16dp"
                android:text="New"
                android:textAllCaps="true"/>
        </LinearLayout>
        <View
            android:id="@+id/disabled"
            android:background="@drawable/sticker_picker_item_disabled"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="#333334"
        android:layout_gravity="center_horizontal"
        android:id="@+id/store_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:singleLine="true"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#999999"
        android:layout_gravity="center_horizontal"
        android:id="@+id/used_times"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"/>
</LinearLayout>

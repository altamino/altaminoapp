<?xml version="1.0" encoding="utf-8"?>
<com.narvii.widget.PushButton xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/push_btn"
    android:layout_width="0dp"
    android:layout_height="0dp"
    app:pushButtonColor="#fff"
    app:pushButtonLift="3dp"
    app:showShadow="false">
    <com.narvii.widget.AutoSizingTextView
        android:textSize="20dp"
        android:textColor="#272727"
        android:gravity="center"
        android:id="@+id/title"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:maxLines="3"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        app:autoSizeTextMaxSize="20dp"
        app:autoSizeTextMinSize="15dp"/>
</com.narvii.widget.PushButton>

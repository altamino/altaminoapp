<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:padding="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:layout_gravity="center_vertical"
        android:layout_width="50dp"
        android:layout_height="50dp"
        layout="@layout/user_avatar_layout_mini"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0pt"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp">
        <com.narvii.widget.NicknameView
            android:textSize="20dp"
            android:textColor="#fff"
            android:id="@+id/nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/animation_bell"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#ffff"
                android:id="@+id/last_notify_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:singleLine="true"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/notify"
        android:background="@drawable/selector_video_invite_green"
        android:paddingLeft="@dimen/default_padding_horizontal"
        android:paddingTop="@dimen/default_padding_vertical"
        android:paddingRight="16dp"
        android:paddingBottom="@dimen/default_padding_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:minWidth="100dp"
        android:minHeight="35dp"
        android:paddingStart="@dimen/default_padding_horizontal"
        android:paddingEnd="16dp"
        android:layout_marginStart="8dp">
        <ImageView
            android:id="@+id/notify_indicator"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:src="@drawable/animation_bell"
            android:scaleType="centerInside"/>
        <TextView
            android:textStyle="bold"
            android:textColor="#fff"
            android:id="@+id/notify_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/notify"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</LinearLayout>

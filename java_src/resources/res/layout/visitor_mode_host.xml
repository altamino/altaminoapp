<?xml version="1.0" encoding="utf-8"?>
<com.narvii.community.VisitorBarHost xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/visitor_mode_main"
        android:paddingTop="15dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14dp"
            android:textColor="#ffff"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:text="@string/in_visitor_mode"/>
        <LinearLayout
            android:id="@+id/join_community_container"
            android:paddingLeft="@dimen/community_detail_join_margin"
            android:paddingTop="4dp"
            android:paddingRight="@dimen/community_detail_join_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/community_detail_join_margin"
            android:paddingEnd="@dimen/community_detail_join_margin">
            <com.narvii.widget.JoinCommunityProgressLayout
                android:layout_gravity="center"
                android:id="@+id/join_community"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                app:progress_top_offset="@dimen/community_join_button_lift"
                app:pushButtonColor="#38d89c"
                app:pushButtonColorDark="#30c08a"
                app:pushButtonLift="@dimen/community_join_button_lift">
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="18dp"
                        android:textStyle="bold"
                        android:textColor="#fff"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/join"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/join_the_community"/>
                </LinearLayout>
            </com.narvii.widget.JoinCommunityProgressLayout>
        </LinearLayout>
    </LinearLayout>
</com.narvii.community.VisitorBarHost>

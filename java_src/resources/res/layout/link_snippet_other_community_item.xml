<?xml version="1.0" encoding="utf-8"?>
<com.narvii.link.view.CommunityInfoItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/community_layout"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.narvii.widget.CommunityIconView
        android:id="@+id/community_icon"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_marginRight="4dp"
        android:layout_marginEnd="4dp"
        app:cornerRadius="2dp"
        app:defaultDrawable="@drawable/placeholder_community"
        app:scalePlaceholder="true"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#b3b3b3"
        android:ellipsize="end"
        android:id="@+id/community_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
</com.narvii.link.view.CommunityInfoItem>

<?xml version="1.0" encoding="utf-8"?>
<com.narvii.app.theme.view.NVThemeLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:nv_dark_background="@color/color_default_primary">
    <com.narvii.app.theme.view.NVThemeLinearLayout
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="@dimen/prefs_default_margin"
        android:layoutDirection="ltr"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:nv_dark_background="#1affffff">
        <EditText
            android:textSize="16dp"
            android:textColor="@android:color/white"
            android:layout_gravity="center_vertical"
            android:id="@+id/edit_username"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:lines="1"
            android:singleLine="true"
            android:maxLength="50"
            android:layout_weight="1"
            android:textCursorDrawable="@drawable/edit_cursor_blue_normal"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/edit_delete"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_marginLeft="10dp"
            android:src="@drawable/ic_edit_delete"
            android:layout_marginStart="10dp"/>
    </com.narvii.app.theme.view.NVThemeLinearLayout>
    <com.narvii.app.theme.view.NVThemeTextView
        android:textSize="12dp"
        android:layout_gravity="end"
        android:id="@+id/input_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:nv_dark_textColor="#88ffffff"/>
</com.narvii.app.theme.view.NVThemeLinearLayout>

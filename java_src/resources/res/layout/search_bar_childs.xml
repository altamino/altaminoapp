<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <EditText
        android:textSize="16dp"
        android:textColor="#222"
        android:id="@+id/search_text"
        android:background="@drawable/search_bar_text"
        android:paddingLeft="36dp"
        android:paddingRight="32dp"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_margin="8dp"
        android:hint="@string/search"
        android:layout_centerVertical="true"
        android:inputType="textCapSentences"
        android:imeOptions="actionSearch"
        android:paddingStart="36dp"
        android:paddingEnd="32dp"/>
    <com.narvii.widget.FontAwesomeView
        android:textSize="16dp"
        android:textColor="#aaa"
        android:gravity="center"
        android:padding="4dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:text="@string/ion_ios_search"
        android:layout_alignLeft="@+id/search_text"
        android:layout_centerVertical="true"
        android:layout_alignStart="@+id/search_text"/>
    <com.narvii.widget.FontAwesomeView
        android:textSize="16dp"
        android:textColor="#aaa"
        android:gravity="center"
        android:id="@+id/search_clear"
        android:padding="4dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:text="@string/ion_ios_close_outline"
        android:layout_alignRight="@+id/search_text"
        android:layout_centerVertical="true"
        android:layout_alignEnd="@+id/search_text"/>
</merge>

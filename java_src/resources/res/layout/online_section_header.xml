<?xml version="1.0" encoding="utf-8"?>
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:textSize="12dp"
    android:textStyle="bold"
    android:textColor="#fff"
    android:gravity="start|center_vertical"
    android:id="@+id/text"
    android:background="#ffff"
    android:paddingLeft="@dimen/default_padding_horizontal"
    android:paddingTop="2dp"
    android:paddingRight="@dimen/default_padding_horizontal"
    android:paddingBottom="2dp"
    android:layout_width="match_parent"
    android:layout_height="20dp"
    android:singleLine="true"
    android:paddingStart="@dimen/default_padding_horizontal"
    android:paddingEnd="@dimen/default_padding_horizontal"/>

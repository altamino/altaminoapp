<?xml version="1.0" encoding="utf-8"?>
<com.narvii.widget.SearchBar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingLeft="8dp"
    android:paddingTop="8dp"
    android:paddingRight="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Button
        android:textSize="16dp"
        android:textColor="#ffff"
        android:id="@+id/search_cancel"
        android:background="@drawable/button_rect_transparent_dark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:text="@string/cancel"
        android:layout_alignParentRight="true"
        android:layout_marginStart="8dp"
        android:layout_alignParentEnd="true"/>
    <RelativeLayout
        android:id="@+id/search_edit_frame"
        android:background="@drawable/search_bar_bg_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toLeftOf="@+id/search_cancel"
        android:layout_toRightOf="@+id/search_back"
        android:layout_toStartOf="@+id/search_cancel"
        android:layout_toEndOf="@+id/search_back">
        <com.narvii.widget.TintButton
            android:gravity="center"
            android:id="@+id/search_icon"
            android:clickable="false"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/ic_searchr"
            android:scaleType="centerInside"
            android:text="@string/ion_search"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:layout_alignParentStart="true"
            app:tintColor="#fff"/>
        <EditText
            android:textSize="14dp"
            android:textColor="#fff"
            android:textColorHint="#ffff"
            android:id="@+id/search_text"
            android:background="@null"
            android:paddingRight="28dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:singleLine="true"
            android:layout_toRightOf="@+id/search_icon"
            android:imeOptions="actionSearch"
            android:textCursorDrawable="@drawable/edit_cursor_white_normal"
            android:textAlignment="viewStart"
            android:paddingEnd="28dp"
            android:layout_toEndOf="@+id/search_icon"/>
        <com.narvii.widget.FontAwesomeView
            android:textColor="#d4d3db"
            android:gravity="center_vertical"
            android:id="@+id/search_clear"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="4dp"
            android:text="@string/ion_close_circled"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <com.narvii.widget.TintButton
        android:id="@+id/search_back"
        android:background="@drawable/button_rect_transparent_dark"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_back_mirror"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"/>
</com.narvii.widget.SearchBar>

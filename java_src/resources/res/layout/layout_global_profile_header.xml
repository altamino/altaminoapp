<?xml version="1.0" encoding="utf-8"?>
<com.narvii.master.home.widgets.GlobalProfileHeaderView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="17dp"
    android:paddingTop="20dp"
    android:paddingRight="17dp"
    android:paddingBottom="17dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.list.overlay.OverlayListPlaceholder
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.narvii.widget.UserAvatarLayout
            android:id="@+id/user_avatar_layout"
            android:padding="2dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="76dp"
            android:layout_height="76dp"
            app:avatarSizeRatio="0.78"
            app:avatarStrokeWidthInDP="2"
            app:badgeWidthRatio="0.45"
            app:showLive="true"
            app:showSpeaking="true"
            app:sizeType="large"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <com.narvii.master.home.widgets.GlobalProfileFollowView
            android:id="@+id/follow_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/chat_entry"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_global_chat_entry"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/edit_button"
            android:background="@drawable/selector_white_corner_4"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="32dp">
            <ImageView
                android:gravity="center"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_global_profile_edit"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/edit_profile"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
    <com.narvii.widget.NicknameView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:layout_gravity="start"
        android:id="@+id/nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_alignParentTop="true"
        app:allowShowUnsubscribe="true"
        app:hideRankingBadge="true"
        app:hideRole="true"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#ffff"
        android:layout_gravity="start"
        android:id="@+id/amino_id"
        android:paddingTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:paddingTop="10dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.narvii.widget.RadiusLayout
            android:id="@+id/followers_wrapper"
            android:background="#1affffff"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            app:layout_corner_radius_left_bottom="4dp"
            app:layout_corner_radius_left_top="4dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.narvii.widget.AutoSizingTextView
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:textColor="#fff"
                    android:gravity="center"
                    android:id="@+id/followers_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    app:autoSizeTextMaxSize="18dp"
                    app:autoSizeTextMinSize="13dp"/>
                <TextView
                    android:textSize="11dp"
                    android:textColor="#ffff"
                    android:gravity="center"
                    android:id="@+id/followers_count_unit_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/user_followers"
                    android:maxLines="1"
                    android:singleLine="true"/>
            </LinearLayout>
        </com.narvii.widget.RadiusLayout>
        <FrameLayout
            android:id="@+id/followings_wrapper"
            android:background="#1affffff"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.narvii.widget.AutoSizingTextView
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:textColor="#fff"
                    android:gravity="center"
                    android:id="@+id/followings_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    app:autoSizeTextMaxSize="18dp"
                    app:autoSizeTextMinSize="13dp"/>
                <TextView
                    android:textSize="11dp"
                    android:textColor="#ffff"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/user_following"
                    android:maxLines="1"
                    android:singleLine="true"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="#fff"
        android:layout_gravity="start"
        android:id="@+id/bio"
        android:paddingTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/tap_to_add_bio_hint"
        android:lineSpacingMultiplier="1.1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="start"
        android:orientation="horizontal"
        android:id="@+id/hint_frame"
        android:paddingTop="8dp"
        android:paddingRight="10dp"
        android:paddingBottom="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="10dp">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/selector_profile_see_all"
            android:id="@+id/hint_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/see_all"/>
        <com.narvii.widget.TintButton
            android:id="@+id/hint_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:src="@drawable/ic_show_more_indicator"
            android:layout_marginStart="4dp"
            app:tintColor="@color/selector_profile_see_all"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/membership_layout"
        android:background="@drawable/selector_white_corner_4"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp">
        <ImageView
            android:id="@+id/membership_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/membership_bar_card_active"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#fff"
            android:id="@+id/membership_hint"
            android:layout_width="0pt"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <com.narvii.master.home.widgets.ProfileLinkedCommuView
        android:id="@+id/linked_communities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"/>
</com.narvii.master.home.widgets.GlobalProfileHeaderView>

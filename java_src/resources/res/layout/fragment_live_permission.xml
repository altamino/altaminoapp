<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/color_default_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/list_divider_dark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_divider_height"/>
    <RelativeLayout
        android:id="@+id/free_talk_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:id="@+id/free_talk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="19dp"
            android:text="@string/free_talk"
            android:layout_marginStart="18dp"/>
        <TextView
            android:textSize="11dp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="50dp"
            android:layout_marginBottom="19dp"
            android:text="@string/anyone_can_speak_without_approval"
            android:layout_below="@+id/free_talk"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="50dp"/>
        <com.narvii.widget.TintButton
            android:id="@+id/free_talk_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="18dp"
            android:src="@drawable/check_green"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="18dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="@color/list_divider_dark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_divider_height"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
    <RelativeLayout
        android:id="@+id/require_approval_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:id="@+id/require_approval"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="19dp"
            android:text="@string/require_approval_to_speak"
            android:layout_marginStart="18dp"/>
        <TextView
            android:textSize="11dp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="50dp"
            android:layout_marginBottom="19dp"
            android:text="@string/approved_after_raising_hand"
            android:layout_below="@+id/require_approval"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="50dp"/>
        <com.narvii.widget.TintButton
            android:id="@+id/require_approval_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:layout_marginRight="18dp"
            android:src="@drawable/check_green"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="18dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="@color/list_divider_dark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_divider_height"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
    <RelativeLayout
        android:id="@+id/invite_only_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:id="@+id/invite_only"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="19dp"
            android:text="@string/invite_only"
            android:layout_marginStart="18dp"/>
        <TextView
            android:textSize="11dp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="50dp"
            android:layout_marginBottom="19dp"
            android:text="@string/host_co_host_invite_others_to_speak"
            android:layout_below="@+id/invite_only"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="50dp"/>
        <com.narvii.widget.TintButton
            android:id="@+id/invite_only_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="18dp"
            android:src="@drawable/check_green"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="18dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="@color/list_divider_dark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_divider_height"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
</LinearLayout>

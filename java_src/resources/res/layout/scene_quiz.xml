<?xml version="1.0" encoding="utf-8"?>
<com.narvii.scene.quiz.SceneQuizAnswerParent xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/scene_quiz_answer_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.widget.StatusBarPlaceHolder
        android:id="@+id/status_bar_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/count_down_layout"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="35dp"
        android:layout_marginBottom="10dp">
        <View
            android:background="@drawable/scene_quiz_count_down_shadow"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"/>
        <com.narvii.widget.CircleProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:max="100"
            app:progressStyle="stroke"
            app:roundBackgroundColor="#33ffffff"
            app:roundWidth="3dp"/>
        <com.narvii.widget.GradientView
            android:layout_gravity="center"
            android:id="@+id/red_alert"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"/>
        <com.narvii.widget.AutoSizingTextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawablePadding="8dp"
            app:autoSizeTextMaxSize="20dp"
            app:layout_centerX="50%"/>
        <com.narvii.widget.AutoSizingTextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/alarm_anim"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawablePadding="8dp"
            app:autoSizeTextMaxSize="20dp"
            app:layout_centerX="50%"/>
    </FrameLayout>
    <View
        android:id="@+id/stub1"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <com.narvii.widget.AutoSizingTextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/question"
        android:paddingLeft="20dp"
        android:paddingTop="5dp"
        android:paddingRight="20dp"
        android:paddingBottom="5dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="@dimen/scene_quiz_question_margin_bottom"
        android:maxLines="3"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:autoSizeTextMaxSize="20dp"
        app:autoSizeTextMinSize="10dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/grid"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp">
        <LinearLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <include
                android:id="@+id/answer_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                layout="@layout/scene_quiz_item"/>
            <View
                android:layout_width="@dimen/scene_answer_item_margin"
                android:layout_height="wrap_content"/>
            <include
                android:id="@+id/answer_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                layout="@layout/scene_quiz_item"/>
        </LinearLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/scene_answer_item_margin"/>
        <LinearLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <include
                android:id="@+id/answer_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                layout="@layout/scene_quiz_item"/>
            <View
                android:layout_width="@dimen/scene_answer_item_margin"
                android:layout_height="wrap_content"/>
            <include
                android:id="@+id/answer_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                layout="@layout/scene_quiz_item"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="15dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/skip_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="10dp"/>
</com.narvii.scene.quiz.SceneQuizAnswerParent>

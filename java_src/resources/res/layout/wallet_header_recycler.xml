<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlay"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.github.mmin18.widget.FlexLayout
        android:id="@+id/wallet_header"
        android:background="#2da4e7"
        android:paddingBottom="20dp"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/stub1"
            android:layout_width="0px"
            android:layout_height="0px"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/balance_frame"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:layout_top="stub1.bottom+10dp">
            <ImageView
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:src="@drawable/amino_coin_big"/>
            <TextView
                android:textSize="46dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:id="@+id/balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/total_coins"
            app:layout_centerX="50%"
            app:layout_top="balance_frame.bottom+5dp"/>
        <FrameLayout
            android:id="@+id/membership_card"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_height="60dp"
            app:layout_left="15dp"
            app:layout_right="100%-15dp"
            app:layout_top="balance_frame.bottom+36dp">
            <com.narvii.widget.ThumbImageView
                android:id="@+id/membership_card_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cornerRadius="4dp"
                app:shadowColor="#ffff"
                app:shadowOffsetY="1dp"
                app:shadowSize="2dp"/>
            <RelativeLayout
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.narvii.widget.ThumbImageView
                    android:id="@+id/image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="10dp"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="10dp"
                    android:layout_alignParentStart="true"
                    app:shadowOffsetY="1dp"
                    app:shadowSize="2dp"/>
                <ImageView
                    android:id="@+id/wallet_header_membership_chevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:src="@drawable/chevron_right_white"
                    android:scaleType="centerInside"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#fff"
                    android:gravity="center_vertical"
                    android:id="@+id/text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toLeftOf="@+id/wallet_header_membership_chevron"
                    android:layout_toRightOf="@+id/image"
                    android:layout_alignWithParentIfMissing="true"
                    android:layout_toStartOf="@+id/wallet_header_membership_chevron"
                    android:layout_toEndOf="@+id/image"/>
            </RelativeLayout>
        </FrameLayout>
    </com.github.mmin18.widget.FlexLayout>
</FrameLayout>

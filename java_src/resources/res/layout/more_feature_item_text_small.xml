<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/more_featured_item_width_s"
    android:layout_height="@dimen/more_featured_item_height_s">
    <androidx.cardview.widget.CardView
        android:id="@+id/feed_item_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        app:cardCornerRadius="3dp"
        app:cardElevation="2.5dp"
        app:cardMaxElevation="4dp">
        <com.narvii.feed.PopularFeedListItem
            android:orientation="vertical"
            android:id="@+id/feed_item_base"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <View
                    android:id="@+id/divider"
                    android:background="@color/feature_feed_divider"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_alignParentBottom="true"/>
                <include
                    android:id="@+id/feed_toolbar"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_above="@+id/divider"
                    layout="@layout/feed_popular_toolbar_top_small"/>
                <TextView
                    android:textSize="17dp"
                    android:textColor="#fff"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/text"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:maxLines="3"
                    android:layout_above="@+id/feed_toolbar"
                    android:layout_centerVertical="true"
                    android:lineSpacingMultiplier="0.9"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"/>
                <include layout="@layout/fans_only_content_indicator_layout"/>
            </RelativeLayout>
        </com.narvii.feed.PopularFeedListItem>
    </androidx.cardview.widget.CardView>
</LinearLayout>

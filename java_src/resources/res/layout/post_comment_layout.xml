<?xml version="1.0" encoding="utf-8"?>
<com.narvii.comment.post.CommentPostLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/stub1"
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/stub3"
                android:background="#0000"
                android:layout_width="match_parent"
                android:layout_height="0px"/>
            <FrameLayout
                android:id="@+id/stub4"
                android:layout_width="match_parent"
                android:layout_height="0px">
                <View
                    android:layout_gravity="top"
                    android:background="@drawable/shadow_comment_mask_drop"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"/>
                <View
                    android:layout_gravity="bottom"
                    android:background="@drawable/shadow_comment_mask_lift"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"/>
            </FrameLayout>
            <View
                android:background="#0000"
                android:layout_width="match_parent"
                android:layout_height="0px"
                android:layout_weight="1"/>
        </LinearLayout>
        <View
            android:layout_gravity="bottom"
            android:background="@drawable/shadow_lift"
            android:layout_width="match_parent"
            android:layout_height="4dp"/>
    </FrameLayout>
    <RelativeLayout
        android:background="#dadada"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.narvii.widget.TintButton
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/pick_media"
            android:background="@drawable/grey_oval"
            android:padding="4dp"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginLeft="8dp"
            android:src="@drawable/ic_chat_input_plus_no_circle"
            android:scaleType="centerInside"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_alignParentStart="true"/>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/sticker_button_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_toRightOf="@+id/pick_media"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_toEndOf="@+id/pick_media">
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/sticker_entry"
                android:background="@drawable/grey_oval"
                android:padding="2dp"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_margin="2dp"
                android:src="@drawable/ic_chat_input_sticker_button"
                android:scaleType="centerInside"/>
            <com.narvii.widget.TintButton
                android:layout_gravity="start|center_vertical"
                android:id="@+id/sticker_keyboard"
                android:background="@drawable/grey_oval"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_margin="2dp"
                android:src="@drawable/ic_chat_input_keyboard"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/post"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_comment_post"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_alignParentEnd="true"/>
        <com.narvii.comment.post.CommentEditText
            android:textSize="15dp"
            android:textStyle="normal"
            android:textColor="#333"
            android:textColorHint="#aaa"
            android:gravity="start|top"
            android:id="@+id/content"
            android:background="@drawable/input_edit_round_normal"
            android:padding="6dp"
            android:scrollbars="vertical"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:maxLines="5"
            android:layout_toLeftOf="@+id/post"
            android:layout_toRightOf="@+id/sticker_button_container"
            android:layout_centerVertical="true"
            android:layout_alignWithParentIfMissing="true"
            android:inputType="textMultiLine"
            android:layout_toStartOf="@+id/post"
            android:layout_toEndOf="@+id/sticker_button_container"/>
    </RelativeLayout>
    <com.narvii.widget.DragSortGallery
        android:orientation="horizontal"
        android:id="@+id/comment_images"
        android:background="@color/window_background"
        android:paddingLeft="44dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="44dp">
        <FrameLayout
            android:id="@+id/image1"
            android:layout_width="@dimen/post_comment_gallery_size"
            android:layout_height="@dimen/post_comment_gallery_size"
            android:layout_marginRight="3dp"
            android:layout_marginEnd="3dp">
            <com.narvii.widget.ThumbImageView
                android:id="@+id/image_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                narvii:defaultDrawable="@color/placeholder"/>
            <com.narvii.widget.FontAwesomeView
                android:textSize="20dp"
                android:textColor="@color/window_background"
                android:gravity="center"
                android:id="@+id/icon_1"
                android:tag="@string/icon_tag"
                android:padding="10dp"
                android:duplicateParentState="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/fa_camera"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/image2"
            android:layout_width="@dimen/post_comment_gallery_size"
            android:layout_height="@dimen/post_comment_gallery_size"
            android:layout_marginRight="3dp"
            android:layout_marginEnd="3dp">
            <com.narvii.widget.ThumbImageView
                android:id="@+id/image_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                narvii:defaultDrawable="@color/placeholder"/>
            <com.narvii.widget.FontAwesomeView
                android:textSize="20dp"
                android:textColor="@color/window_background"
                android:gravity="center"
                android:id="@+id/icon_2"
                android:tag="@string/icon_tag"
                android:padding="10dp"
                android:duplicateParentState="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/fa_camera"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/image3"
            android:layout_width="@dimen/post_comment_gallery_size"
            android:layout_height="@dimen/post_comment_gallery_size"
            android:layout_marginRight="3dp"
            android:layout_marginEnd="3dp">
            <com.narvii.widget.ThumbImageView
                android:id="@+id/image_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                narvii:defaultDrawable="@color/placeholder"/>
            <com.narvii.widget.FontAwesomeView
                android:textSize="20dp"
                android:textColor="@color/window_background"
                android:gravity="center"
                android:id="@+id/icon_3"
                android:tag="@string/icon_tag"
                android:padding="10dp"
                android:duplicateParentState="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/fa_camera"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/image4"
            android:layout_width="@dimen/post_comment_gallery_size"
            android:layout_height="@dimen/post_comment_gallery_size"
            android:layout_marginRight="3dp"
            android:layout_marginEnd="3dp">
            <com.narvii.widget.ThumbImageView
                android:id="@+id/image_4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                narvii:defaultDrawable="@color/placeholder"/>
            <com.narvii.widget.FontAwesomeView
                android:textSize="20dp"
                android:textColor="@color/window_background"
                android:gravity="center"
                android:id="@+id/icon_4"
                android:tag="@string/icon_tag"
                android:padding="10dp"
                android:duplicateParentState="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/fa_camera"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/image5"
            android:layout_width="@dimen/post_comment_gallery_size"
            android:layout_height="@dimen/post_comment_gallery_size"
            android:layout_marginRight="3dp"
            android:layout_marginEnd="3dp">
            <com.narvii.widget.ThumbImageView
                android:id="@+id/image_5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                narvii:defaultDrawable="@color/placeholder"/>
            <com.narvii.widget.FontAwesomeView
                android:textSize="20dp"
                android:textColor="@color/window_background"
                android:gravity="center"
                android:id="@+id/icon_5"
                android:tag="@string/icon_tag"
                android:padding="10dp"
                android:duplicateParentState="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/fa_camera"/>
        </FrameLayout>
    </com.narvii.widget.DragSortGallery>
    <FrameLayout
        android:id="@+id/panel_layout"
        android:background="#fff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/sticker_panel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/voice_record_panel_height_min"/>
    </FrameLayout>
</com.narvii.comment.post.CommentPostLayout>

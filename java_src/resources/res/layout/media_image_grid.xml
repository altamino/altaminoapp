<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="0px"
    android:paddingRight="1dp"
    android:paddingBottom="1dp"
    android:layout_width="80dp"
    android:layout_height="80dp"
    android:paddingStart="0px"
    android:paddingEnd="1dp">
    <com.narvii.widget.NVImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <View
        android:id="@+id/grey_mask"
        android:background="#ffff"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/membership_label"
        android:paddingTop="5dp"
        android:paddingRight="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_membership_lock"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:paddingEnd="5dp"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/select"
        android:paddingLeft="10dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:paddingStart="10dp"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/media_picker_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginBottom="3dp"
        android:src="@drawable/ic_media_picker_label_video"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="4dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#ffffffff"
        android:id="@+id/media_picker_video_time"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        android:layout_marginBottom="1dp"
        android:layout_toRightOf="@+id/media_picker_label"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="3dp"
        android:layout_toEndOf="@+id/media_picker_label"
        style="@style/TextShadowEnable"/>
</RelativeLayout>

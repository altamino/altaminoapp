<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.github.mmin18.widget.FlexLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0pt"
        android:layout_weight="1">
        <View
            android:background="@drawable/gradient_white_bottom"
            android:layout_width="match_parent"
            app:layout_bottom="bg_bottom.top"
            app:layout_height="46%"/>
        <View
            android:id="@+id/bg_bottom"
            android:background="#fff"
            android:layout_width="match_parent"
            app:layout_bottom="100%"
            app:layout_height="20%"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_post_lock_for_fans_only"
            app:layout_bottom="hint.top-15dp"
            app:layout_centerX="50%"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#303030"
            android:gravity="center"
            android:id="@+id/hint"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fans_only_hint"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            app:layout_bottom="become_fans.top-15dp"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/become_fans"
            android:background="@drawable/selector_become_fans"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="@string/become_a_fan"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            app:layout_bottom="95%"
            app:layout_centerX="50%"/>
    </com.github.mmin18.widget.FlexLayout>
    <View
        android:id="@+id/margin_bottom_placeholder"
        android:background="#fff"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
</LinearLayout>

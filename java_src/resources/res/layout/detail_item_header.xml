<?xml version="1.0" encoding="utf-8"?>
<com.narvii.item.detail.HeaderLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_header"
    android:background="#888"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.widget.SlideshowView
        android:id="@+id/slideshow"
        android:background="@drawable/slideshow_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        narvii:hidingHeight2="40dp"/>
    <com.github.mmin18.widget.RealtimeBlurView
        android:layout_gravity="center"
        android:id="@+id/blur"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        narvii:realtimeBlurMaxFPS="5"
        narvii:realtimeBlurRadius="20dp"
        narvii:realtimeOverlayColor="#ffff"/>
    <View
        android:id="@+id/gradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <com.narvii.widget.CardView
        android:id="@+id/item_card"
        android:tag="fade"
        android:layout_width="118dp"
        android:layout_height="142dp"
        android:layout_above="@+id/label"
        android:layout_centerHorizontal="true">
        <com.narvii.widget.SecretImageView
            android:id="@+id/image"
            android:tag="@string/image_tag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            narvii:cornerRadius="10dp"
            narvii:defaultDrawable="@color/item_card_placeholder"
            narvii:shadowColor="#8888"
            narvii:shadowOffsetX="2dp"
            narvii:shadowOffsetY="2dp"
            narvii:shadowSize="4dp"
            narvii:strokeColor="#fff"
            narvii:strokeWidth="@dimen/item_card_stroke_width"/>
        <View
            android:id="@+id/title"
            android:tag="@string/title_tag"
            android:layout_width="match_parent"
            android:layout_height="22dp"/>
        <include layout="@layout/fans_only_content_indicator_layout_wiki"/>
    </com.narvii.widget.CardView>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:ellipsize="end"
        android:id="@+id/label"
        android:tag="fade"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:shadowColor="#0000"
        android:shadowDy="2"
        android:shadowRadius="3"
        android:layout_above="@+id/keywords_layout"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/keywords_layout"
        android:tag="fade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/vote_layout"
        android:layout_centerHorizontal="true">
        <com.narvii.widget.KeywordsView
            android:layout_gravity="center_horizontal"
            android:id="@+id/keywords"
            android:paddingLeft="4dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            narvii:keywordMargin="8dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/vote_layout"
        android:tag="fade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/vote_btn"
            android:tag="fade"
            android:background="@drawable/detail_vote_btn_light"
            android:layout_width="80dp"
            android:layout_height="32dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="18dp">
            <com.narvii.widget.VoteIcon
                android:id="@+id/vote_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="10dp"
                android:scaleType="centerInside"
                android:layout_marginStart="10dp"/>
            <com.narvii.widget.SpinningView
                android:id="@+id/vote_progress"
                android:visibility="gone"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_marginLeft="10dp"
                android:layout_marginStart="10dp"
                narvii:spinColor="#fff"
                narvii:spinStyle="2"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/feed_toolbar_white"
                android:gravity="center"
                android:id="@+id/vote_count"
                android:duplicateParentState="true"
                android:layout_width="0px"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="10dp"
                android:singleLine="true"
                android:shadowColor="#0000"
                android:shadowDy="1"
                android:shadowRadius="1.5"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="10dp"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/actionbar2"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_marginBottom="-100dp"
        android:layout_alignParentTop="true">
        <include
            android:visibility="gone"
            layout="@layout/actionbar_left_button"/>
        <com.narvii.widget.CardView
            android:id="@+id/item_card2"
            android:layout_width="34dp"
            android:layout_height="40dp"
            android:layout_marginLeft="50dp"
            android:layout_marginStart="50dp">
            <com.narvii.widget.SecretImageView
                android:id="@+id/image_2"
                android:tag="@string/image_tag"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                narvii:cornerRadius="3dp"
                narvii:defaultDrawable="@color/item_card_placeholder"
                narvii:strokeColor="#fff"
                narvii:strokeWidth="@dimen/item_card_stroke_width"/>
            <TextView
                android:id="@+id/title_2"
                android:tag="@string/title_tag"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="6dp"/>
            <include layout="@layout/fans_only_content_indicator_layout_wiki"/>
        </com.narvii.widget.CardView>
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:ellipsize="end"
            android:id="@+id/label_action_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="112dp"
            android:singleLine="true"
            android:shadowColor="#0000"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="112dp"/>
    </LinearLayout>
    <View
        android:id="@+id/item_gold_line"
        android:background="@color/gold"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_alignParentBottom="true"/>
</com.narvii.item.detail.HeaderLayout>

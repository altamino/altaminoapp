<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.widget.FullsizeImageView
        android:id="@+id/chat_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        narvii:imageType="chat-background"/>
    <com.github.mmin18.widget.RealtimeBlurView
        android:id="@+id/chat_blur_background"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        narvii:realtimeBlurMaxFPS="5"
        narvii:realtimeBlurRadius="60dp"
        narvii:realtimeOverlayColor="#0000"/>
</FrameLayout>

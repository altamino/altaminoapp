<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/community_info_Layout"
        android:background="#0000"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.narvii.widget.CommunityIconView
            android:layout_gravity="center_vertical"
            android:id="@+id/community_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="#ffff"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/community_title"
            android:layout_width="0pt"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:singleLine="true"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
        <com.narvii.widget.TintButton
            android:layout_gravity="center_vertical"
            android:id="@+id/setting"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:src="@drawable/more_dot"
            app:tintColor="#ffff"/>
    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/list_layout"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.nvplayerview.NVVideoView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.narvii.widget.TouchImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        app:hidePlayButton="true"
        app:preload="true"
        app:supportUhq="true"/>
    <com.narvii.widget.SpinningView
        android:layout_gravity="center"
        android:id="@+id/video_loading"
        android:visibility="invisible"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:spinColor="#ffff"
        app:spinStyle="2"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/image_loading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="?android:attr/progressBarStyleLarge"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#000"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/check_hd"
        android:background="@drawable/button_white_corner"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginBottom="10dp"
        android:text="@string/check_hd_image"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>
    <LinearLayout
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/downloading_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12dp"
            android:textColor="#fff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/downloading"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/downloading_progress"
            android:layout_width="83dp"
            android:layout_height="7dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="10"
            android:progressDrawable="@drawable/load_image_downloading_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
    </LinearLayout>
</FrameLayout>

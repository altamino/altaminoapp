<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:layout_width="118dp"
    android:layout_height="wrap_content">
    <com.github.mmin18.widget.FlexLayout
        android:paddingLeft="3dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="3dp">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="@drawable/topic_more_cell_bg"
            narvii:layout_height="this.width*1.48"
            narvii:layout_left="3dp"
            narvii:layout_right="100%-6dp"
            narvii:layout_top="4dp">
            <com.narvii.topic.widgets.StoryTopicMoreView
                android:layout_gravity="center_horizontal"
                android:id="@+id/loading_view"
                android:layout_width="20dp"
                android:layout_height="5dp"
                android:layout_marginBottom="7dp"/>
            <TextView
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/more"/>
        </LinearLayout>
    </com.github.mmin18.widget.FlexLayout>
</FrameLayout>

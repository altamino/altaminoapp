<?xml version="1.0" encoding="utf-8"?>
<com.narvii.chat.thread.ThreadListItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/default_padding_horizontal"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    android:paddingStart="@dimen/default_padding_horizontal">
    <LinearLayout
        android:id="@+id/stub0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true">
        <include layout="@layout/rtc_indicator_container"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/stub1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/stub0"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/stub0">
        <com.narvii.chat.MultiAvatarView
            android:id="@+id/chat_avatars"
            android:layout_width="@dimen/chat_avatar_size"
            android:layout_height="@dimen/chat_avatar_size"
            narvii:maskStrokeColor="#888"
            narvii:maskStrokeWidth="0.5dp"/>
    </LinearLayout>
    <View
        android:id="@+id/chat_thread_unread"
        android:background="@drawable/chat_thread_unread"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="2dp"
        android:layout_alignTop="@+id/stub1"
        android:layout_alignRight="@+id/stub1"
        android:layout_marginEnd="2dp"
        android:layout_alignEnd="@+id/stub1"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#90ffffff"
        android:id="@+id/datetime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="10dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="10dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="#222"
        android:id="@+id/title"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="8dp"
        android:singleLine="true"
        android:layout_toLeftOf="@+id/datetime"
        android:layout_toRightOf="@+id/stub1"
        android:layout_alignParentTop="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/datetime"
        android:layout_toEndOf="@+id/stub1"/>
    <include
        android:visibility="invisible"
        layout="@layout/chat_thread_content_bottom"/>
    <include layout="@layout/layout_community_global_search_info"/>
</com.narvii.chat.thread.ThreadListItem>

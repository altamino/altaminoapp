<?xml version="1.0" encoding="utf-8"?>
<com.narvii.app.theme.view.NVThemeLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:nv_dark_background="@color/color_default_primary">
    <include layout="@layout/aggregation_alert_community_info_layout"/>
    <include layout="@layout/item_alert_push_setting"/>
    <FrameLayout
        android:id="@+id/notification_turned_off_warning_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <include
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/list_layout"/>
        <com.github.mmin18.widget.FlexLayout
            android:id="@+id/not_login_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="16dp"
                android:textColor="#fff"
                android:id="@+id/not_login_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/not_login_yet"
                app:layout_centerX="50%"
                app:layout_top="30%"/>
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="@color/account_text"
                android:gravity="center"
                android:id="@+id/not_login_button"
                android:background="@drawable/selector_more_aminos"
                android:layout_height="45dp"
                android:text="@string/sign_up_and_login"
                app:layout_centerX="50%"
                app:layout_top="not_login_hint.bottom + 35dp"
                app:layout_width="250dp"/>
        </com.github.mmin18.widget.FlexLayout>
    </FrameLayout>
</com.narvii.app.theme.view.NVThemeLinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/video_controller_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="#32000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:layout_gravity="top"
        android:id="@+id/top_gradient"
        android:background="@drawable/sr_gradient_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sr_gradient_height"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/bottom_gradient"
        android:background="@drawable/sr_gradient_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sr_gradient_height"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:id="@+id/play_buttons_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/prev"
            android:visibility="invisible"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_sr_media_prev"
            android:scaleType="centerInside"/>
        <ImageView
            android:id="@+id/pause"
            android:visibility="invisible"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="28dp"
            android:layout_marginRight="28dp"
            android:scaleType="centerInside"/>
        <ImageView
            android:id="@+id/next"
            android:visibility="invisible"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_sr_media_next"
            android:scaleType="centerInside"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/vc_top_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.narvii.widget.StatusBarPlaceHolder
            android:id="@+id/status_bar_placeholder"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="0dp"
            android:paddingTop="5dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:paddingEnd="10dp">
            <com.narvii.widget.TintButton
                android:id="@+id/playlist"
                android:layout_width="@dimen/sr_play_controller_size"
                android:layout_height="@dimen/sr_play_controller_size"
                android:layout_marginLeft="4dp"
                android:src="@drawable/ic_playlist"
                android:scaleType="centerInside"
                android:layout_marginStart="4dp"/>
            <com.narvii.widget.MarqueeTextView
                android:textSize="12dp"
                android:textColor="#fff"
                android:id="@+id/video_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:shadowColor="#0000"
                android:shadowDy="1"
                android:shadowRadius="1"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom"
        android:layout_gravity="start|bottom"
        android:orientation="horizontal"
        android:id="@+id/controller_bottom_container"
        android:paddingLeft="6dp"
        android:paddingTop="@dimen/sr_controller_padding_bottom"
        android:paddingRight="4dp"
        android:paddingBottom="@dimen/sr_controller_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="4dp">
        <LinearLayout
            android:gravity="start|bottom"
            android:orientation="horizontal"
            android:id="@+id/host_bottom_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:id="@+id/progress_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sr_progress_layout_height"
                    android:alpha="0.6">
                    <TextView
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:textColor="#fff"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/time_current"
                        android:padding="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:shadowColor="#0000"
                        android:shadowDy="1"
                        android:shadowRadius="1"/>
                    <SeekBar
                        android:layout_gravity="center_vertical"
                        android:id="@+id/progress_bar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxHeight="@dimen/voice_message_progress_height"
                        android:progressDrawable="@drawable/sr_seekbar_progress"
                        android:minHeight="@dimen/voice_message_progress_height"
                        android:thumb="@drawable/ic_audio_player_seekbar_thumb"
                        android:thumbOffset="7dp"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:textColor="#fff"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/time"
                        android:padding="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:shadowColor="#0000"
                        android:shadowDy="1"
                        android:shadowRadius="1"/>
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/volume_seek_bar_placeholder"
                android:layout_width="32dp"
                android:layout_height="150dp"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp">
                <ImageView
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/volume"
                    android:layout_width="@dimen/sr_play_controller_size"
                    android:layout_height="@dimen/sr_play_controller_size"
                    android:src="@drawable/ic_media_controller_volume"
                    android:scaleType="centerInside"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="start|center_vertical"
            android:layout_gravity="start|bottom"
            android:id="@+id/video_time_progress_container"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginRight="6dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp">
            <com.narvii.widget.NVImageView
                android:id="@+id/video_playing_icon"
                android:visibility="gone"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginBottom="1dp"
                android:scaleType="centerInside"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#fff"
                android:id="@+id/video_time_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:shadowColor="#0000"
                android:shadowDy="1"
                android:shadowRadius="1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <com.narvii.widget.TintButton
            android:id="@+id/fullscreen"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:scaleType="centerInside"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</FrameLayout>

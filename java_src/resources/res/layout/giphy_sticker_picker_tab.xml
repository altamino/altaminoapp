<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/picker_tab_layout"
    android:layout_width="match_parent"
    android:layout_height="46dp">
    <com.narvii.widget.TintButton
        android:id="@+id/sticker_add"
        android:background="@color/attachment_tab_bg"
        android:paddingLeft="15dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/ic_sticker_add_white"
        android:paddingStart="15dp"
        android:paddingEnd="8dp"
        app:tintColor="#ffffff"/>
    <com.narvii.widget.TintButton
        android:id="@+id/sticker_search"
        android:background="@color/attachment_tab_bg"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/ic_sticker_search_white"
        app:tintColor="#fff"/>
    <com.narvii.widget.NVPagerTabLayout
        android:layout_gravity="top"
        android:id="@+id/tabs"
        android:background="@color/attachment_tab_bg"
        android:layout_width="0px"
        android:layout_height="match_parent"
        android:layout_weight="1"
        app:indicator_show="false"
        app:scroll_divide_equal="false"/>
</LinearLayout>

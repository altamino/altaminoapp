<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingTop="6dp"
    android:paddingRight="12dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <FrameLayout
        android:paddingLeft="10dp"
        android:paddingTop="6dp"
        android:paddingRight="10dp"
        android:paddingBottom="6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/quizzes_share"
            android:background="@drawable/button_quizzes_share_background"
            android:paddingLeft="@dimen/quizzes_share_padding"
            android:paddingTop="8dp"
            android:paddingRight="@dimen/quizzes_share_padding"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/quizzes_share_padding"
            android:paddingEnd="@dimen/quizzes_share_padding">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_share"/>
            <com.narvii.widget.AutoSizingTextView
                android:textSize="20dp"
                android:textColor="#fff"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:text="@string/share"
                android:maxLines="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                app:autoSizeTextMaxSize="20dp"
                app:autoSizeTextMinSize="12dp"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:paddingLeft="10dp"
        android:paddingTop="6dp"
        android:paddingRight="10dp"
        android:paddingBottom="6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_weight="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginStart="12dp">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/quizzes_replay"
            android:background="@drawable/button_quizzes_share_background"
            android:paddingLeft="@dimen/quizzes_share_padding"
            android:paddingTop="8dp"
            android:paddingRight="@dimen/quizzes_share_padding"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/quizzes_share_padding"
            android:paddingEnd="@dimen/quizzes_share_padding">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_replay"/>
            <com.narvii.widget.AutoSizingTextView
                android:textSize="20dp"
                android:textColor="#fff"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="10dp"
                android:text="@string/replay"
                android:maxLines="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="10dp"
                app:autoSizeTextMaxSize="20dp"
                app:autoSizeTextMinSize="12dp"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

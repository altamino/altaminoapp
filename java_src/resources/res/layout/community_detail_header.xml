<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.github.mmin18.widget.FlexLayout
            android:id="@+id/icon_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true">
            <com.narvii.widget.CommunityIconView
                android:id="@+id/icon"
                android:background="@android:color/transparent"
                android:scaleType="centerCrop"
                android:maxWidth="140dp"
                android:layout_centerVertical="true"
                narvii:defaultDrawable="@drawable/placeholder_community_big"
                narvii:layout_height="this.width"
                narvii:layout_width="screen.width*0.25"
                narvii:scalePlaceholder="true"
                narvii:shadowColor="#333"/>
            <com.narvii.widget.TintButton
                android:id="@+id/community_invite_lock"
                android:background="@drawable/oval_mask"
                android:padding="3dp"
                android:visibility="gone"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginLeft="6dp"
                android:src="@drawable/locked"
                android:scaleType="centerInside"
                android:layout_marginStart="6dp"
                narvii:layout_left="icon.left+10dp"
                narvii:layout_top="icon.top+10dp"
                narvii:tintColor="#fff"/>
        </com.github.mmin18.widget.FlexLayout>
        <com.github.mmin18.widget.FlexLayout
            android:id="@+id/community_info_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@+id/icon_container"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/icon_container">
            <TextView
                android:textSize="21dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:includeFontPadding="false"
                narvii:layout_top="0dp"
                narvii:layout_width="min(wrap_content,screen.width-10dp-screen.width*0.35)"/>
            <com.narvii.widget.CommunityActivenessBar
                android:id="@+id/community_activeness_level"
                narvii:layout_height="this.width*0.125+2dp"
                narvii:layout_top="title.bottom+4dp"
                narvii:layout_width="screen.width*0.33"/>
            <com.narvii.widget.AutoSizingTextView
                android:textSize="15dp"
                android:textColor="#fff"
                android:ellipsize="end"
                android:id="@+id/membercount"
                android:layout_height="wrap_content"
                android:maxLines="1"
                narvii:autoSizeTextMaxSize="15dp"
                narvii:autoSizeTextMinSize="13dp"
                narvii:layout_top="community_activeness_level.bottom+6dp"
                narvii:layout_width="min(wrap_content,screen.width-10dp-screen.width*0.35)"/>
            <com.narvii.widget.AutoSizingTextView
                android:textSize="12dp"
                android:textColor="#fff"
                android:ellipsize="end"
                android:id="@+id/community_language"
                android:background="@drawable/community_language_bg"
                android:paddingLeft="10dp"
                android:paddingTop="2dp"
                android:paddingRight="10dp"
                android:paddingBottom="2dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                narvii:autoSizeTextMaxSize="12dp"
                narvii:autoSizeTextMinSize="10dp"
                narvii:layout_top="membercount.bottom+2dp"
                narvii:layout_width="min(wrap_content,screen.width-10dp-screen.width*0.35)"/>
        </com.github.mmin18.widget.FlexLayout>
    </RelativeLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:background="@drawable/round_dark_corner_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        style="@style/TextCellWithPadding">
        <TextView
            android:textSize="12dp"
            android:textColor="#ffff"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/community_id_hint"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/community_id"/>
        <com.narvii.widget.AutoSizingTextView
            android:textColor="#fff"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/community_id_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:singleLine="true"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
</LinearLayout>

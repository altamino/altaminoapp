<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:text="@string/account_email"
        style="@style/account_edit_title"/>
    <com.narvii.widget.AutoCompleteEmailView
        android:textSize="@dimen/text_input_size"
        android:textColor="#fff"
        android:textColorHint="#fff"
        android:gravity="center_vertical"
        android:id="@+id/edit"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:singleLine="true"
        android:inputType="textEmailAddress"
        android:imeOptions="actionNext"
        android:textCursorDrawable="@drawable/account_edit_cursor_white"/>
    <include layout="@layout/flexlayout_edit_line"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#000"
        android:id="@+id/input_error_hint"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/invalid_email"/>
</merge>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@android:id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/empty_text"
            android:padding="10dp"
            android:paddingTop="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/folder_empty"/>
        <com.narvii.widget.FontAwesomeView
            android:textColor="@color/button_text_gray_w"
            android:gravity="center"
            android:id="@+id/empty_retry"
            android:padding="12dp"
            android:clickable="true"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="@string/ion_refresh"/>
        <TextView
            android:textSize="18dp"
            android:textColor="#fff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/create_wiki"
            android:background="@drawable/button_round_white_stroke"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/create_wiki_entry"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>
        <TextView
            android:textSize="18dp"
            android:textColor="#fff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/add_wiki"
            android:background="@drawable/button_round_white_stroke"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/add_wiki_entry"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>
    </LinearLayout>
</ScrollView>

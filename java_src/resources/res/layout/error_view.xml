<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/error_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.app.theme.view.NVThemeTextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="#555"
        android:id="@+id/error"
        android:paddingTop="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/error"
        app:nv_dark_textColor="#88ffffff"/>
    <com.narvii.app.theme.view.NVThemeTextView
        android:textSize="14dp"
        android:textColor="#555"
        android:gravity="center"
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:text="@string/normal_error_long"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:nv_dark_textColor="#88ffffff"/>
    <com.narvii.widget.FontAwesomeView
        android:textColor="@color/button_text_gray_w"
        android:gravity="center"
        android:id="@+id/retry"
        android:padding="12dp"
        android:clickable="true"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="@string/ion_refresh"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="#fafafa"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:clickable="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <com.narvii.widget.CommunityIconView
        android:id="@+id/community_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        app:defaultDrawable="@drawable/placeholder_community_big"
        app:imageType="community-icon"
        app:shadowColor="#0000"
        app:shadowOffsetY="1dp"
        app:shadowSize="1dp"/>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="#4a4a4a"
        android:ellipsize="end"
        android:id="@+id/community_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_weight="1"/>
    <Button
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/action"
        android:background="@drawable/semi_actionbar_join_btn"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="@string/enter"
        android:includeFontPadding="false"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"/>
</LinearLayout>

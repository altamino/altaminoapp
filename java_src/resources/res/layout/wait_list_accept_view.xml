<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/wait_list_accept_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="10dp"
    android:layout_marginRight="10dp"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp">
    <TextView
        android:textColor="#ffffff"
        android:layout_gravity="center"
        android:id="@+id/accept"
        android:background="@drawable/button_round_waiting_list_accept"
        android:paddingLeft="10dp"
        android:paddingTop="5dp"
        android:paddingRight="10dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/accept"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#88000000"
        android:id="@+id/cancel"
        android:background="@drawable/transparent_layout_bg_dark"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cancel"/>
    <com.narvii.widget.SpinningView
        android:layout_gravity="center"
        android:id="@+id/progress"
        android:visibility="gone"
        android:layout_width="@dimen/spin_tiny_size"
        android:layout_height="@dimen/spin_tiny_size"
        narvii:spinColor="#eee"
        narvii:spinStyle="2"/>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.narvii.widget.PressedFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_margin="6dp">
    <com.narvii.widget.RadiusLayout
        android:id="@+id/subcategory_background_unselected"
        android:background="#0cdadcfb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_corner_radius="8dp"
        app:radius_stroke_color="#3fdadcfb"
        app:radius_stroke_dash_gap_width="2dp"
        app:radius_stroke_dash_width="1dp"
        app:radius_stroke_width="1dp"/>
    <com.narvii.widget.RadiusLayout
        android:id="@+id/subcategory_background_selected"
        android:background="#3f00c5b2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_corner_radius="8dp"
        app:radius_stroke_color="#990cf2be"
        app:radius_stroke_width="1dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/subcategory_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:maxLines="1"/>
</com.narvii.widget.PressedFrameLayout>

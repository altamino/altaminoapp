<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/tipping_price_item"
    android:background="@drawable/stroke_tipping"
    android:layout_width="76dp"
    android:layout_height="100dp">
    <com.narvii.widget.NVImageView
        android:id="@+id/tipping_price_icon"
        android:layout_width="56dp"
        android:layout_height="48dp"
        android:layout_marginBottom="5dp"
        android:scaleType="fitCenter"
        app:showPressedMask="false"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/tipping_hint_default"
        android:layout_width="wrap_content"
        android:layout_height="20dp">
        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:src="@drawable/amino_coin_big"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:id="@+id/tipping_price_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:gravity="center_vertical"
        android:id="@+id/tipping_hint_custom"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="@string/custom"/>
    <EditText
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:textColorHint="#80ffffff"
        android:gravity="center_horizontal"
        android:id="@+id/custom_tipping_price_input"
        android:background="@null"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:singleLine="true"
        android:inputType="number"
        android:textCursorDrawable="@drawable/edit_cursor_blue"
        android:textAlignment="center"/>
</LinearLayout>

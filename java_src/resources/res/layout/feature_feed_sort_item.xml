<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="10dp"
    android:paddingTop="6dp"
    android:paddingRight="10dp"
    android:paddingBottom="6dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <com.narvii.widget.ThumbImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        narvii:cornerRadius="2dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="8dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#333"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="0px"
            android:singleLine="true"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#555"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
    </LinearLayout>
    <include layout="@layout/drag_sort_drag_handle"/>
</LinearLayout>

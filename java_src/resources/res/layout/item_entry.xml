<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="@drawable/item_selector_white_grey"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <TextView
        android:textSize="17dp"
        android:textColor="#4a4a4a"
        android:id="@+id/text"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="20dp"
        android:singleLine="true"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:gravity="center"
        android:id="@+id/badge"
        android:visibility="gone"
        android:layout_marginRight="12dp"
        android:maxWidth="200dp"
        android:layout_marginEnd="12dp"
        style="@style/tv_badge"/>
    <com.narvii.widget.TintButton
        android:gravity="center"
        android:id="@+id/chevron_right"
        android:layout_width="10dp"
        android:layout_height="15dp"
        android:layout_marginRight="@dimen/item_padding_horizontal_ex"
        android:src="@drawable/chevron_right_mirror"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/item_padding_horizontal_ex"/>
</LinearLayout>

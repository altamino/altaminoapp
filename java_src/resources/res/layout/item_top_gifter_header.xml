<?xml version="1.0" encoding="utf-8"?>
<com.narvii.widget.Top3UserLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/top3_layout"
    android:paddingBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.github.mmin18.widget.FlexLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/layout_avatar"
                android:clipChildren="false"
                android:clipToPadding="false"
                narvii:layout_centerX="50%"
                narvii:layout_height="this.width"
                narvii:layout_width="70%">
                <include
                    android:duplicateParentState="true"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    layout="@layout/user_avatar_layout_mini_nobadge"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/user_no_image"
                narvii:layout_bottom="layout_avatar.bottom+this.width*0.45"
                narvii:layout_centerX="50%"
                narvii:layout_height="this.width"
                narvii:layout_width="25%"/>
        </com.github.mmin18.widget.FlexLayout>
        <com.narvii.widget.NicknameView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:ellipsize="end"
            android:id="@+id/name"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="10dp"
            android:lines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            narvii:hideInfluencerBadge="false"
            narvii:hideMembershipBadge="true"
            narvii:hideRankingBadge="true"
            narvii:hideRole="true"/>
    </LinearLayout>
</com.narvii.widget.Top3UserLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/community_list_container"
    android:background="#242424"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/drawer_quit"
        android:paddingTop="14dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="2dp"
            android:src="@drawable/drawer_community_exit_mirror"
            android:scaleType="centerInside"
            android:layout_marginEnd="2dp"/>
        <TextView
            android:textSize="11dp"
            android:textStyle="bold"
            android:textColor="@color/text_clickable_white"
            android:layout_gravity="center_horizontal"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/main_drawer_exit"/>
    </LinearLayout>
    <View
        android:id="@+id/stub1"
        android:background="#979797"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="2dp"
        android:layout_below="@+id/drawer_quit"/>
    <com.narvii.widget.NVListView
        android:id="@+id/community_list"
        android:paddingTop="10dp"
        android:paddingBottom="20dp"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/stub1"
        android:layout_alignParentBottom="true"/>
    <View
        android:id="@+id/stub2"
        android:background="@drawable/drawer_host_community_list_top_fade"
        android:layout_width="match_parent"
        android:layout_height="13dp"
        android:layout_below="@+id/stub1"/>
</RelativeLayout>

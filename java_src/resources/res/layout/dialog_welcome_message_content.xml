<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/title"
        style="@style/on_boarding_title"/>
    <View style="@style/on_boarding_title_divider"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/fill_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/agent_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp">
            <include
                android:layout_gravity="center_horizontal"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginLeft="20dp"
                android:layout_marginStart="20dp"
                layout="@layout/user_avatar_layout_mini"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0px"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.narvii.widget.NicknameView
                    android:textSize="16dp"
                    android:textColor="#303030"
                    android:id="@+id/nickname"
                    android:paddingLeft="12dp"
                    android:paddingRight="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="20dp"
                    narvii:hideRole="true"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#fff"
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:background="@drawable/role_bg_default"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="3dp"
                    android:text="@string/role_leader"
                    android:singleLine="true"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>
        </LinearLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp">
            <TextView
                android:textSize="14dp"
                android:textColor="#222"
                android:gravity="start"
                android:id="@+id/text"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
        </ScrollView>
    </LinearLayout>
</LinearLayout>

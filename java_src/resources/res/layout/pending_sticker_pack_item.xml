<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.widget.NVImageView
        android:id="@+id/collection_icon"
        android:padding="2dp"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:defaultDrawable="@color/sticker_placeholder"
        app:scalePlaceholder="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginStart="10dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/store_item_name_size_default"
                android:textStyle="bold"
                android:textColor="#333334"
                android:id="@+id/collection_name"
                android:layout_width="0px"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:singleLine="true"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#cccccc"
                android:id="@+id/datetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:layout_marginEnd="6dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <include
                android:layout_width="20dp"
                android:layout_height="20dp"
                layout="@layout/user_avatar_layout_mini_nobadge"/>
            <com.narvii.widget.NicknameView
                android:textSize="12dp"
                android:textColor="#4a90e2"
                android:id="@+id/nickname"
                android:layout_width="0px"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                app:hideRole="true"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#999999"
                android:id="@+id/sticker_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:layout_marginEnd="6dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

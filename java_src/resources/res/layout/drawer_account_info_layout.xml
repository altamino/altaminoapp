<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/drawer_top"
    android:background="@color/drawer_top_bg_color"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        style="@style/cell_with_horizontal_padding">
        <com.narvii.widget.NVImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/drawer_logo"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:scaleType="fitCenter"
            android:maxHeight="44dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.narvii.widget.AutoSizingTextView
                android:textSize="30dp"
                android:textColor="#fff"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/drawer_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:shadowColor="#0000"
                android:shadowDy="1"
                android:shadowRadius="3"
                narvii:autoSizeTextMaxSize="30dp"
                narvii:autoSizeTextMinSize="15dp"
                style="@style/cell_with_horizontal_padding"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/amino_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:src="@drawable/drawer_amino_logo"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">
        <FrameLayout
            android:id="@+id/drawer_login_hint"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="128dp">
            <com.narvii.widget.ThumbImageView
                android:layout_gravity="center"
                android:duplicateParentState="true"
                android:layout_width="96dp"
                android:layout_height="96dp"
                narvii:defaultDrawable="@drawable/login_hint_bg"
                narvii:shadowColor="#0000"
                narvii:shadowSize="5dp"
                narvii:strokeWidth="2.5dp"
                style="@style/AvatarImageView"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="86dp"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="#f2f2f2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_account_signup"
                    android:shadowColor="#0000"
                    android:shadowDy="2"
                    android:shadowRadius="5"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#f2f2f2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_account_or_login"
                    android:shadowColor="#0000"
                    android:shadowDy="1"
                    android:shadowRadius="3"/>
            </LinearLayout>
        </FrameLayout>
        <com.github.mmin18.widget.FlexLayout
            android:layout_gravity="center_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp">
            <View
                android:id="@+id/avatar_bg"
                android:background="@drawable/white_oval"
                narvii:layout_centerX="user_avatar_layout.centerX"
                narvii:layout_centerY="user_avatar_layout.centerY"
                narvii:layout_height="user_avatar_layout.height"
                narvii:layout_width="user_avatar_layout.width"/>
            <include
                android:layout_width="@dimen/drawer_left_avatar_size"
                android:layout_height="@dimen/drawer_left_avatar_size"
                narvii:shadowColor="#0000"
                narvii:shadowOffsetY="1dp"
                narvii:shadowSize="2dp"
                narvii:strokeWidth="2dp"
                layout="@layout/user_avatar_layout_large"/>
            <com.narvii.widget.ThumbImageView
                android:id="@+id/amino_staff_badge"
                android:visibility="gone"
                android:src="@drawable/amino_staff"
                narvii:cornerRadius="20dp"
                narvii:layout_bottom="user_avatar_layout.bottom+2dp"
                narvii:layout_centerX="user_avatar_layout.centerX"
                narvii:layout_height="this.width*23/79"
                narvii:layout_width="user_avatar_layout.width*0.7"
                narvii:shadowColor="#0000"
                narvii:shadowOffsetX="1dp"
                narvii:shadowOffsetY="1dp"
                narvii:shadowSize="2dp"/>
            <com.narvii.checkin.CheckInCircle
                android:id="@+id/drawer_checkin_ring"
                android:padding="8dp"
                narvii:layout_centerX="user_avatar_layout.centerX"
                narvii:layout_centerY="user_avatar_layout.centerY"
                narvii:layout_height="18dp-2px+@dimen/drawer_left_avatar_size"
                narvii:layout_width="18dp-2px+@dimen/drawer_left_avatar_size"/>
            <View
                android:id="@+id/not_activated"
                android:background="@drawable/ic_not_activated"
                android:layout_width="22dp"
                android:layout_height="22dp"
                narvii:layout_right="user_avatar_layout.right-4dp"
                narvii:layout_top="user_avatar_layout.top"/>
            <com.narvii.widget.MoodView
                android:id="@+id/mood"
                android:layout_width="@dimen/sticker_view_width"
                android:layout_height="@dimen/sticker_view_height"
                narvii:layout_left="user_avatar_layout.left+user_avatar_layout.width*0.56"
                narvii:layout_top="user_avatar_layout.top-user_avatar_layout.height*0.05"/>
        </com.github.mmin18.widget.FlexLayout>
    </FrameLayout>
    <com.narvii.widget.NicknameView
        android:textSize="@dimen/drawer_left_nickname_text_size"
        android:textStyle="bold"
        android:textColor="@color/main_drawer_text"
        android:layout_gravity="center_horizontal"
        android:id="@+id/nickname"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:singleLine="true"
        android:shadowColor="#0000"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        narvii:hideInfluencerBadge="false"
        narvii:hideRankingBadge="true"
        narvii:nameCenter="true"
        narvii:roleRadiusRatio="0.34"
        narvii:roleScale="0.6"/>
    <com.github.mmin18.widget.FlexLayout
        android:layout_gravity="center_horizontal"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.narvii.widget.RankingTitleView
            android:id="@+id/drawer_user_role"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/drawer_left_checkin_height_ex"
            narvii:layout_centerX="50%"
            narvii:layout_top="4dp"
            narvii:textMinWidthTimes="5"/>
        <com.narvii.widget.PushButton
            android:id="@+id/drawer_checkin"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/drawer_left_checkin_width"
            android:minHeight="@dimen/drawer_left_checkin_height"
            narvii:layout_centerX="50%"
            narvii:layout_top="8dp"
            narvii:pushButtonColor="#52d127"
            narvii:pushButtonLift="3dp"
            narvii:pushShadowAlpha="0.5">
            <TextView
                android:textSize="@dimen/drawer_left_checkin_text_size"
                android:textStyle="bold"
                android:textColor="#fff"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/check_in"/>
        </com.narvii.widget.PushButton>
        <com.narvii.widget.PushButton
            android:id="@+id/drawer_checkin_hold"
            android:visibility="invisible"
            android:clipChildren="false"
            android:clipToPadding="false"
            narvii:layout_centerX="drawer_checkin.centerX"
            narvii:layout_centerY="drawer_checkin.centerY"
            narvii:layout_height="drawer_checkin.height"
            narvii:layout_width="max(wrap_content,drawer_checkin.width)"
            narvii:pushButtonColor="#52d127"
            narvii:pushButtonLift="3dp"
            narvii:pushShadowAlpha="0.5">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:layout_gravity="center"
                android:id="@+id/drawer_checkin_hold_text"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hold_longer"/>
        </com.narvii.widget.PushButton>
        <com.narvii.widget.PushButton
            android:id="@+id/drawer_checkin_fake"
            android:visibility="gone"
            android:layout_width="@dimen/drawer_left_checkin_height"
            android:layout_height="@dimen/drawer_left_checkin_height"
            narvii:layout_centerY="drawer_user_role.centerY"
            narvii:layout_right="95%"
            narvii:pushButtonColor="#52d127"
            narvii:pushButtonLift="3dp"
            narvii:pushShadowAlpha="0.5"/>
    </com.github.mmin18.widget.FlexLayout>
    <View
        android:id="@+id/check_in_streak_bar_margin_top"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/check_in_streak_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.narvii.checkin.CheckInStreakBar
            android:id="@+id/check_in_streak_bar"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            narvii:childMaxSize="20dp"
            narvii:circleSize="12dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#fff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/strike_lost"
            android:background="@drawable/strike_lost_round_red"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="7dp"
            android:layout_marginRight="10dp"
            android:text="@string/check_in_streak_lost"/>
    </LinearLayout>
    <com.narvii.widget.PushEffectLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/account_notice_container"
        android:visibility="gone"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <TextView
            android:textSize="14dp"
            android:textColor="#fff"
            android:id="@+id/account_notice"
            android:background="@drawable/account_notice_bg"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/important_notice_alert"
            android:translationZ="2dp"
            android:elevation="4dp"
            style="@style/cell_with_horizontal_padding"/>
    </com.narvii.widget.PushEffectLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
</LinearLayout>

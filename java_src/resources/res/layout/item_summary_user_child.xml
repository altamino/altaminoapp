<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/button_rect_white"
    android:paddingLeft="@dimen/item_padding_left_right"
    android:paddingTop="12dp"
    android:paddingRight="@dimen/item_padding_left_right"
    android:paddingBottom="12dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/item_padding_left_right"
    android:paddingEnd="@dimen/item_padding_left_right">
    <include
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        layout="@layout/user_avatar_layout_mini_nobadge"/>
    <ImageView
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/chevron_right"
        android:background="@drawable/chevron_right_mirror"
        android:visibility="invisible"
        android:layout_width="10dp"
        android:layout_height="15dp"
        android:layout_marginLeft="10dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"
        android:layout_alignParentEnd="true"/>
    <com.narvii.widget.NicknameView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="#000"
        android:ellipsize="end"
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:maxLines="1"
        android:layout_toLeftOf="@+id/chevron_right"
        android:layout_toRightOf="@+id/user_avatar_layout"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:layout_toStartOf="@+id/chevron_right"
        android:layout_toEndOf="@+id/user_avatar_layout"/>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.narvii.chat.detail.HeaderLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:id="@+id/thread_header"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/thread_detail_header_height">
    <com.narvii.widget.FullsizeImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="34dp"
        android:scaleType="centerCrop"
        android:layout_alignParentTop="true"
        android:layout_centerInParent="true"
        narvii:defaultDrawable="@drawable/hangout_placeholder"
        narvii:imageType="chat-cover"/>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="#f2f2f2"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:shadowColor="#0000"
        android:shadowDy="2"
        android:shadowRadius="8"
        android:layout_above="@+id/stub5"
        android:layout_centerInParent="true"/>
    <include
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        layout="@layout/user_avatar_layout_large"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="#f2f2f2"
        android:gravity="center"
        android:id="@+id/chat_author_absent"
        android:background="@drawable/button_oval_mask"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="@string/chat_not_present"
        android:layout_alignTop="@+id/user_avatar_layout"
        android:layout_centerHorizontal="true"/>
    <com.github.mmin18.widget.RealtimeBlurView
        android:layout_gravity="center"
        android:id="@+id/blur"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        narvii:realtimeBlurMaxFPS="5"
        narvii:realtimeBlurRadius="20dp"
        narvii:realtimeOverlayColor="#ffff"/>
</com.narvii.chat.detail.HeaderLayout>

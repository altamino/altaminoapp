<?xml version="1.0" encoding="utf-8"?>
<com.narvii.post.entry.PostEntryView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/post_entry_frame"
        android:padding="@dimen/post_entry_padding"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true">
        <View
            android:id="@+id/theme_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.narvii.widget.ThumbImageView
            android:id="@+id/post_entry_btn2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            narvii:cornerRadius="38dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/post_entry_icon"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_compose_mirror"/>
        <Button
            android:id="@+id/post_entry_btn"
            android:background="@drawable/post_entry_btn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</com.narvii.post.entry.PostEntryView>

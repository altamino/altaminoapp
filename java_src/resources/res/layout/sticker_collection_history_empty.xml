<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@android:id/empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.widget.FontAwesomeView
        android:textColor="@color/button_text_gray_w"
        android:gravity="center"
        android:id="@+id/empty_retry"
        android:padding="12dp"
        android:clickable="true"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="@string/ion_refresh"/>
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="@color/empty_text_color"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/empty_text"
        android:padding="10dp"
        android:paddingTop="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_stickers"/>
    <TextView
        android:textSize="20dp"
        android:textColor="#fff"
        android:id="@+id/check_store"
        android:background="@drawable/selector_subscribe_orange"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="50dp"
        android:text="@string/check_the_store"
        android:paddingStart="50dp"
        android:paddingEnd="50dp"/>
</LinearLayout>

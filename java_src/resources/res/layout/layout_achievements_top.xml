<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/badge"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="20dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/title"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.narvii.widget.BoldBorderRankingTitleView
        android:id="@+id/ranking_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"
        app:progressHeight="28dp"
        app:showBadge="false"
        app:showReputation="true"
        app:textSize="15dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#ffff"
        android:gravity="center"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:text="@string/earn_rp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#008eff"
        android:gravity="center"
        android:id="@+id/see_all_ranks"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:text="@string/see_all_ranks"/>
    <View
        android:background="#ffff"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="50dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="50dp"
        android:layout_marginBottom="14dp"/>
</LinearLayout>

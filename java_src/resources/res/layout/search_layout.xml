<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:id="@+id/search_layout_with_shadow"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.widget.ThumbImageView
        android:id="@+id/shadow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cornerRadius="@dimen/home_master_search_corner_radius"
        app:shadowColor="#33000000"
        app:shadowOffsetX="0dp"
        app:shadowOffsetY="0dp"
        app:shadowSize="4dp"/>
    <View
        android:id="@+id/search_layout_bg"
        android:background="@drawable/selector_white_18_corner_4"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.1"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/search_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.narvii.widget.TintButton
            android:layout_gravity="start|center_vertical"
            android:id="@+id/ic_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/master_home_top_tab_search_inner_padding"
            android:src="@drawable/ic_master_top_search"
            android:scaleType="centerInside"
            android:layout_marginStart="@dimen/master_home_top_tab_search_inner_padding"
            app:tintColor="@color/selector_master_search"/>
        <com.narvii.widget.AutoSizingTextView
            android:textSize="14dp"
            android:textColor="@color/selector_master_search"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/search_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/search"
            android:maxLines="1"
            app:autoSizeTextMaxSize="14dp"
            app:autoSizeTextMinSize="8dp"/>
    </FrameLayout>
</FrameLayout>

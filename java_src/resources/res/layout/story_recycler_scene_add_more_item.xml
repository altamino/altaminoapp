<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <View
        android:id="@+id/split_view"
        android:background="@drawable/story_dash_line"
        android:visibility="visible"
        android:layout_width="8.5dp"
        android:layout_height="1.5dp"
        android:layerType="software"/>
    <com.narvii.widget.TintButton
        android:id="@+id/iv_add"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_scene_added"
        narvii:tintColor="@color/story_theme_color"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.narvii.monetization.sticker.widget.StickerCollectionSourceView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/source_view"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/source_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp">
        <ImageView
            android:id="@+id/me_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginRight="4dp"
            android:scaleType="fitCenter"
            android:layout_marginEnd="4dp"/>
        <com.narvii.widget.CommunityIconView
            android:id="@+id/source_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"
            app:cornerRadius="2dp"
            app:defaultDrawable="@drawable/placeholder_community"
            app:scalePlaceholder="true"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#999999"
            android:id="@+id/source_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</com.narvii.monetization.sticker.widget.StickerCollectionSourceView>

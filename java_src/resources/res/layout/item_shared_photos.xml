<?xml version="1.0" encoding="utf-8"?>
<com.github.mmin18.widget.FlexLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/shared_photo_item_padding"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.narvii.widget.ThumbImageView
        android:id="@+id/photo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:defaultDrawable="@color/placeholder_lighter"
        app:imageType="shared-folder-image"
        app:layout_height="this.width"
        app:strokeColor="#16ffffff"
        app:strokeWidth="1px"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#fff"
        android:id="@+id/new_text"
        android:background="@drawable/shared_photo_new"
        android:paddingLeft="4dp"
        android:paddingTop="2dp"
        android:paddingRight="4dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/new_word"
        android:singleLine="true"
        app:layout_right="photo.right"
        app:layout_top="photo.top"/>
    <ImageView
        android:id="@+id/select"
        android:paddingLeft="10dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        app:layout_right="100%"
        app:layout_top="0dp"/>
    <View
        android:id="@+id/disabled_overlay"
        android:background="#64e90d3b"
        android:visibility="gone"
        app:layout_bottom="photo.bottom"
        app:layout_left="photo.left"
        app:layout_right="photo.right"
        app:layout_top="photo.top"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:id="@+id/title"
        android:background="@drawable/shared_photo_title_bg_gradient"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:shadowColor="#88000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
        app:layout_bottom="photo.bottom"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/disabled_amino"
        android:background="#832b3e"
        android:visibility="gone"
        app:layout_bottom="photo.bottom"
        app:layout_left="photo.left"
        app:layout_right="photo.right"
        app:layout_top="photo.top">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_shared_photo_amino_lock"/>
        <com.narvii.widget.AutoSizingTextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="6dp"
            android:text="@string/disabled_by_team_amino"
            android:maxLines="3"
            app:autoSizeTextMaxSize="14dp"
            app:autoSizeTextMinSize="10dp"/>
    </LinearLayout>
</com.github.mmin18.widget.FlexLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/actionbar_back"
        android:paddingLeft="6dp"
        android:paddingTop="10dp"
        android:paddingRight="0dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="-3dp"
        android:src="@drawable/ic_back_mirror"
        android:minHeight="30dp"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:paddingStart="6dp"
        android:paddingEnd="0dp"
        android:layout_marginEnd="-3dp"
        android:layout_alignParentStart="true"/>
    <FrameLayout
        android:id="@+id/icon_container"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/actionbar_back"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/actionbar_back">
        <com.narvii.widget.CommunityIconView
            android:id="@+id/community_icon"
            android:clickable="true"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            app:defaultDrawable="@drawable/placeholder_community_big"
            app:imageType="community-icon"
            app:shadowColor="#0000"
            app:shadowOffsetY="1dp"
            app:shadowSize="1dp"/>
    </FrameLayout>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/fake_actionbar_title"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:shadowColor="#0000"
        android:shadowDy="1"
        android:shadowRadius="5"
        android:layout_toRightOf="@+id/icon_container"
        android:layout_centerInParent="true"
        android:layout_centerVertical="true"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_toEndOf="@+id/icon_container"/>
    <RelativeLayout
        android:gravity="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            layout="@layout/wallet_balance_account_view_global_profile"/>
    </RelativeLayout>
</RelativeLayout>

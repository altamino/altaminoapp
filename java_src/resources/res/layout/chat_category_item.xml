<?xml version="1.0" encoding="utf-8"?>
<com.narvii.chat.global.GlobalChatCategoryItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="5dp"
    android:paddingTop="15dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="5dp">
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:gravity="center_vertical"
        android:layout_gravity="start"
        android:id="@+id/category_title"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:textAllCaps="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="0dp">
        <include
            android:id="@+id/thread_1"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_weight="1"
            layout="@layout/chat_hangout_item"/>
        <include
            android:id="@+id/thread_2"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_weight="1"
            layout="@layout/chat_hangout_item"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="0dp">
        <include
            android:id="@+id/thread_3"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_weight="1"
            layout="@layout/chat_hangout_item"/>
        <include
            android:id="@+id/thread_4"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_weight="1"
            layout="@layout/chat_hangout_item"/>
    </LinearLayout>
    <include
        android:id="@+id/show_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="13dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="13dp"
        layout="@layout/item_show_more_story"/>
</com.narvii.chat.global.GlobalChatCategoryItemView>

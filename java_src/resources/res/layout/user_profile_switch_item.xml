<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/user_switch_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="35dp">
        <com.narvii.widget.SwitchButton
            android:id="@+id/user_switch_posts"
            android:paddingBottom="2dp"
            android:layout_width="0px"
            android:layout_height="match_parent"
            android:text="@string/user_switch_posts"
            android:layout_weight="1"
            style="@style/SwitchButton"/>
        <com.narvii.widget.SwitchButton
            android:id="@+id/user_switch_comments"
            android:paddingBottom="2dp"
            android:layout_width="0px"
            android:layout_height="match_parent"
            android:text="@string/user_switch_comments"
            android:layout_weight="1"
            style="@style/SwitchButton"/>
        <com.narvii.widget.SwitchButton
            android:id="@+id/user_switch_saved_posts"
            android:paddingBottom="2dp"
            android:layout_width="0px"
            android:layout_height="match_parent"
            android:text="@string/user_switch_saved_posts"
            android:layout_weight="1"
            style="@style/SwitchButton"/>
    </RadioGroup>
    <include layout="@layout/list_divider"/>
</LinearLayout>

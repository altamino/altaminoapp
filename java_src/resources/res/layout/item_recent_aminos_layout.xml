<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="#fff"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:paddingLeft="@dimen/headline_default_padding_horizontal"
            android:paddingRight="@dimen/headline_default_padding_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/headline_default_padding_horizontal"
            android:paddingEnd="@dimen/headline_default_padding_horizontal">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_amino_recent"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="#4a4a4a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/recent"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <com.narvii.widget.HorizontalRecyclerView
            android:id="@+id/recent_amino_layout"
            android:paddingLeft="@dimen/headline_default_padding_horizontal"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="@dimen/headline_default_padding_horizontal"/>
    </LinearLayout>
</FrameLayout>

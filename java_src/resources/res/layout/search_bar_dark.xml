<?xml version="1.0" encoding="utf-8"?>
<com.narvii.widget.SearchBar xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <EditText
        android:textSize="16dp"
        android:textColor="#fff"
        android:textColorHint="#fff"
        android:id="@+id/search_text"
        android:background="@drawable/search_bar_text_dark"
        android:paddingLeft="14dp"
        android:paddingRight="32dp"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_margin="8dp"
        android:layout_centerVertical="true"
        android:inputType="textCapSentences"
        android:imeOptions="actionSearch"
        android:paddingStart="14dp"
        android:paddingEnd="32dp"/>
    <Button
        android:textSize="16dp"
        android:textColor="#fff"
        android:id="@+id/search_btn"
        android:background="@drawable/search_bar_text_dark"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_margin="8dp"
        android:layout_centerVertical="true"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/search_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">
        <com.narvii.widget.FontAwesomeView
            android:textSize="18dp"
            android:textColor="@color/light_blue"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ion_ios_search"
            android:layout_alignLeft="@+id/search_text"
            android:layout_centerVertical="true"
            android:layout_alignStart="@+id/search_text"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/light_blue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/search"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <com.narvii.widget.FontAwesomeView
        android:textSize="18dp"
        android:textColor="#aaa"
        android:gravity="center"
        android:id="@+id/search_clear"
        android:padding="10dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:text="@string/ion_android_close"
        android:layout_alignRight="@+id/search_text"
        android:layout_centerVertical="true"
        android:layout_alignEnd="@+id/search_text"/>
</com.narvii.widget.SearchBar>

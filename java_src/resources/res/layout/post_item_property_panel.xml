<?xml version="1.0" encoding="utf-8"?>
<com.narvii.item.property.ItemPropertyEditPanel xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/post_item_property_panel"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="#aaa"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:background="#fafafa"
        android:layout_width="match_parent"
        android:layout_height="46dp">
        <com.narvii.widget.FontAwesomeView
            android:textSize="16dp"
            android:gravity="center"
            android:id="@+id/post_item_property_switch_rating_cost"
            android:padding="13dp"
            android:layout_width="46dp"
            android:layout_height="match_parent"
            android:text="@string/fa_dollar"/>
        <com.narvii.widget.FontAwesomeView
            android:textSize="16dp"
            android:gravity="center"
            android:id="@+id/post_item_property_switch_rating_heart"
            android:padding="13dp"
            android:layout_width="46dp"
            android:layout_height="match_parent"
            android:text="@string/fa_heart"/>
        <com.narvii.widget.FontAwesomeView
            android:textSize="16dp"
            android:gravity="center"
            android:id="@+id/post_item_property_switch_rating_star"
            android:padding="13dp"
            android:layout_width="46dp"
            android:layout_height="match_parent"
            android:text="@string/fa_star"/>
        <com.narvii.widget.FontAwesomeView
            android:textSize="16dp"
            android:gravity="center"
            android:id="@+id/post_item_property_switch_calendar"
            android:padding="13dp"
            android:layout_width="46dp"
            android:layout_height="match_parent"
            android:text="@string/fa_calendar"/>
        <com.narvii.widget.FontAwesomeView
            android:textSize="16dp"
            android:gravity="center"
            android:id="@+id/post_item_property_switch_keyboard"
            android:padding="13dp"
            android:layout_width="46dp"
            android:layout_height="match_parent"
            android:text="@string/fa_keyboard_o"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/post_item_property_panel_frame"
        android:background="#ced5dc"
        android:layout_width="match_parent"
        android:layout_height="240dp">
        <DatePicker
            android:layout_gravity="center"
            android:id="@+id/post_item_property_panel_date"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:calendarViewShown="false"/>
        <com.narvii.widget.FontAwesomeRatingBar
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/post_item_property_panel_rating_star"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="300dp"
            android:layout_height="60dp"
            narvii:rating0Color="#aaa"
            narvii:rating0Text="@string/fa_star_o"
            narvii:rating1Color="#f1ad27"
            narvii:rating1Text="@string/fa_star"
            narvii:ratingMax="5"/>
        <com.narvii.widget.FontAwesomeRatingBar
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/post_item_property_panel_rating_heart"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="300dp"
            android:layout_height="60dp"
            narvii:rating0Color="#aaa"
            narvii:rating0Text="@string/fa_heart_o"
            narvii:rating1Color="#e33e45"
            narvii:rating1Text="@string/fa_heart"
            narvii:ratingMax="5"/>
        <com.narvii.widget.FontAwesomeRatingBar
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/post_item_property_panel_rating_cost"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="300dp"
            android:layout_height="60dp"
            narvii:rating0Color="#aaa"
            narvii:rating0Text="@string/fa_dollar"
            narvii:rating1Color="#f0bb0e"
            narvii:rating1Text="@string/fa_dollar"
            narvii:ratingMax="5"/>
    </FrameLayout>
</com.narvii.item.property.ItemPropertyEditPanel>

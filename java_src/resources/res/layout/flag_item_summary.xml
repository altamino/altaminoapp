<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/flag_item_padding_left_right"
    android:paddingTop="@dimen/flag_item_padding_top_bottom"
    android:paddingRight="@dimen/flag_item_padding_left_right"
    android:paddingBottom="@dimen/flag_item_padding_top_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/flag_item_padding_left_right"
    android:paddingEnd="@dimen/flag_item_padding_left_right"
    android:elevation="2dp">
    <TextView
        android:textSize="13dp"
        android:textColor="#fff"
        android:layout_gravity="center_vertical"
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        android:src="@drawable/flag_arraw_up"
        android:layout_marginStart="3dp"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/list_layout"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        <com.narvii.widget.AutoSizingTextView
            android:textColor="@color/notice_appeal"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/appeal"
            android:background="@drawable/button_stroke_2_blue"
            android:layout_width="0pt"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:minHeight="40dp"
            android:text="@string/appeal"
            android:maxLines="1"
            android:layout_weight="1"
            narvii:autoSizeTextMaxSize="16dp"
            narvii:autoSizeTextMinSize="8dp"/>
        <com.narvii.widget.AutoSizingTextView
            android:textColor="#fff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/got_it"
            android:background="@drawable/button_round_blue"
            android:layout_width="0pt"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:minHeight="40dp"
            android:text="@string/got_it"
            android:maxLines="1"
            android:layout_weight="1"
            narvii:autoSizeTextMaxSize="16dp"
            narvii:autoSizeTextMinSize="8dp"/>
    </LinearLayout>
</FrameLayout>

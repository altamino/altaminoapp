<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:id="@+id/on_boarding_overlay"
    android:background="#b2ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/on_boarding_heart"
        android:layout_width="70dp"
        android:layout_height="62dp"
        android:src="@drawable/like_feed_heart"/>
    <com.narvii.widget.SpinningView
        android:layout_gravity="center"
        android:id="@+id/on_boarding_process"
        android:layout_width="60dp"
        android:layout_height="60dp"
        narvii:spinColor="#fd456d"
        narvii:spinSize="60dp"
        narvii:spinStyle="2"/>
</FrameLayout>

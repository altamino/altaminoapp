<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="#0000"
    android:paddingLeft="25dp"
    android:paddingTop="35dp"
    android:paddingRight="25dp"
    android:paddingBottom="35dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="25dp"
    android:paddingEnd="25dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/round_white"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:background="#222"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.narvii.widget.FontAwesomeView
                android:textColor="#fff"
                android:id="@+id/flag_resolve_reason_close"
                android:padding="6dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="4dp"
                android:text="@string/ion_close_round"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="20dp"
                android:textColor="#fff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_reason"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <com.github.mmin18.widget.FlexLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="12dp">
            <com.narvii.widget.ThumbImageView
                android:id="@+id/avatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                style="@style/AvatarImageView"/>
            <com.narvii.widget.NicknameView
                android:id="@+id/nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:hideRole="true"
                app:layout_centerY="25%"
                app:layout_left="avatar.right+10dp"/>
            <TextView
                android:id="@+id/strike_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_centerY="75%"
                app:layout_left="avatar.right+10dp"/>
        </com.github.mmin18.widget.FlexLayout>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:background="#747c82"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/flag_resolve_reason"
            android:paddingStart="12dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="-12dp"
            android:layout_marginStart="-12dp">
            <include layout="@layout/list_layout"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

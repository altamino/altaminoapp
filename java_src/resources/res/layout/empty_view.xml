<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@android:id/empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/empty_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"/>
    <com.narvii.app.theme.view.NVThemeTextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="@color/empty_text_color"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/empty_text"
        android:padding="10dp"
        android:paddingTop="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/_empty"
        app:nv_dark_textColor="@android:color/white"/>
    <com.narvii.widget.FontAwesomeView
        android:textColor="@color/button_text_gray_w"
        android:gravity="center"
        android:id="@+id/empty_retry"
        android:padding="12dp"
        android:clickable="true"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="@string/ion_refresh"/>
</LinearLayout>

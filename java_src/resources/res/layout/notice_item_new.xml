<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="10dp"
    android:paddingTop="7dp"
    android:paddingRight="10dp"
    android:paddingBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp">
    <FrameLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="32dp"
        android:layout_height="38dp">
        <FrameLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="32dp"
            android:layout_height="32dp">
            <include
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/user_avatar_layout_mini"/>
            <com.narvii.widget.NVImageView
                android:id="@+id/icon2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                app:showPressedMask="false"/>
            <com.narvii.widget.CommunityIconView
                android:id="@+id/community_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cornerRadius="2dp"
                app:defaultDrawable="@drawable/placeholder_community"/>
        </FrameLayout>
        <com.narvii.widget.NVImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:scaleType="fitCenter"
            app:showPressedMask="false"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="start"
        android:orientation="vertical"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.narvii.app.theme.view.NVThemeTextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#cc000000"
                android:ellipsize="end"
                android:id="@+id/name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                app:nv_dark_textColor="#ffffff"/>
            <com.narvii.app.theme.view.NVThemeTextView
                android:textSize="10dp"
                android:textColor="#99000000"
                android:id="@+id/datetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                app:nv_dark_textColor="#99ffffff"/>
        </LinearLayout>
        <com.narvii.app.theme.view.NVThemeTextView
            android:textSize="14dp"
            android:textColor="#cc000000"
            android:ellipsize="end"
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            app:nv_dark_textColor="#ffffff"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/text2_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <com.narvii.app.theme.view.NVThemeView
                android:background="#99000000"
                android:layout_width="2dp"
                android:layout_height="13dp"
                app:nv_dark_background="#99ffffff"/>
            <com.narvii.app.theme.view.NVThemeTextView
                android:textSize="12dp"
                android:textColor="#99000000"
                android:ellipsize="end"
                android:id="@+id/text2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:maxLines="1"
                android:layout_marginStart="6dp"
                app:nv_dark_textColor="#99ffffff"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

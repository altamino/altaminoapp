<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/overlay"
    android:background="@android:color/black"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.scene.view.ScenePreviewLayout
        android:id="@+id/preview_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:keepScreenOn="true"
        narvii:auto_play="true"
        narvii:precise_control="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/click_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/to_last_scene"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:id="@+id/to_next_scene"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/poll_quiz_container"
        android:background="#b3000000"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="top"
        android:orientation="vertical"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.narvii.widget.StatusBarPlaceHolder
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.narvii.widgets.StoryProgressBar
            android:id="@+id/story_progress"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/story_progress_bar_height"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
    </LinearLayout>
</RelativeLayout>

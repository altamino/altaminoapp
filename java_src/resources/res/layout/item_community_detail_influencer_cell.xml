<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/community_detail_influencer_cell_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="10dp"
            layout="@layout/user_avatar_layout_large"/>
        <LinearLayout
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="10dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="10dp">
            <com.narvii.widget.NicknameView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:id="@+id/nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:hideInfluencerBadge="false"
                app:hideRankingBadge="true"
                app:hideRole="true"
                app:roleScale="0.6"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ffff"
                android:id="@+id/fan_club_member"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="2"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

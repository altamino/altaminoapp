<?xml version="1.0" encoding="utf-8"?>
<com.narvii.app.theme.view.NVThemeFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/list_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.widget.SpinningView
        android:layout_gravity="center"
        android:id="@android:id/progress"
        android:layout_width="@dimen/spin_large_size"
        android:layout_height="@dimen/spin_large_size"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/list_view_amino"/>
    <FrameLayout
        android:id="@+id/video_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.narvii.app.theme.view.NVThemeFrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/flag_resolve_layout"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@android:drawable/dialog_holo_light_frame"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="-10dp"
        android:layout_marginRight="-10dp"
        android:layout_marginStart="-10dp"
        android:layout_marginEnd="-10dp">
        <com.narvii.flag.widgets.FlagTagsLayout
            android:id="@+id/flag_tags_layout"
            android:paddingLeft="8dp"
            android:paddingTop="6dp"
            android:paddingRight="8dp"
            android:paddingBottom="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
        <FrameLayout
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/flag_action_bar_height"
            android:layout_marginLeft="-10dp"
            android:layout_marginRight="-10dp"
            android:layout_marginBottom="-10dp"
            android:layout_marginStart="-10dp"
            android:layout_marginEnd="-10dp">
            <LinearLayout
                android:id="@+id/flag_action_layout"
                android:layout_width="match_parent"
                android:layout_height="80dp">
                <RelativeLayout
                    android:id="@+id/flag_resolve_action_hide"
                    android:background="@drawable/button_rect_red"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <com.github.mmin18.widget.FlexLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true">
                        <ImageView
                            android:textColor="#fff"
                            android:id="@+id/icon_hide"
                            android:padding="3dp"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_flag_resolve_disable"
                            android:scaleType="centerInside"
                            android:text="@string/ion_close_round"
                            app:layout_centerX="50%"/>
                        <TextView
                            android:textSize="20dp"
                            android:textColor="#fff"
                            android:id="@+id/hide_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/disable"
                            app:layout_top="icon_hide.bottom+4dp"/>
                    </com.github.mmin18.widget.FlexLayout>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/flag_resolve_action_keep"
                    android:background="@drawable/button_rect_green"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <com.github.mmin18.widget.FlexLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true">
                        <ImageView
                            android:textColor="#fff"
                            android:id="@+id/icon_keep"
                            android:padding="3dp"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_flag_resolve_keep"
                            android:scaleType="centerInside"
                            android:text="@string/ion_checkmark_round"
                            app:layout_centerX="50%"/>
                        <TextView
                            android:textSize="20dp"
                            android:textColor="#fff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/keep"
                            app:layout_top="icon_keep.bottom+4dp"/>
                    </com.github.mmin18.widget.FlexLayout>
                </RelativeLayout>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/flag_already_resolved_layout"
                android:background="#2196f3"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">
                    <TextView
                        android:textSize="20dp"
                        android:textStyle="bold"
                        android:textColor="#fff"
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/flag_already_resolved"/>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="#fff"
                        android:layout_gravity="center_horizontal"
                        android:paddingTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/flag_go_to_next"/>
                </LinearLayout>
                <com.narvii.widget.FontAwesomeView
                    android:textColor="#fff"
                    android:padding="4dp"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginRight="10dp"
                    android:text="@string/ion_ios_arrow_right"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

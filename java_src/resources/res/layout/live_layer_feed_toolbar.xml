<?xml version="1.0" encoding="utf-8"?>
<com.narvii.feed.FeedToolbarLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:gravity="start|center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="2dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/feed_toolbar_vote"
        android:paddingLeft="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="45dp"
        android:paddingStart="4dp">
        <com.narvii.widget.VoteIcon
            android:id="@+id/feed_toolbar_vote_icon"
            android:padding="4dp"
            android:duplicateParentState="true"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:elevation="10dp"
            narvii:isDarkTheme="true"/>
        <com.narvii.widget.SpinningView
            android:id="@+id/feed_toolbar_vote_progress"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            narvii:spinSize="@dimen/spin_tiny_size"
            narvii:spinStyle="2"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/feed_toolbar_normal_dark"
            android:id="@+id/feed_toolbar_vote_count"
            android:paddingLeft="2dp"
            android:paddingRight="0dp"
            android:duplicateParentState="true"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingEnd="0dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/feed_toolbar_comment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:minWidth="45dp"
        android:layout_marginStart="6dp">
        <com.narvii.widget.TintButton
            android:id="@+id/feed_toolbar_comment_icon"
            android:background="@drawable/button_round_transparent"
            android:padding="4dp"
            android:duplicateParentState="true"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_comment"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/feed_toolbar_normal_dark"
            android:id="@+id/feed_toolbar_comment_count"
            android:paddingLeft="2dp"
            android:paddingRight="4dp"
            android:duplicateParentState="true"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingEnd="4dp"/>
    </LinearLayout>
</com.narvii.feed.FeedToolbarLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="90dp"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="90dp"
        android:layout_height="122dp">
        <com.narvii.widget.PromotionalImageView
            android:id="@+id/image"
            android:paddingLeft="0dp"
            android:paddingTop="4dp"
            android:paddingRight="2dp"
            android:paddingBottom="4dp"
            android:layout_width="82dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:paddingStart="0dp"
            android:paddingEnd="2dp"
            android:layout_marginStart="4dp"
            narvii:cornerRadius="@dimen/community_card_corner_radius"
            narvii:defaultDrawable="@color/placeholder"
            narvii:imageType="community-launch-image"
            narvii:shadowColor="#0000"
            narvii:shadowOffsetX="1dp"
            narvii:shadowOffsetY="1dp"
            narvii:shadowSize="2dp"
            narvii:strokeColor="#ccc"/>
        <com.narvii.widget.CommunityIconView
            android:layout_gravity="start"
            android:id="@+id/icon"
            android:paddingRight="2dp"
            android:paddingBottom="2dp"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:paddingEnd="2dp"
            narvii:cornerRadius="4.6dp"
            narvii:imageType="community-icon"
            narvii:shadowColor="#0000"
            narvii:shadowOffsetX="1dp"
            narvii:shadowOffsetY="1dp"
            narvii:shadowSize="2dp"
            narvii:strokeColor="#333"
            style="@style/CommunityImageView"/>
        <TextView
            android:textSize="11dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/text"
            android:paddingLeft="6dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:maxLines="3"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"/>
    </FrameLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="4dp"
    android:paddingRight="4dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="92dp"
    android:layout_height="@dimen/item_card_height"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">
    <com.narvii.widget.ThumbImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cornerRadius="8dp"
        app:defaultDrawable="@color/white"
        app:strokeColor="@color/item_card_stroke"
        app:strokeWidth="@dimen/item_card_stroke_width"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/layout"
        android:paddingTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.narvii.widget.TintButton
            android:id="@+id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_wiki_gallery_more"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#9b9b9b"
            android:gravity="center"
            android:id="@+id/name"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/see_all"
            android:maxLines="2"/>
    </LinearLayout>
</FrameLayout>

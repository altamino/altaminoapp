<?xml version="1.0" encoding="utf-8"?>
<com.narvii.widget.WalletBalanceView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wallet_balance_view"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:layout_width="wrap_content"
    android:layout_height="48dp">
    <com.narvii.widget.PressedFrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/store_header_coin_info_layout"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/selector_wallet_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="@dimen/wallet_balance_inside_margin_top"
                android:layout_marginBottom="@dimen/wallet_balance_inside_margin_bottom"
                android:src="@drawable/amino_coin_big"
                android:layout_marginStart="5dp"/>
            <com.narvii.widget.AutoSizingTextView
                android:textSize="13dp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/wallet_balance"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:minWidth="20dp"
                android:maxLines="1"
                app:autoSizeTextMaxSize="13dp"
                app:autoSizeTextMinSize="8dp"/>
            <com.narvii.widget.TintButton
                android:background="@drawable/selector_wallet_plus_icon_bg"
                android:padding="7dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp"
                android:src="@drawable/wallet_ic_add"
                android:layout_marginStart="5dp"
                app:tintColor="#80ffffff"/>
        </LinearLayout>
    </com.narvii.widget.PressedFrameLayout>
    <com.narvii.monetization.utils.ClaimGiftHintLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/claim_gift_hint"
        android:background="@drawable/selector_wallet_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:isSmall="true"/>
</com.narvii.widget.WalletBalanceView>

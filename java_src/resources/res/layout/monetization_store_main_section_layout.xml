<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#fff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/store_section_title_layout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp">
        <com.narvii.widget.NVImageView
            android:id="@+id/store_section_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#333334"
            android:id="@+id/store_section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            android:textAlignment="viewStart"/>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="10dp"
            android:layout_marginEnd="10dp">
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/chevron_right_mirror"/>
        </FrameLayout>
    </LinearLayout>
    <GridLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/item_grid_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:useDefaultMargins="false"/>
    <Button
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="#ff7800"
        android:layout_gravity="center_horizontal"
        android:id="@+id/store_section_see_all_button"
        android:background="@drawable/button_round_orange_stroke"
        android:paddingLeft="50dp"
        android:paddingRight="50dp"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:minWidth="180dp"
        android:text="@string/see_all"
        android:textAlignment="center"/>
    <include layout="@layout/monetization_store_stiker_pack_entry"/>
    <View
        android:background="#f6f7f9"
        android:layout_width="match_parent"
        android:layout_height="10dp"/>
</LinearLayout>

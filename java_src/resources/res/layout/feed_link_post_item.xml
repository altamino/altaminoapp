<?xml version="1.0" encoding="utf-8"?>
<com.narvii.feed.FeedListItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:tag="blog"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/user_head"
        layout="@layout/feed_user_header"/>
    <com.narvii.widget.TintButton
        android:id="@+id/icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="6dp"
        android:layout_below="@+id/user_head"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="10dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="#333"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="10dp"
        android:singleLine="true"
        android:layout_toRightOf="@+id/icon"
        android:layout_below="@+id/user_head"
        android:layout_alignParentRight="true"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="10dp"
        android:layout_toEndOf="@+id/icon"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#555"
        android:ellipsize="end"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_below="@+id/title"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
    <include
        android:id="@+id/feed_images"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="10dp"
        android:layout_below="@+id/content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        layout="@layout/feed_image3_secret"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/snippet_site_layout"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="10dp"
        android:layout_below="@+id/feed_images"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">
        <com.narvii.widget.ThumbImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/snippet_favicon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"
            app:defaultDrawable="@drawable/favicon_default_s"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#aaa"
            android:layout_gravity="center_vertical"
            android:id="@+id/snippet_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:textAllCaps="true"/>
    </LinearLayout>
    <include
        android:id="@+id/feed_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/feed_toolbar_height"
        android:layout_marginTop="2dp"
        android:layout_below="@+id/snippet_site_layout"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        layout="@layout/feed_toolbar"/>
    <include layout="@layout/fans_only_content_indicator_layout"/>
</com.narvii.feed.FeedListItem>

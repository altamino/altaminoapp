<?xml version="1.0" encoding="utf-8"?>
<com.narvii.widget.NVScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:background="@color/post_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:background="@drawable/chat_cover_bg"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_margin="14dp">
            <com.narvii.widget.ThumbImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                narvii:imageType="chat-cover"/>
            <TextView
                android:textSize="26dp"
                android:textColor="#f2f2f2"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/post_thread_cover"
                android:shadowColor="#0000"
                android:shadowDy="2"
                android:shadowRadius="6"/>
        </FrameLayout>
        <EditText
            android:textSize="16dp"
            android:textColor="#222"
            android:gravity="start|center_vertical"
            android:id="@+id/title"
            android:background="@drawable/post_clickable_section"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:hint="@string/post_title"
            android:singleLine="true"
            android:inputType="textCapSentences"/>
        <com.narvii.widget.EditTextIMG
            android:textSize="16dp"
            android:textColor="#222"
            android:gravity="start|top"
            android:id="@+id/content"
            android:background="@drawable/post_clickable_section"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:hint="@string/welcome_message_hint"
            android:minLines="12"
            android:maxLength="65535"
            android:inputType="textMultiLine"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="60dp"/>
    </LinearLayout>
</com.narvii.widget.NVScrollView>

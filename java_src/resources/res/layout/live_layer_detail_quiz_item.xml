<?xml version="1.0" encoding="utf-8"?>
<com.narvii.livelayer.detailview.LiveLayerDetailListItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="10dp"
    android:paddingTop="5dp"
    android:paddingRight="10dp"
    android:paddingBottom="5dp"
    android:layout_width="match_parent"
    android:layout_height="146dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <com.narvii.widget.SecretImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        narvii:cornerRadius="5dp"
        narvii:defaultDrawable="@drawable/live_layer_detail_item_placeholder"
        narvii:hidePlayButton="true"/>
    <TextView
        android:textSize="22dp"
        android:textStyle="bold"
        android:textColor="#f2f2f2"
        android:gravity="start"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="60dp"
        android:maxLines="2"
        android:shadowColor="#0000"
        android:shadowDy="3"
        android:shadowRadius="8"
        android:textAlignment="viewStart"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="60dp"/>
    <include layout="@layout/fans_only_content_indicator_layout_live_chat"/>
    <com.narvii.widget.FullHitFrameLayout
        android:id="@+id/start_quiz_layout"
        android:paddingLeft="10dp"
        android:paddingTop="20dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/start_quiz"
            android:background="@drawable/quiz_play_btn"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:minWidth="100dp">
            <com.narvii.widget.FontAwesomeView
                android:textColor="#fff"
                android:id="@+id/start_quiz_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginRight="4dp"
                android:text="@string/fa_play"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#fff"
                android:id="@+id/start_quiz_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start_quiz"
                android:singleLine="true"/>
            <com.narvii.widget.SpinningView
                android:id="@+id/start_quiz_loading"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp"
                narvii:spinColor="#ffffff"
                narvii:spinSize="15dp"
                narvii:spinStyle="2"/>
        </LinearLayout>
    </com.narvii.widget.FullHitFrameLayout>
    <include layout="@layout/live_layer_detail_item_bar"/>
</com.narvii.livelayer.detailview.LiveLayerDetailListItemView>

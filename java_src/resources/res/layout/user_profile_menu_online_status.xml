<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="horizontal"
    android:id="@+id/menu_online_status"
    android:background="@drawable/online_status_btn"
    android:paddingLeft="6dp"
    android:paddingRight="6dp"
    android:duplicateParentState="true"
    android:layout_width="wrap_content"
    android:layout_height="24dp"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">
    <View
        android:id="@+id/online_status_oval"
        android:background="@drawable/online_status_oval"
        android:layout_width="7dp"
        android:layout_height="7dp"/>
    <TextView
        android:textColor="#fff"
        android:id="@+id/online_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:text="@string/online_status_online"
        android:shadowColor="@color/shadow"
        android:shadowDy="1"
        android:shadowRadius="5"
        android:layout_marginStart="4dp"/>
</LinearLayout>

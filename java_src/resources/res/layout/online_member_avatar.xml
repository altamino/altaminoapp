<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.narvii.widget.UserAvatarLayout
        android:id="@+id/user_avatar_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/avatar_frame_size_threshold"
        android:layout_height="@dimen/avatar_frame_size_threshold"
        narvii:avatarShadowOffsetY="1dp"
        narvii:disableFullAvatarFrame="true"
        narvii:noBadge="true"
        narvii:sizeType="mini"/>
    <com.narvii.widget.NVImageView
        android:layout_gravity="center"
        android:id="@+id/overlay"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="#40000000"
        android:scaleType="centerInside"
        narvii:cornerRadius="1000dp"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/more"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_more_online_bar"
        android:scaleType="centerInside"/>
</FrameLayout>

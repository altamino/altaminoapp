<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.github.mmin18.widget.FlexLayout
            android:background="@color/post_background"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="160dp">
            <include
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_margin="4dp"
                narvii:layout_centerX="50%"
                narvii:layout_centerY="50%-10dp"
                layout="@layout/user_avatar_layout_mini"/>
            <com.narvii.widget.SpinningView
                android:id="@+id/avatar_frame_loading"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                narvii:layout_centerX="user_avatar_layout.centerY"
                narvii:layout_centerY="user_avatar_layout.centerX"
                narvii:spinColor="#fff"
                narvii:spinSize="@dimen/spin_tiny_size"
                narvii:spinStyle="2"/>
            <ImageView
                android:id="@+id/avatar_frame_error"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_sticker_pack_not_available"
                android:scaleType="fitCenter"
                narvii:layout_centerX="user_avatar_layout.centerY"
                narvii:layout_centerY="user_avatar_layout.centerX"/>
            <com.narvii.widget.MoodView
                android:id="@+id/mood"
                android:layout_width="60dp"
                android:layout_height="48dp"
                narvii:layout_left="user_avatar_layout.left+user_avatar_layout.width*0.58"
                narvii:layout_top="user_avatar_layout.top-user_avatar_layout.height*0.08"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#4a90e2"
                android:id="@+id/post_add_avatar_frame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_profile_frame"
                narvii:layout_centerX="50%"
                narvii:layout_top="user_avatar_layout.bottom+15dp"/>
        </com.github.mmin18.widget.FlexLayout>
        <com.narvii.widget.NVScrollView
            android:background="@color/post_background"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/post_clickable_section"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp">
                    <ImageView
                        android:gravity="center"
                        android:background="@drawable/button_round_transparent"
                        android:padding="4dp"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="8dp"
                        android:src="@drawable/ic_user"
                        android:scaleType="centerInside"
                        android:layout_marginStart="8dp"/>
                    <EditText
                        android:textSize="16dp"
                        android:textColor="#222"
                        android:gravity="center"
                        android:id="@+id/nickname"
                        android:background="@drawable/post_clickable_section"
                        android:padding="10dp"
                        android:layout_width="0px"
                        android:layout_height="match_parent"
                        android:layout_marginRight="40dp"
                        android:hint="@string/post_your_name"
                        android:minLines="1"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:layout_marginEnd="40dp"/>
                </LinearLayout>
                <com.narvii.widget.BackgroundPickerView
                    android:gravity="center_vertical"
                    android:id="@+id/background_picker"
                    android:background="@drawable/post_clickable_section"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="32dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/post_add_photo"
                    android:background="@drawable/post_clickable_section"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp">
                    <ImageView
                        android:gravity="center"
                        android:background="@drawable/button_round_transparent"
                        android:padding="4dp"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="8dp"
                        android:src="@drawable/ic_camera"
                        android:scaleType="centerInside"
                        android:layout_marginStart="8dp"/>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="#444"
                        android:gravity="center"
                        android:layout_width="0px"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="36dp"
                        android:text="@string/post_add_gallery"
                        android:layout_weight="1"
                        android:layout_marginEnd="36dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/post_edit_photo"
                    android:background="@drawable/post_clickable_section"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="32dp">
                    <ImageView
                        android:gravity="center"
                        android:background="@drawable/button_round_transparent"
                        android:padding="4dp"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="8dp"
                        android:src="@drawable/ic_camera_blue"
                        android:scaleType="centerInside"
                        android:layout_marginStart="8dp"/>
                    <View
                        android:layout_width="0px"
                        android:layout_height="0px"
                        android:layout_weight="1"/>
                    <com.narvii.widget.ThumbImageView
                        android:id="@+id/image_1"
                        android:tag="@string/image_tag"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        narvii:strokeColor="#444"
                        narvii:strokeWidth="0.5dp"/>
                    <View
                        android:layout_width="0px"
                        android:layout_height="0px"
                        android:layout_weight="1"/>
                    <com.narvii.widget.ThumbImageView
                        android:id="@+id/image_2"
                        android:tag="@string/image_tag"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        narvii:strokeColor="#444"
                        narvii:strokeWidth="0.5dp"/>
                    <View
                        android:layout_width="0px"
                        android:layout_height="0px"
                        android:layout_weight="1"/>
                    <com.narvii.widget.ThumbImageView
                        android:id="@+id/image_3"
                        android:tag="@string/image_tag"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        narvii:strokeColor="#444"
                        narvii:strokeWidth="0.5dp"/>
                    <View
                        android:layout_width="0px"
                        android:layout_height="0px"
                        android:layout_weight="1"/>
                    <com.narvii.widget.ThumbImageView
                        android:id="@+id/image_4"
                        android:tag="@string/image_tag"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        narvii:strokeColor="#444"
                        narvii:strokeWidth="0.5dp"/>
                    <View
                        android:layout_width="0px"
                        android:layout_height="0px"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="#444"
                        android:ellipsize="end"
                        android:id="@+id/hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="4dp"
                        android:singleLine="true"
                        android:layout_marginEnd="4dp"/>
                    <com.narvii.app.theme.view.NVThemeTintButton
                        android:gravity="center"
                        android:layout_width="10dp"
                        android:layout_height="15dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:src="@drawable/chevron_right_mirror"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        narvii:nv_dark_tintColor="@color/dark_theme_chevron_right"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/post_add_location"
                    android:background="@drawable/post_clickable_section"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="32dp">
                    <ImageView
                        android:gravity="center"
                        android:background="@drawable/button_round_transparent"
                        android:padding="4dp"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="8dp"
                        android:src="@drawable/ic_location"
                        android:scaleType="centerInside"
                        android:layout_marginStart="8dp"/>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="#444"
                        android:gravity="center"
                        android:layout_width="0px"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="36dp"
                        android:text="@string/post_add_location"
                        android:layout_weight="1"
                        android:layout_marginEnd="36dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/post_locating"
                    android:background="@drawable/post_clickable_section"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="32dp">
                    <com.narvii.widget.SpinningView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="8dp"
                        android:layout_marginStart="8dp"
                        narvii:spinColor="@color/post_inactive_bg"
                        narvii:spinSize="@dimen/spin_tiny_size"
                        narvii:spinStyle="2"/>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="#444"
                        android:gravity="center"
                        android:layout_width="0px"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="36dp"
                        android:text="@string/post_locating"
                        android:layout_weight="1"
                        android:layout_marginEnd="36dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/post_edit_location"
                    android:background="@drawable/post_clickable_section"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="32dp">
                    <ImageView
                        android:gravity="center"
                        android:background="@drawable/button_round_transparent"
                        android:padding="4dp"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="8dp"
                        android:src="@drawable/ic_location_blue"
                        android:scaleType="centerInside"
                        android:layout_marginStart="8dp"/>
                    <com.narvii.widget.AddressView
                        android:textSize="16dp"
                        android:textColor="#444"
                        android:gravity="center"
                        android:id="@+id/address"
                        android:layout_width="0px"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="36dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="18dp"
                    android:textColor="#666"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="32dp"
                    android:text="@string/bio"
                    android:layout_marginStart="10dp"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <com.narvii.widget.EditTextIMG
                        android:textSize="16dp"
                        android:textColor="#222"
                        android:gravity="start|top"
                        android:id="@+id/content"
                        android:background="@drawable/post_clickable_section"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/post_short_bio_hint"
                        android:minLines="12"
                        android:maxLength="65535"
                        android:inputType="textMultiLine"/>
                    <include
                        android:id="@+id/post_embed_image_hint"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        layout="@layout/post_embed_image_hint"/>
                </FrameLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/user_title_layout"
                    android:background="@drawable/post_clickable_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="48dp">
                        <ImageView
                            android:gravity="center"
                            android:id="@+id/manage_title_icon"
                            android:padding="4dp"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginLeft="8dp"
                            android:src="@drawable/ic_user_manage_title"
                            android:scaleType="centerInside"
                            android:layout_marginStart="8dp"/>
                        <TextView
                            android:textSize="16dp"
                            android:textColor="#444"
                            android:gravity="center"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            android:layout_width="0px"
                            android:layout_height="wrap_content"
                            android:text="@string/manage_titles"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="16dp"
                            android:textColor="#ccd6dd"
                            android:id="@+id/titles_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <com.narvii.app.theme.view.NVThemeTintButton
                            android:gravity="center"
                            android:layout_width="10dp"
                            android:layout_height="15dp"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            android:src="@drawable/chevron_right_mirror"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            narvii:nv_dark_tintColor="@color/dark_theme_chevron_right"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/post_options"
                    android:background="@drawable/post_clickable_section"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="32dp">
                    <ImageView
                        android:gravity="center"
                        android:background="@drawable/button_round_transparent"
                        android:padding="4dp"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="8dp"
                        android:src="@drawable/ic_item_setting_blue"
                        android:scaleType="centerInside"
                        android:layout_marginStart="8dp"/>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="#444"
                        android:gravity="center"
                        android:layout_width="0px"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="36dp"
                        android:text="@string/post_options"
                        android:layout_weight="1"
                        android:layout_marginEnd="36dp"/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="60dp"/>
            </LinearLayout>
        </com.narvii.widget.NVScrollView>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/avatar_picker_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>

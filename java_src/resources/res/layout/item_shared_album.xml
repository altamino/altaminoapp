<?xml version="1.0" encoding="utf-8"?>
<com.narvii.sharedfolder.SharedAlbumView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.github.mmin18.widget.FlexLayout
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.narvii.widget.ThumbImageView
            android:id="@+id/cover"
            android:layout_width="match_parent"
            app:cornerRadius="@dimen/shared_album_radius"
            app:defaultDrawable="@color/album_cover_placeholder"
            app:hidePlayButton="true"
            app:imageType="shared-folder-image"
            app:layout_height="this.width"/>
        <View
            android:id="@+id/gradient"
            android:background="@drawable/shared_album_gradient"
            app:layout_height="cover.height"
            app:layout_width="cover.width"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#fff"
            android:layout_gravity="start"
            android:id="@+id/photo_count"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="8dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:shadowColor="#0000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="3"
            android:textAlignment="viewStart"
            app:layout_bottom="cover.bottom"
            app:layout_width="cover.width"/>
        <ImageView
            android:id="@+id/vote_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_shared_album_vote"
            app:layout_left="8dp"
            app:layout_top="8dp"/>
        <ImageView
            android:id="@+id/locked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_shared_album_item_locked"
            app:layout_right="100%-8dp"
            app:layout_top="8dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#fff"
            android:id="@+id/vote_count"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:shadowColor="#0000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="3"
            app:layout_centerY="vote_icon.centerY-1dp"
            app:layout_left="vote_icon.right"/>
        <TextView
            android:textSize="22dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:ellipsize="end"
            android:gravity="bottom"
            android:layout_gravity="start"
            android:id="@+id/title"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:shadowColor="#0000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="3"
            android:textAlignment="viewStart"
            app:layout_bottom="photo_count.top"
            app:layout_top="vote_icon.bottom+6dp"
            app:layout_width="cover.width"/>
    </com.github.mmin18.widget.FlexLayout>
</com.narvii.sharedfolder.SharedAlbumView>

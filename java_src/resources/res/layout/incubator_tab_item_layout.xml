<?xml version="1.0" encoding="utf-8"?>
<com.narvii.master.widget.MasterBottomItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/tab_icon_selected"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/tab_icon_tmp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/tab_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
        <View
            android:layout_gravity="end|top"
            android:id="@+id/badge"
            android:background="@drawable/drawer_badge_o"
            android:visibility="gone"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="3dp"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"/>
    </FrameLayout>
    <TextView
        android:textSize="10dp"
        android:textColor="#999999"
        android:gravity="top|center_horizontal"
        android:id="@+id/tab_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:singleLine="true"/>
</com.narvii.master.widget.MasterBottomItemView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="70dp">
    <ImageView
        android:id="@+id/screenroom_playlist_status"
        android:layout_width="15dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"/>
    <FrameLayout
        android:layout_width="70dp"
        android:layout_height="50dp">
        <com.narvii.widget.NVImageView
            android:id="@+id/screenroom_playlist_thumbnail"
            android:background="#d0cfd0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cornerRadius="2dp"
            app:defaultDrawable="@drawable/ic_playlist_cover_placeholder"
            app:hidePlayButton="true"
            app:loadingDrawable="@drawable/ic_playlist_cover_placeholder"/>
        <com.narvii.widget.NVImageView
            android:id="@+id/screenroom_playlist_thumbnail_overlay"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="#1a000000"
            app:cornerRadius="2dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffff"
            android:layout_gravity="end|bottom"
            android:id="@+id/screenroom_playlist_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="4dp"
            android:text="12:11"
            android:shadowColor="#000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:layout_marginEnd="4dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_weight="1"
        android:layout_marginStart="10dp">
        <TextView
            android:textSize="14dp"
            android:textColor="#4a4a4a"
            android:ellipsize="end"
            android:id="@+id/screenroom_playlist_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <ImageView
                android:id="@+id/screenroom_playlist_source_icon"
                android:layout_width="wrap_content"
                android:layout_height="12dp"
                android:src="@drawable/ic_playlist_youtube"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#939393"
                android:ellipsize="end"
                android:id="@+id/screenroom_playlist_source_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:maxLines="1"
                android:layout_marginStart="5dp"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/drag_handle"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_width="50dp"
        android:layout_height="match_parent"
        android:src="@drawable/ic_screenroom_playlist_drag"
        android:scaleType="centerInside"/>
</LinearLayout>

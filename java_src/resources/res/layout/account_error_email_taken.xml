<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="18dp"
        android:textColor="#000"
        android:gravity="center"
        android:id="@+id/title"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:background="#c8c7cc"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="-10dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="-10dp"
        android:layout_marginBottom="3dp"
        android:layout_marginStart="-10dp"
        android:layout_marginEnd="-10dp"/>
    <TextView
        android:textSize="17dp"
        android:textColor="#007aff"
        android:gravity="center"
        android:id="@+id/login_with_email"
        android:background="@drawable/button_rect_transparent_0x2000"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/account_login_with_email"/>
    <View
        android:background="#c8c7cc"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="-10dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="-10dp"
        android:layout_marginBottom="3dp"
        android:layout_marginStart="-10dp"
        android:layout_marginEnd="-10dp"/>
    <TextView
        android:textSize="17dp"
        android:textColor="#007aff"
        android:gravity="center"
        android:id="@+id/create_acount"
        android:background="@drawable/button_rect_transparent_0x2000"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/account_create_new_account"/>
    <View
        android:background="#c8c7cc"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="-10dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="-10dp"
        android:layout_marginBottom="3dp"
        android:layout_marginStart="-10dp"
        android:layout_marginEnd="-10dp"/>
    <TextView
        android:textSize="17dp"
        android:textColor="#007aff"
        android:gravity="center"
        android:id="@+id/cancel"
        android:background="@drawable/button_rect_transparent_0x2000"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel"/>
</LinearLayout>

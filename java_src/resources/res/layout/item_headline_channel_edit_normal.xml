<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#fff"
    android:paddingLeft="@dimen/headline_default_padding_horizontal"
    android:paddingRight="@dimen/headline_default_padding_horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/headline_default_padding_horizontal"
    android:paddingEnd="@dimen/headline_default_padding_horizontal">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.narvii.widget.NVImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/icon"
            android:layout_width="15dp"
            android:layout_height="20dp"
            android:layout_marginRight="8dp"
            android:scaleType="centerInside"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/title"
            android:paddingRight="10dp"
            android:layout_width="0pt"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"
            android:textAllCaps="true"
            android:paddingEnd="10dp"/>
        <CheckBox
            android:layout_gravity="end|center_vertical"
            android:id="@+id/actived"
            android:layout_width="52dp"
            android:layout_height="30dp"
            android:layout_marginRight="8dp"
            android:checked="false"
            android:button="@drawable/switch_bg"
            android:layout_marginEnd="8dp"/>
        <include
            android:layout_gravity="end|center_vertical"
            android:id="@+id/drag_handle"
            android:layout_width="40dp"
            android:layout_height="30dp"
            layout="@layout/drag_sort_drag_handle"/>
    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_divider_height"
        layout="@layout/list_divider"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.narvii.feed.quizzes.HeaderLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="@dimen/quizzes_header_overlay_header_with_section_height">
    <com.narvii.widget.NVTabLayout
        android:id="@+id/overlay_tab_layout"
        android:background="#fff"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/quizzes_header_tab_height"
        android:layout_alignParentBottom="true"
        app:indicator_color="#05c6f7"
        app:indicator_height="2dp"
        app:tab_mode="1"/>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/overlay_info_layout"
        android:tag="fade"
        android:background="#05c6f7"
        android:paddingLeft="40dp"
        android:paddingTop="10dp"
        android:paddingRight="30dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/quizzes_header_overlay_header"
        android:layout_above="@+id/overlay_tab_layout"
        android:paddingStart="40dp"
        android:paddingEnd="30dp">
        <ImageView
            android:id="@+id/info_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:src="@drawable/ic_start_best_quizzes"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/info_title_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/info_icon"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/info_icon">
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:ellipsize="end"
                android:id="@+id/info_title"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/best_quizzes"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#fff"
                android:ellipsize="end"
                android:id="@+id/info_hint"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/best_quizzes_info"
                android:maxLines="2"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"/>
        </LinearLayout>
    </RelativeLayout>
</com.narvii.feed.quizzes.HeaderLayout>

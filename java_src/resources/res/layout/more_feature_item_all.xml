<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/more_featured_item_width_s"
    android:layout_height="@dimen/more_featured_item_height_s">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="5dp"
        app:cardCornerRadius="3dp"
        app:cardElevation="2.5dp"
        app:cardMaxElevation="4dp">
        <com.narvii.feed.featured.FeaturedMoreItemsLayout
            android:orientation="vertical"
            android:id="@+id/more_items"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:maskShape="1"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#000"
            android:gravity="center"
            android:layout_gravity="center"
            android:background="#ffff"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/more_dot"/>
    </androidx.cardview.widget.CardView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.narvii.topic.widgets.TopicCardCoverView
            android:id="@+id/img_container"
            android:layout_width="45dp"
            android:layout_height="50dp"
            android:layout_marginBottom="6dp"/>
        <ImageView
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/bookmark_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_topic_indicator_bookmark_green"/>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginStart="10dp">
        <LinearLayout
            android:gravity="top"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.narvii.widget.TintButton
                android:id="@+id/indicator_2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="4dp"
                android:src="@drawable/ic_topic_tag"
                android:scaleType="fitCenter"/>
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:ellipsize="end"
                android:gravity="top"
                android:layout_gravity="top"
                android:id="@+id/topic_title"
                android:layout_width="0pt"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:maxLines="2"
                android:layout_weight="1"
                android:layout_marginStart="4dp"/>
            <com.narvii.widget.TintButton
                android:id="@+id/right_chevron"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/chevron_right_mirror"
                app:tintColor="#ffff"/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="#d0d0d0e8"
            android:id="@+id/detail_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
</LinearLayout>

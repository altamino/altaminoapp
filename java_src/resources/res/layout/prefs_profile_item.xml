<?xml version="1.0" encoding="utf-8"?>
<com.narvii.app.theme.view.NVThemeLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/prefs_default_size"
    app:nv_dark_background="#1affffff">
    <com.narvii.app.theme.view.NVThemeTextView
        android:textSize="17dp"
        android:textColor="#4a4a4a"
        android:ellipsize="end"
        android:gravity="start"
        android:layout_gravity="start|center_vertical"
        android:layout_width="0pt"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/prefs_left_margin"
        android:text="@string/my_profile"
        android:maxLines="1"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/prefs_left_margin"
        app:nv_dark_textColor="@color/prefs_text_color_dark"/>
    <com.narvii.widget.NVImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/avatar"
        android:padding="1dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginLeft="6dp"
        android:layout_marginStart="6dp"
        style="@style/AvatarImageView"/>
    <com.narvii.app.theme.view.NVThemeTintButton
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/chevron_right"
        android:layout_width="10dp"
        android:layout_height="15dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:src="@drawable/chevron_right_mirror"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:nv_dark_tintColor="@color/dark_theme_chevron_right"/>
</com.narvii.app.theme.view.NVThemeLinearLayout>

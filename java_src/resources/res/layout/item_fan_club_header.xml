<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="22dp"
    android:paddingBottom="22dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/fan_club_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_fan_club_logo"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#4a4a4a"
        android:gravity="center"
        android:id="@+id/title"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#666666"
        android:id="@+id/fans_since"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#d10012"
        android:id="@+id/expiring"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"/>
    <com.narvii.widget.SameChildWidthLinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16dp"
            android:textColor="#4a4a4a"
            android:gravity="center"
            android:id="@+id/check_detail"
            android:background="@drawable/fan_subscription_check_detail_bg"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:minHeight="34dp"
            android:text="@string/check_the_detail"
            android:singleLine="true"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/renew"
            android:background="@drawable/selector_become_fans"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:minHeight="34dp"
            android:text="@string/renew"
            android:singleLine="true"/>
    </com.narvii.widget.SameChildWidthLinearLayout>
</LinearLayout>

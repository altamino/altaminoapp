<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#3a3b41"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/top_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1">
        <com.github.mmin18.widget.FlexLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="13dp"
            android:layout_marginRight="40dp"
            android:layout_marginBottom="5dp"
            android:layout_above="@+id/hint"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="40dp">
            <com.meicam.sdk.NvsLiveWindow
                android:id="@+id/liveWindow"
                android:visibility="visible"
                android:layout_height="match_parent"
                app:layout_centerX="50%"
                app:layout_centerY="50%"
                app:layout_width="this.height*0.5625"/>
            <com.narvii.widget.EasyButton
                android:layout_gravity="end|bottom"
                android:id="@+id/restore"
                android:focusable="true"
                android:visibility="visible"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_cropping_restore"
                app:layout_bottom="liveWindow.bottom-10dp"
                app:layout_right="liveWindow.right-10dp"/>
            <com.narvii.widget.EasyButton
                android:id="@+id/play"
                android:padding="8dp"
                android:focusable="true"
                android:visibility="visible"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_sr_media_play"
                app:layout_centerX="50%"
                app:layout_centerY="50%"/>
        </com.github.mmin18.widget.FlexLayout>
        <TextView
            android:textSize="11dp"
            android:textColor="#ffffff"
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/pinch_to_zoom_in_out"
            android:layout_above="@+id/seekbar"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#88ffffff"
            android:id="@+id/time_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="10dp"
            android:text="0:00.0"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="10dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#88ffffff"
            android:id="@+id/total_time_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:text="0:00.0"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true"/>
        <SeekBar
            android:id="@+id/seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="10dp"
            android:thumb="@drawable/dynamic_cropping_seekbar_thumb"
            android:layout_toLeftOf="@+id/total_time_view"
            android:layout_toRightOf="@+id/time_view"
            android:layout_alignParentBottom="true"
            android:layout_toStartOf="@+id/total_time_view"
            android:layout_toEndOf="@+id/time_view"
            android:thumbTint="@color/white"
            style="@style/DynamicCroppingSeekbarStyle"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/bottom_view"
        android:background="#cc2a2a2a"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.narvii.widget.EasyButton
            android:id="@+id/close"
            android:padding="10dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:src="@drawable/dynamic_cropping_close"
            android:layout_marginStart="6dp"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/crop"
            android:layout_centerHorizontal="true"/>
        <com.narvii.widget.EasyButton
            android:id="@+id/check"
            android:padding="10dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/dynamic_cropping_check"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="6dp"
            android:layout_alignParentEnd="true"/>
        <com.narvii.widget.EasyButton
            android:id="@+id/dynamic_cropping"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="53dp"
            android:layout_marginTop="74dp"
            android:src="@drawable/ic_dynamic_cropping"
            android:layout_marginStart="53dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffff"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="39dp"
            android:layout_marginTop="10dp"
            android:text="@string/dynamic_cropping"
            android:layout_below="@+id/dynamic_cropping"
            android:textAlignment="center"
            android:layout_marginStart="39dp"/>
        <com.narvii.widget.EasyButton
            android:id="@+id/rotate"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="72dp"
            android:layout_marginRight="63dp"
            android:src="@drawable/ic_dynamic_rotate"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="63dp"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffff"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginRight="38dp"
            android:text="@string/rotate"
            android:layout_below="@+id/rotate"
            android:layout_alignParentRight="true"
            android:textAlignment="center"
            android:layout_marginEnd="38dp"
            android:layout_alignParentEnd="true"/>
        <com.narvii.editor.cropping.basic.ColorPickerItemView
            android:id="@+id/change_background_color"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:layout_marginTop="72dp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffff"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/background_color"
            android:layout_below="@+id/change_background_color"
            android:layout_centerHorizontal="true"
            android:textAlignment="center"/>
    </RelativeLayout>
</LinearLayout>

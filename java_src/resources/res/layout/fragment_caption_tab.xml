<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@color/attachment_tab_bg"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <ImageView
                android:layout_gravity="start"
                android:id="@+id/close"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_white_cross"
                android:scaleType="centerInside"/>
            <ImageView
                android:layout_gravity="end"
                android:id="@+id/submit"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_white_check"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <com.narvii.widget.NVViewPager
            android:id="@+id/viewpager"
            android:background="@color/attachment_tab_bg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:background="#35353b"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/caption_tab_keyboard"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                layout="@layout/caption_tab_item"/>
            <com.narvii.widget.NVPagerTabLayout
                android:id="@+id/tabs"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_weight="3"
                app:indicator_color="#36d4b1"
                app:indicator_v_offset="4dp"
                app:tab_mode="1"
                app:tab_padding="0dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

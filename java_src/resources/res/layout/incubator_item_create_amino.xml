<?xml version="1.0" encoding="utf-8"?>
<com.github.mmin18.widget.FlexLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/create_amino"
        android:background="@drawable/selector_create_aminos"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_height="wrap_content"
        android:minHeight="45dp"
        app:layout_centerX="50%"
        app:layout_centerY="50%"
        app:layout_width="80%">
        <com.narvii.widget.TintButton
            android:layout_gravity="center_vertical"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_create_amino"
            android:scaleType="centerInside"
            app:tintColor="#00fcca"/>
        <com.narvii.widget.AutoSizingTextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/selector_text_create_amino_green"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/create_your_own"
            android:maxLines="1"
            android:layout_marginStart="6dp"
            app:autoSizeTextMaxSize="14dp"
            app:autoSizeTextMinSize="8dp"/>
    </LinearLayout>
</com.github.mmin18.widget.FlexLayout>

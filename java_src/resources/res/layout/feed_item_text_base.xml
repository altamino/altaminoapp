<?xml version="1.0" encoding="utf-8"?>
<com.narvii.feed.PopularFeedListItem xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/feed_item_base"
    android:background="#fff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/feed_toolbar"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="@dimen/feature_feed_tool_bar_margin_bottom"
            android:layout_marginBottom="@dimen/feature_feed_tool_bar_margin_bottom"
            android:layout_alignParentBottom="true"
            layout="@layout/feed_popular_toolbar_dark_theme"/>
        <LinearLayout
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/feed_toolbar"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">
            <TextView
                android:textSize="@dimen/feature_middle_feed_title_size"
                android:textColor="#fff"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="6"
                android:lineSpacingMultiplier="0.9"/>
        </LinearLayout>
        <TextView
            android:textSize="11dp"
            android:textColor="#fff"
            android:id="@+id/corner_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"/>
        <include layout="@layout/fans_only_content_indicator_layout"/>
    </RelativeLayout>
</com.narvii.feed.PopularFeedListItem>

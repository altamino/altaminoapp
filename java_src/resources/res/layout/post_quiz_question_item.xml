<?xml version="1.0" encoding="utf-8"?>
<com.narvii.widget.SwipeToDeleteLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/post_quiz_question"
    android:layout_width="match_parent"
    android:layout_height="50dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingRight="4dp"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:paddingEnd="4dp">
        <com.narvii.widget.AutoSizingTextView
            android:textSize="20dp"
            android:textColor="#bfbfbf"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/post_quiz_question_no"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:autoSizeTextMaxSize="20dp"/>
        <RelativeLayout
            android:id="@+id/post_quiz_question_click"
            android:background="@drawable/post_quiz_question_bg"
            android:layout_width="0px"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <com.narvii.widget.ThumbImageView
                android:id="@+id/image"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginLeft="8dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_alignParentStart="true"
                app:defaultDrawable="@drawable/post_quiz_question_placeholder"
                app:strokeColor="#ccc"
                app:strokeWidth="0.5dp"/>
            <ImageView
                android:id="@+id/stub1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:src="@drawable/post_quiz_question_cr_mirror"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#333"
                android:textColorHint="#ccc"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="0px"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:hint="@string/post_quiz_question"
                android:maxLines="1"
                android:layout_toLeftOf="@+id/stub1"
                android:layout_toRightOf="@+id/image"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toStartOf="@+id/stub1"
                android:layout_toEndOf="@+id/image"/>
            <TextView
                android:textSize="10dp"
                android:textColor="#e90d3b"
                android:id="@+id/error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="2dp"
                android:text="@string/quiz_incomplete_answer"
                android:singleLine="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
    <Button
        android:textSize="14dp"
        android:textColor="#fff"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/delete"
        android:background="@drawable/swipe_to_delete_btn"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:text="@string/delete"/>
</com.narvii.widget.SwipeToDeleteLayout>

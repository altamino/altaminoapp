<?xml version="1.0" encoding="utf-8"?>
<com.narvii.story.widgets.StoryTopicView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/interest_item_view"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="22dp"
    android:layout_margin="5dp"
    app:background_style="semitransparent_with_stroke">
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:lines="1"/>
</com.narvii.story.widgets.StoryTopicView>

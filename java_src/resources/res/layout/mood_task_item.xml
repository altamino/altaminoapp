<?xml version="1.0" encoding="utf-8"?>
<com.github.mmin18.widget.FlexLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <GridLayout
        android:id="@+id/grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="4"
        app:layout_centerX="50%"/>
    <View
        android:id="@+id/bg"
        android:layout_width="0px"
        android:layout_height="0px"
        app:layout_bottom="100%"
        app:layout_left="grid.left"
        app:layout_right="grid.right"
        app:layout_top="0"/>
    <com.github.mmin18.widget.FlexLayout
        android:id="@+id/lock_layout"
        app:layout_centerX="50%"
        app:layout_height="grid.height"
        app:layout_width="grid.width">
        <com.narvii.widget.NVImageView
            android:id="@+id/icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_centerX="50%"
            app:layout_centerY="23%"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/text"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="@string/mood_unlock_instagram"
            app:layout_centerX="50%"
            app:layout_centerY="50%"/>
        <Button
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:id="@+id/unlock"
            android:background="@drawable/mood_picker_unlock_green"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="130dp"
            android:text="@string/mood_unlock_now"
            app:layout_centerX="50%"
            app:layout_centerY="78%"/>
    </com.github.mmin18.widget.FlexLayout>
</com.github.mmin18.widget.FlexLayout>

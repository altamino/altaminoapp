<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingTop="12dp"
    android:paddingRight="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.narvii.widget.ThumbImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/community_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="6dp"
        android:layout_marginStart="6dp"
        app:cornerRadius="3dp"
        app:imageType="community-icon"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="start|center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/community_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_weight="1"
        android:layout_marginStart="10dp"/>
    <CheckBox
        android:layout_gravity="center_vertical"
        android:id="@+id/check_box"
        android:layout_width="52dp"
        android:layout_height="30dp"
        android:layout_marginRight="12dp"
        android:button="@drawable/switch_bg"
        android:layout_marginEnd="12dp"/>
    <include
        android:id="@+id/drag_sort_view"
        layout="@layout/drag_sort_drag_handle"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.github.mmin18.widget.FlexLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="3dp"
    android:paddingBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="118dp"
    android:layout_height="wrap_content">
    <com.narvii.widget.PromotionalImageView
        android:id="@+id/image"
        android:background="@drawable/button_rect_transparent"
        android:scaleType="centerCrop"
        narvii:cornerRadius="@dimen/community_card_corner_radius"
        narvii:defaultDrawable="@color/placeholder"
        narvii:imageType="community-launch-image"
        narvii:layout_height="this.width*1.5"
        narvii:layout_left="3dp"
        narvii:layout_right="100%-6dp"
        narvii:layout_top="4dp"
        narvii:shadowColor="#0000"
        narvii:shadowOffsetX="4dp"
        narvii:shadowOffsetY="4dp"
        narvii:shadowSize="2dp"/>
    <View
        android:background="@drawable/community_img_bg"
        narvii:layout_bottom="image.bottom"
        narvii:layout_left="image.left"
        narvii:layout_right="image.right"
        narvii:layout_top="image.top"/>
    <com.narvii.widget.CommunityIconView
        android:id="@+id/icon"
        android:padding="1dp"
        narvii:layout_height="this.width"
        narvii:layout_left="0"
        narvii:layout_top="0"
        narvii:layout_width="parent.width*0.4"
        narvii:shadowColor="#0000"
        narvii:shadowOffsetX="2dp"
        narvii:shadowOffsetY="2dp"
        narvii:shadowSize="2dp"
        narvii:strokeColor="#fff"
        narvii:strokeWidth="1dp"
        style="@style/CommunityImageView"/>
    <com.narvii.widget.AutoScaleTextView
        android:textSize="12dp"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/checkin"
        android:background="@drawable/community_checkin_btn_rectangle"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_height="wrap_content"
        android:text="@string/check_in"
        android:singleLine="true"
        narvii:defaultAtWidth="86dp"
        narvii:layout_bottom="image.bottom-6dp"
        narvii:layout_left="image.left+6dp"
        narvii:layout_right="image.right-6dp"
        narvii:maxScaleTextSize="12dp"
        narvii:minScaleTextSize="9dp"/>
    <com.narvii.widget.AutoScaleTextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:shadowColor="#000"
        android:shadowRadius="1"
        narvii:defaultAtWidth="67dp"
        narvii:layout_bottom="checkin.visible?(checkin.top-5dp):(image.bottom-6dp)"
        narvii:layout_left="image.left+6dp"
        narvii:layout_right="image.right-6dp"
        narvii:maxScaleTextSize="13dp"
        narvii:minScaleTextSize="11dp"/>
    <com.narvii.widget.AutoScaleTextView
        android:textSize="14dp"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/notification_count"
        android:background="@drawable/community_notification_badge_o"
        narvii:defaultAtHeight="24dp"
        narvii:layout_height="this.width"
        narvii:layout_right="image.right+3dp"
        narvii:layout_top="image.top-4dp"
        narvii:layout_width="max(18dp,min(24dp,image.width*0.128))"
        narvii:minScaleTextSize="12dp"/>
    <com.narvii.widget.AutoSizingTextView
        android:textSize="9dp"
        android:textColor="#fff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/probation"
        android:background="@drawable/radius_yellow"
        android:padding="4dp"
        android:visibility="gone"
        android:text="@string/on_probation"
        android:drawableLeft="@drawable/ic_probation"
        android:drawableStart="@drawable/ic_probation"
        narvii:autoSizeTextMaxSize="9dp"
        narvii:layout_centerX="50%-1.5dp"
        narvii:layout_centerY="50%"
        narvii:layout_height="wrap_content"
        narvii:layout_width="min(wrap_content,image.width-8dp)"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#fff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/disabled"
        android:background="@drawable/radius_red"
        android:paddingLeft="10dp"
        android:paddingTop="4dp"
        android:paddingRight="10dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:text="@string/disabled"
        narvii:layout_centerX="50%-1.5dp"
        narvii:layout_centerY="50%"
        narvii:layout_height="wrap_content"
        narvii:layout_width="min(wrap_content,image.width-8dp)"/>
    <com.narvii.widget.SmoothProgressBar
        android:id="@+id/progress"
        android:visibility="invisible"
        android:layout_height="wrap_content"
        narvii:layout_centerY="(checkin.bottom+title.top)/2"
        narvii:layout_left="image.left"
        narvii:layout_right="image.right"
        style="@android:style/Widget.Holo.Light.ProgressBar.Horizontal"/>
    <TextView
        android:textSize="10dp"
        android:typeface="monospace"
        android:textColor="#fff"
        android:id="@+id/debuginfo"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        narvii:layout_centerY="checkin.centerY"
        narvii:layout_right="checkin.right-3dp"/>
</com.github.mmin18.widget.FlexLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.narvii.feed.FeedToolbarLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/feed_toolbar_height">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/feed_toolbar_vote"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="8dp"
        android:minWidth="56dp"
        android:layout_marginStart="8dp">
        <com.narvii.widget.VoteIcon
            android:id="@+id/feed_toolbar_vote_icon"
            android:duplicateParentState="true"
            android:layout_width="18dp"
            android:layout_height="18dp"/>
        <com.narvii.widget.SpinningView
            android:id="@+id/feed_toolbar_vote_progress"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            narvii:spinSize="@dimen/spin_tiny_size"
            narvii:spinStyle="2"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/feed_toolbar_normal"
            android:id="@+id/feed_toolbar_vote_count"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:duplicateParentState="true"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/feed_toolbar_comment"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="4dp"
        android:minWidth="64dp"
        android:layout_marginStart="4dp">
        <com.narvii.widget.TintButton
            android:id="@+id/feed_toolbar_comment_icon"
            android:background="@drawable/button_round_transparent"
            android:duplicateParentState="true"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_comment"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/feed_toolbar_normal"
            android:id="@+id/feed_toolbar_comment_count"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:duplicateParentState="true"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
    </LinearLayout>
    <View
        android:layout_width="0px"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/feed_toolbar_share"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="8dp"
        android:layout_marginEnd="8dp">
        <com.narvii.widget.TintButton
            android:gravity="center"
            android:id="@+id/feed_toolbar_share_icon"
            android:background="@drawable/button_round_transparent"
            android:padding="4dp"
            android:duplicateParentState="true"
            android:layout_width="28dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_share_grey"/>
    </LinearLayout>
    <ViewStub
        android:id="@+id/share_preview_repost"
        android:layout="@layout/link_snippet_repost"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="8dp"
        android:layout_marginEnd="8dp"/>
</com.narvii.feed.FeedToolbarLayout>

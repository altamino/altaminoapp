<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:background="#0a030524"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">
    <View
        android:background="@drawable/selector_my_chat_list_search"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_centerInParent="true"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <com.narvii.widget.TintButton
            android:gravity="center"
            android:id="@+id/ic_search"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="@dimen/master_home_top_tab_search_inner_padding"
            android:src="@drawable/ic_searchr"
            android:scaleType="centerInside"
            android:layout_marginStart="@dimen/master_home_top_tab_search_inner_padding"
            app:tintColor="#d6d6d6"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#d6d6d6"
            android:gravity="center"
            android:layout_width="0pt"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="@string/search_my_chats"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</RelativeLayout>

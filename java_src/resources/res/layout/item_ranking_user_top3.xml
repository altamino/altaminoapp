<?xml version="1.0" encoding="utf-8"?>
<com.narvii.widget.Top3UserLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:paddingBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.github.mmin18.widget.FlexLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        narvii:layout_height="parent.width*0.6+139dp"
        narvii:layout_width="parent.width">
        <TextView
            android:textStyle="bold"
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/user_ranking_no"
            android:layout_width="30dp"
            android:layout_height="30dp"
            narvii:layout_bottom="100%-4dp"
            narvii:layout_centerX="50%"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ccffffff"
            android:gravity="center"
            android:id="@+id/ranking_score"
            android:layout_width="match_parent"
            android:layout_height="15dp"
            narvii:layout_bottom="user_ranking_no.top-6dp"/>
        <FrameLayout
            android:id="@+id/ranking_badge_layout"
            narvii:layout_bottom="ranking_score.top-1dp"
            narvii:layout_centerX="50%"
            narvii:layout_height="25dp"
            narvii:layout_width="100%">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.narvii.widget.RankingTitleView
                android:layout_gravity="center"
                android:id="@+id/ranking_badge"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                narvii:allowShowProgress="false"
                narvii:badgeHeight="25dp"
                narvii:badge_small="true"
                narvii:textMinWidthTimes="2"
                narvii:textSize="8dp"/>
        </FrameLayout>
        <com.narvii.widget.NicknameView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:ellipsize="end"
            android:id="@+id/name"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:lines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            narvii:hideInfluencerBadge="false"
            narvii:hideMembershipBadge="true"
            narvii:hideRankingBadge="true"
            narvii:hideRole="true"
            narvii:layout_bottom="ranking_badge_layout.top+1dp"
            narvii:layout_centerX="50%"/>
        <include
            android:duplicateParentState="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            narvii:layout_bottom="name.top-19dp"
            narvii:layout_centerX="50%"
            narvii:layout_height="this.width"
            narvii:layout_width="60%"
            layout="@layout/user_avatar_layout_mini_nobadge"/>
    </com.github.mmin18.widget.FlexLayout>
</com.narvii.widget.Top3UserLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/button_round_transparent"
    android:paddingLeft="14dp"
    android:paddingRight="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="14dp"
    android:paddingEnd="10dp">
    <FrameLayout
        android:layout_gravity="top"
        android:paddingTop="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.narvii.widget.ThumbImageView
            android:id="@+id/community_icon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            narvii:cornerRadius="6dp"
            narvii:imageType="community-icon"
            narvii:strokeColor="#ccc"
            narvii:strokeWidth="0dp"
            style="@style/CommunityImageView"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginStart="10dp">
        <LinearLayout
            android:gravity="top"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="#000"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/community_name"
                android:layout_width="0pt"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_weight="1"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/community_invite_lock"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/locked"
                android:scaleType="centerInside"/>
        </LinearLayout>
        <TextView
            android:textSize="11dp"
            android:textColor="#fff"
            android:id="@+id/community_amino_id"
            android:background="@drawable/community_language_bg"
            android:paddingLeft="4dp"
            android:paddingTop="2dp"
            android:paddingRight="4dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ffff"
            android:gravity="start"
            android:id="@+id/extra_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"/>
    </LinearLayout>
</LinearLayout>

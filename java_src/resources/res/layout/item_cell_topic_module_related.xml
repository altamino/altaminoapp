<?xml version="1.0" encoding="utf-8"?>
<com.narvii.topic.widgets.GeneralTopicCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/story_topic_card_view"
    android:layout_width="100dp"
    android:layout_height="wrap_content"
    android:layout_marginLeft="5dp"
    android:layout_marginRight="5dp">
    <com.narvii.topic.widgets.TopicCardCoverView
        android:id="@+id/img_container"
        app:layout_height="this.width*1.1"
        app:layout_width="match_parent"/>
    <com.narvii.story.widgets.StoryTopicView
        android:id="@+id/topic_view"
        app:layout_bottom="img_container.bottom"
        app:layout_height="this.width*0.25"
        app:layout_width="match_parent"
        app:supportBackground="false"
        app:tagTextPadding="10dp"
        app:tagTextSize="11dp"/>
</com.narvii.topic.widgets.GeneralTopicCard>

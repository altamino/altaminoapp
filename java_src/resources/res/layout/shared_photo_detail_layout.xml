<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#111"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/disabled_bar"
        layout="@layout/detail_disabled_bar"/>
    <FrameLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/list_layout"/>
        <FrameLayout
            android:id="@+id/touch_area"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.narvii.nvplayerview.NVVideoView
                android:layout_gravity="center"
                android:id="@+id/video_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:id="@+id/image_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.narvii.sharedfolder.SharedPhotoTouchImageView
                    android:layout_gravity="center"
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    narvii:preload="true"
                    narvii:supportUhq="true"/>
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/image_loading"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="?android:attr/progressBarStyleLarge"/>
            </FrameLayout>
            <View
                android:background="#16000000"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/detail_layout"
                android:paddingBottom="16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.narvii.list.overlay.OverlayListPlaceholder
                    android:id="@+id/overlay_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <View
                    android:background="#32ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="10dp"/>
                <com.github.mmin18.widget.FlexLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <LinearLayout
                        android:orientation="vertical"
                        android:paddingLeft="16dp"
                        android:paddingRight="5dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_marginTop="10dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="5dp"
                        narvii:layout_height="min(wrap_content,parent.height*0.5)"
                        narvii:layout_width="parent.width*0.7">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/user_layout"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <include
                                android:layout_width="@dimen/detail_avatar_size"
                                android:layout_height="@dimen/detail_avatar_size"
                                layout="@layout/user_avatar_layout_mini"/>
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:layout_marginStart="10dp">
                                <com.narvii.widget.NicknameView
                                    android:textSize="15dp"
                                    android:textColor="@color/text_clickable_white"
                                    android:id="@+id/nickname"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    narvii:hideRole="true"
                                    narvii:shadowColor="#38000000"
                                    narvii:shadowOffsetX="0dp"
                                    narvii:shadowOffsetY="2dp"
                                    narvii:shadowSize="2dp"/>
                                <TextView
                                    android:textSize="12dp"
                                    android:textColor="#ccffffff"
                                    android:id="@+id/datetime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:shadowColor="#38000000"
                                    android:shadowDx="0"
                                    android:shadowDy="1"
                                    android:shadowRadius="2"/>
                            </LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:textSize="14dp"
                            android:textStyle="bold"
                            android:textColor="#fff"
                            android:ellipsize="end"
                            android:id="@+id/title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:maxLines="3"
                            android:shadowColor="#38000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="1"/>
                    </LinearLayout>
                    <com.narvii.widget.NVListView
                        android:id="@+id/album_list"
                        android:scrollbars="none"
                        android:descendantFocusability="afterDescendants"
                        android:layout_height="wrap_content"
                        android:listSelector="@drawable/list_selector"
                        narvii:layout_height="min(wrap_content,parent.height*0.5)"
                        narvii:layout_right="parent.width"
                        narvii:layout_width="parent.width*0.3"/>
                    <com.narvii.widget.NVListView
                        android:id="@+id/comment_list"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:scrollbars="none"
                        android:descendantFocusability="afterDescendants"
                        android:layout_width="match_parent"
                        android:listSelector="@drawable/list_selector"
                        narvii:layout_bottom="parent.height"
                        narvii:layout_height="min(wrap_content,parent.height*0.5)"/>
                </com.github.mmin18.widget.FlexLayout>
                <View
                    android:background="#32ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="10dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/vote_btn"
                        android:background="@drawable/shared_photo_detail_vote_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginRight="12dp"
                        android:minWidth="80dp"
                        android:layout_marginEnd="12dp">
                        <com.narvii.widget.VoteIcon
                            android:id="@+id/vote_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginLeft="10dp"
                            android:scaleType="centerInside"
                            android:layout_marginStart="10dp"/>
                        <com.narvii.widget.SpinningView
                            android:id="@+id/vote_progress"
                            android:visibility="gone"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginLeft="10dp"
                            android:layout_marginStart="10dp"
                            narvii:spinColor="#fff"
                            narvii:spinStyle="2"/>
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#fff"
                            android:gravity="center"
                            android:id="@+id/vote_count"
                            android:duplicateParentState="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/comment_btn"
                        android:background="@drawable/shared_photo_detail_vote_btn"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="36dp">
                        <com.narvii.widget.TintButton
                            android:padding="4dp"
                            android:duplicateParentState="true"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_comment"
                            narvii:tintColor="#fff"/>
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#fff"
                            android:id="@+id/add_comment"
                            android:paddingLeft="4dp"
                            android:paddingRight="4dp"
                            android:duplicateParentState="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/add_comment_hint"
                            android:singleLine="true"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>

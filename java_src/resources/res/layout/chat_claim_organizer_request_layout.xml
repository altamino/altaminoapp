<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="#fff"
    android:paddingLeft="25dp"
    android:paddingRight="25dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="170dp">
    <TextView
        android:textSize="18dp"
        android:textColor="#333333"
        android:id="@+id/organizer_trans_from"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textAlignment="center"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#999999"
        android:id="@+id/organizer_trans_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textAlignment="center"/>
    <LinearLayout
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="15dp">
        <FrameLayout
            android:id="@+id/claim_organizer_decline"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1">
            <com.narvii.widget.NVImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="#999999"
                narvii:cornerRadius="22dp"/>
            <TextView
                android:textSize="20dp"
                android:textColor="#fff"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/decline"
                android:singleLine="true"/>
        </FrameLayout>
        <View
            android:layout_width="15dp"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/claim_organizer_accept"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1">
            <com.narvii.widget.NVImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="#00ce7d"
                narvii:cornerRadius="22dp"/>
            <TextView
                android:textSize="20dp"
                android:textColor="#fff"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/accept"
                android:singleLine="true"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

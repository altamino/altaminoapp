<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:paddingLeft="12dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="10dp">
        <com.narvii.widget.ThumbImageView
            android:id="@+id/avatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            style="@style/AvatarImageView"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/flag_count_layout"
            android:background="@drawable/circle_red"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="20dp"
                android:textColor="#fff"
                android:id="@+id/flagged_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.narvii.widget.FontAwesomeView
                android:textColor="#fff"
                android:id="@+id/flagged_count_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginLeft="2dp"
                android:text="@string/ion_ios_flag"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <com.narvii.widget.NicknameView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/account_foreground_color_standalone"
            android:id="@+id/nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="8dp"
            android:layout_toLeftOf="@+id/flag_count_layout"
            android:layout_toRightOf="@+id/avatar"
            android:layout_alignParentTop="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/flag_count_layout"
            android:layout_toEndOf="@+id/avatar"
            narvii:hideRole="true"/>
        <TextView
            android:id="@+id/strike_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="4dp"
            android:layout_toRightOf="@+id/avatar"
            android:layout_below="@+id/nickname"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@+id/avatar"/>
    </RelativeLayout>
    <TextView
        android:textColor="#000"
        android:id="@+id/flag_type"
        android:paddingLeft="12dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:singleLine="true"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        <com.narvii.flag.FlagTagLayout
            android:id="@+id/tags_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="7.5"
            narvii:flow_gravity="-1"
            narvii:max_tag_lines="2"/>
        <TextView
            android:textColor="@color/flag_time_color"
            android:gravity="right"
            android:id="@+id/flag_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.5"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/resolved_layout"
        android:background="@android:drawable/dialog_holo_light_frame"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <com.github.mmin18.widget.FlexLayout
            android:background="@drawable/resolved_bar"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-12dp">
            <TextView
                android:textSize="18dp"
                android:textColor="#fff"
                android:id="@+id/resolved_time"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                narvii:layout_centerY="60%"/>
        </com.github.mmin18.widget.FlexLayout>
    </LinearLayout>
</LinearLayout>

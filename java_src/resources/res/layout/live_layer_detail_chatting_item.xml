<?xml version="1.0" encoding="utf-8"?>
<com.narvii.livelayer.detailview.LiveLayerDetailListItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="10dp"
    android:paddingTop="5dp"
    android:paddingRight="10dp"
    android:paddingBottom="5dp"
    android:layout_width="match_parent"
    android:layout_height="146dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <com.narvii.widget.ThumbImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        narvii:cornerRadius="5dp"
        narvii:defaultDrawable="@drawable/live_layer_detail_item_placeholder"
        narvii:hidePlayButton="true"
        narvii:imageType="chat-cover"/>
    <TextView
        android:textSize="22dp"
        android:textStyle="bold"
        android:textColor="#f2f2f2"
        android:gravity="start"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="60dp"
        android:maxLines="2"
        android:shadowColor="#0000"
        android:shadowDy="3"
        android:shadowRadius="8"
        android:textAlignment="viewStart"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="60dp"/>
    <include layout="@layout/fans_only_content_indicator_layout_live_chat"/>
    <com.narvii.livelayer.detailview.AutoBubbleView
        android:id="@+id/live_layer_auto_bubble"
        android:layout_width="100dp"
        android:layout_height="45dp"
        android:layout_marginLeft="12dp"
        android:layout_marginBottom="8dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="12dp"/>
    <include layout="@layout/live_layer_detail_item_bar"/>
</com.narvii.livelayer.detailview.LiveLayerDetailListItemView>

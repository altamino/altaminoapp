<?xml version="1.0" encoding="utf-8"?>
<com.narvii.livelayer.detailview.HeaderLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:id="@+id/live_layer_detail_header"
    android:clipChildren="false"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.github.mmin18.widget.RealtimeBlurView
        android:layout_gravity="center"
        android:id="@+id/blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        narvii:realtimeBlurRadius="10dp"
        narvii:realtimeOverlayColor="#ffff"/>
    <com.narvii.widget.TintButton
        android:gravity="center"
        android:id="@+id/actionbar_back"
        android:padding="10dp"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_back_mirror"
        android:scaleType="centerInside"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"/>
    <com.narvii.widget.TintButton
        android:gravity="center"
        android:id="@+id/minimize"
        android:background="@drawable/circle_dark_transplant_clickable"
        android:padding="6dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:src="@drawable/ic_chevron_down"
        android:scaleType="centerInside"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true"/>
    <com.narvii.widget.NVImageView
        android:id="@+id/detail_icon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_live_layer_lightning"
        narvii:layout_image_max_height="40dp"
        narvii:layout_image_min_height="25dp"
        narvii:layout_image_min_margin_top="10dp"/>
    <FrameLayout
        android:id="@+id/detail_title_wrapper"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="18dp"
            android:textColor="#fff"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:layout_gravity="center"
            android:id="@+id/detail_title"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Test"
            android:maxLines="2"
            android:textAlignment="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
    </FrameLayout>
</com.narvii.livelayer.detailview.HeaderLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.narvii.feed.FeedListItem
        android:id="@+id/headline_feed_item"
        android:background="#eeeff1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.narvii.widget.PushEffectLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/last_pos_container"
            android:background="@drawable/button_amino_green"
            android:padding="12dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_headline_last_point"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#fff"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:text="@string/headLine_last_read_point"
                android:layout_marginStart="7dp"/>
        </com.narvii.widget.PushEffectLayout>
    </com.narvii.feed.FeedListItem>
</LinearLayout>

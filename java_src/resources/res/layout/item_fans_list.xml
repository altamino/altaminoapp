<?xml version="1.0" encoding="utf-8"?>
<com.narvii.influencer.FansListItemCell xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/fans_list_item_height">
    <include
        android:layout_width="@dimen/default_avatar_size_mini"
        android:layout_height="@dimen/default_avatar_size_mini"
        app:layout_centerY="50%"
        app:layout_left="15dp"
        layout="@layout/user_avatar_layout_mini"/>
    <View
        android:id="@+id/view_stub"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_centerY="50%"
        app:layout_left="user_avatar_layout.right+10dp"
        app:layout_right="75%"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_bottom="view_stub.top-2dp"
        app:layout_centerY="50%"
        app:layout_left="view_stub.left"
        app:layout_right="view_stub.right">
        <com.narvii.widget.NicknameView
            android:textSize="18dp"
            android:textColor="#000"
            android:id="@+id/nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:hideRole="true"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#b9b9b9"
            android:ellipsize="end"
            android:id="@+id/address"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:singleLine="true"/>
    </LinearLayout>
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_centerY="50%"
        app:layout_right="100%-10dp"
        layout="@layout/component_user_follow"/>
    <ImageView
        android:id="@+id/user_relation_following"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/follow_check"
        app:layout_centerY="50%"
        app:layout_right="100%-10dp"/>
    <com.narvii.tipping.TippingThanksView
        android:id="@+id/fans_thanks_view"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        app:layout_right="100%-10dp"/>
</com.narvii.influencer.FansListItemCell>

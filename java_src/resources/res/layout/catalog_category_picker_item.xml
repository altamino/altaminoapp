<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <View
        android:id="@+id/stub1"
        android:layout_width="0px"
        android:layout_height="0px"
        android:layout_marginLeft="20dp"
        android:layout_marginStart="20dp"/>
    <com.narvii.widget.FontAwesomeView
        android:textSize="18dp"
        android:textColor="#555"
        android:gravity="center"
        android:id="@+id/icon"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:text="@string/ion_arrow_down_b"/>
    <RelativeLayout
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="20dp"
            android:textColor="#555"
            android:id="@+id/label"
            android:paddingRight="44dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:paddingEnd="44dp"
            android:layout_alignParentStart="true"/>
        <com.narvii.widget.FontAwesomeView
            android:textSize="22dp"
            android:textColor="#4cd964"
            android:gravity="center"
            android:id="@+id/add"
            android:background="@drawable/button_round_transparent"
            android:padding="10dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="@string/ion_ios_plus"
            android:layout_alignRight="@+id/label"
            android:layout_centerVertical="true"
            android:layout_alignEnd="@+id/label"/>
    </RelativeLayout>
    <ImageView
        android:gravity="center_vertical"
        android:id="@+id/radio"
        android:padding="7dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_pick_circle"/>
</LinearLayout>

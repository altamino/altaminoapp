<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#0000"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/click_remove_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="38dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="38dp"
        android:layout_marginBottom="4dp"
        android:minWidth="300dp">
        <FrameLayout
            android:background="@drawable/rect_round_white_8_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_claim_gift_background"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="22dp"
                    android:textStyle="bold"
                    android:textColor="#4a4a4a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:text="@string/claim_gift_dialog_title"/>
                <FrameLayout
                    android:id="@+id/claim_coupons_card_container"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginLeft="30dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginRight="30dp"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginLeft="30dp"
                    android:layout_marginTop="38dp"
                    android:layout_marginRight="30dp"
                    android:layout_marginBottom="30dp">
                    <Button
                        android:textSize="22dp"
                        android:textStyle="bold"
                        android:textColor="#fff"
                        android:id="@+id/claim_gift_button"
                        android:background="@drawable/claim_gift_green_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/claim_now"/>
                    <Button
                        android:textSize="22dp"
                        android:textColor="#0cd484"
                        android:id="@+id/claim_gift_use_button"
                        android:background="@drawable/claim_gift_stroke_green_button"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/use_it"/>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
        <com.narvii.widget.PopButton
            android:layout_gravity="center_horizontal"
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_dialog_close_circle"
            android:alpha="0.8"
            app:tintColor="#fff"/>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.github.mmin18.widget.FlexLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="3dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.narvii.widget.SecretImageView
        android:id="@+id/image"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:scaleType="centerCrop"
        app:defaultDrawable="@color/placeholder"
        app:layout_centerX="26dp"
        app:strokeColor="#e4e4e4"
        app:strokeWidth="0.5dp"/>
    <com.narvii.widget.CardView
        android:id="@+id/item_card"
        android:layout_width="32dp"
        android:layout_height="38dp"
        app:layout_centerX="24dp">
        <com.narvii.widget.SecretImageView
            android:id="@+id/image_card"
            android:tag="@string/image_tag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cornerRadius="6dp"
            app:defaultDrawable="@color/item_card_placeholder"
            app:strokeColor="@color/item_card_stroke"
            app:strokeWidth="@dimen/item_card_stroke_width"/>
        <TextView
            android:id="@+id/title_card"
            android:tag="@string/title_tag"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="6dp"/>
        <include layout="@layout/fans_only_content_indicator_layout_wiki"/>
    </com.narvii.widget.CardView>
    <View
        android:id="@+id/stub1"
        android:layout_width="0px"
        app:layout_height="image.visible?image.height:(item_card.visible?item_card.height:40dp)"
        app:layout_left="image.visible?image.right:(item_card.visible?item_card.right:0)"/>
    <com.narvii.widget.LongPushButton
        android:id="@+id/push_btn"
        android:clickable="true"
        android:layout_height="36dp"
        app:layout_centerY="stub1.centerY+1.5dp"
        app:layout_left="stub1.right+5dp"
        app:layout_right="100%-5dp">
        <TextView
            android:textSize="11dp"
            android:textColor="#fff"
            android:ellipsize="end"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/title1"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="32dp"
            android:maxLines="1"
            android:shadowColor="#333"
            android:shadowDy="1"
            android:layout_marginEnd="32dp"/>
        <TextView
            android:textSize="11dp"
            android:textStyle="bold"
            android:textColor="#f4f4f4"
            android:layout_gravity="center"
            android:id="@+id/hold_longer"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hold_longer"/>
        <com.narvii.widget.SpinningView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/progress"
            android:visibility="invisible"
            android:layout_width="32dp"
            android:layout_height="20dp"
            android:layout_marginRight="6dp"
            android:layout_marginEnd="6dp"
            app:spinColor="#fff"/>
    </com.narvii.widget.LongPushButton>
    <com.narvii.poll.VoteBar
        android:id="@+id/vote_bar"
        android:visibility="invisible"
        android:layout_width="match_parent"
        app:layout_centerY="stub1.centerY"
        app:layout_height="30dp"
        app:layout_left="stub1.right+6dp"
        app:layout_right="100%-6dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:paddingRight="45dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="6dp"
            android:paddingEnd="45dp">
            <com.narvii.widget.FontAwesomeView
                android:textColor="#fff"
                android:id="@+id/check"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="6dp"
                android:text="@string/fa_check"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#fff"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/title2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:shadowColor="#333"
                android:shadowDy="1"/>
        </LinearLayout>
        <TextView
            android:textSize="11dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/vote_bar_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:layout_marginEnd="6dp"/>
    </com.narvii.poll.VoteBar>
    <com.narvii.poll.VotersLayout
        android:id="@+id/poll_option_voters"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_height="wrap_content"
        app:layout_left="stub1.right+12dp"
        app:layout_right="100%-12dp"
        app:layout_top="vote_bar.bottom+6dp"/>
</com.github.mmin18.widget.FlexLayout>

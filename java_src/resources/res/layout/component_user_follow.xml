<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:id="@+id/user_follow"
    android:background="@drawable/button_round_follow"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="30dp">
        <ImageView
            android:gravity="center"
            android:id="@+id/user_follow_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_follow_plus_padding"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:id="@+id/user_follow_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/user_follow"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <com.narvii.widget.SpinningView
        android:layout_gravity="center"
        android:id="@+id/user_follow_progress"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        narvii:spinColor="#eee"
        narvii:spinStyle="2"/>
</FrameLayout>

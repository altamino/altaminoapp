<?xml version="1.0" encoding="utf-8"?>
<com.narvii.app.theme.view.NVThemeLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="62dp"
    app:nv_dark_background="#1affffff">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_weight="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <com.narvii.app.theme.view.NVThemeTextView
            android:textSize="16dp"
            android:textColor="#4a4a4a"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:nv_dark_textColor="@color/prefs_text_color_dark"/>
        <com.narvii.app.theme.view.NVThemeTextView
            android:textSize="13dp"
            android:textColor="#9b9b9b"
            android:ellipsize="end"
            android:id="@+id/subTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:nv_dark_textColor="@color/prefs_text_color_dark"/>
    </LinearLayout>
    <com.narvii.widget.FontAwesomeView
        android:id="@+id/check"
        android:visibility="visible"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp"
        style="@style/check_mark"/>
</com.narvii.app.theme.view.NVThemeLinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#f3f5ff"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@color/prefs_background"
        android:layout_width="match_parent"
        android:layout_height="@dimen/prefs_default_size">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/color_default"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginBottom="9dp"
            android:text="@string/current_invite_code"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="18dp"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/link_layout"
        android:background="@drawable/button_round_white"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp">
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="#4a4a4a"
            android:gravity="center"
            android:id="@+id/code"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#9b9b9b"
            android:gravity="center"
            android:id="@+id/link"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="6dp">
        <TextView
            android:textSize="14dp"
            android:textColor="#9b9b9b"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/count_down"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="viewStart"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#0076ff"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/regenerate"
            android:background="@drawable/button_oval_white_round"
            android:paddingLeft="4dp"
            android:paddingTop="2dp"
            android:paddingRight="4dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/regenerate"/>
    </LinearLayout>
    <com.narvii.widget.PushButton
        android:id="@+id/contact"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        app:pushButtonColor="#03cd7b"
        app:pushButtonLift="4dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/prefs_default_size"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:src="@drawable/ic_invite_members_contact"
                android:scaleType="centerInside"
                android:layout_marginEnd="10dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.narvii.widget.AutoSizingTextView
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/invite_your_contact"
                    android:maxLines="1"
                    app:autoSizeTextMaxSize="20dp"
                    app:autoSizeTextMinSize="16dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/invite_contact_desc"/>
            </LinearLayout>
        </LinearLayout>
    </com.narvii.widget.PushButton>
    <com.narvii.widget.PushButton
        android:id="@+id/share"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        app:pushButtonColor="#0a7cff"
        app:pushButtonLift="4dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/prefs_default_size"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:src="@drawable/ic_invite_members_share"
                android:scaleType="centerInside"
                android:layout_marginEnd="10dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.narvii.widget.AutoSizingTextView
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/share_invite_url"
                    android:maxLines="1"
                    app:autoSizeTextMaxSize="20dp"
                    app:autoSizeTextMinSize="16dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/share_invite_url_desc"/>
            </LinearLayout>
        </LinearLayout>
    </com.narvii.widget.PushButton>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/leader_controller"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp">
        <TextView
            android:textSize="14dp"
            android:textColor="#9b9b9b"
            android:gravity="center"
            android:id="@+id/invite_history"
            android:background="@drawable/button_oval_white_round"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/invite_history"/>
        <View
            android:layout_width="30dp"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#9b9b9b"
            android:gravity="center"
            android:id="@+id/valid_links"
            android:background="@drawable/button_oval_white_round"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/existing_invite_codes"/>
    </LinearLayout>
</LinearLayout>

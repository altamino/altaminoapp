<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/stub1"
        android:background="#0000"
        android:padding="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <com.narvii.widget.FontAwesomeView
            android:textSize="20dp"
            android:textColor="#ccc"
            android:gravity="center"
            android:padding="5dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginRight="4dp"
            android:text="@string/fa_exclamation_triangle"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#eee"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:text="@string/post_location_picker_hint"
            android:layout_weight="1"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_above="@+id/stub1"
        android:layout_alignParentTop="true">
        <View
            android:id="@+id/stub2"
            android:layout_width="0px"
            android:layout_height="0px"
            android:layout_centerInParent="true"/>
        <View
            android:background="#0000"
            android:layout_width="50dp"
            android:layout_height="3dp"
            android:layout_marginRight="10dp"
            android:layout_toLeftOf="@+id/stub2"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/stub2"/>
        <View
            android:background="#0000"
            android:layout_width="50dp"
            android:layout_height="3dp"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@+id/stub2"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/stub2"/>
        <View
            android:background="#0000"
            android:layout_width="3dp"
            android:layout_height="50dp"
            android:layout_marginBottom="10dp"
            android:layout_above="@+id/stub2"
            android:layout_centerHorizontal="true"/>
        <View
            android:background="#0000"
            android:layout_width="3dp"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/stub2"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.github.mmin18.widget.FlexLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="@dimen/multi_image_gap"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        app:layout_height="this.width"
        app:layout_width="screen.width/3"/>
    <com.narvii.widget.NVImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:scaleType="centerCrop"
        app:layout_height="this.width"
        app:layout_width="100%"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/caption"
        android:background="#0000"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_bottom="image.bottom"/>
</com.github.mmin18.widget.FlexLayout>

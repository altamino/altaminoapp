<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/stub1"
        android:clipChildren="false"
        android:layout_width="240dp"
        android:layout_height="62dp"
        android:layout_marginBottom="10dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true">
        <com.narvii.widget.ThumbImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            narvii:defaultDrawable="@color/repost_quote_bg"
            narvii:shadowColor="#666"
            narvii:shadowSize="1dp"/>
        <com.narvii.widget.SecretImageView
            android:id="@+id/icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="10dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_alignParentStart="true"
            narvii:strokeColor="#aaa"
            narvii:strokeWidth="0.5dp"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="#444"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="6dp"
            android:singleLine="true"
            android:layout_toRightOf="@+id/icon"
            android:layout_alignParentTop="true"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_toEndOf="@+id/icon"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#888"
            android:ellipsize="end"
            android:id="@+id/text2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="6dp"
            android:maxLines="2"
            android:layout_toRightOf="@+id/icon"
            android:layout_below="@+id/title"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_toEndOf="@+id/icon"/>
    </RelativeLayout>
    <EditText
        android:textSize="16dp"
        android:textColor="#222"
        android:gravity="start|top"
        android:id="@+id/content"
        android:background="@null"
        android:padding="10dp"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:hint="@string/feed_blog_repost_default"
        android:layout_above="@+id/stub1"
        android:layout_alignParentTop="true"
        android:inputType="textMultiLine"/>
</RelativeLayout>

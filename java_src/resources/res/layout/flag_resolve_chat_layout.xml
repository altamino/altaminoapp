<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/list_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="100dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13dp"
                android:textColor="#f2f2f2"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/message_date"
                android:background="@drawable/chat_info_bg"
                android:paddingLeft="4dp"
                android:paddingTop="1dp"
                android:paddingRight="4dp"
                android:paddingBottom="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_gravity="start"
                    android:orientation="vertical"
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.narvii.chat.ChatMessageItem
                        android:orientation="horizontal"
                        android:id="@+id/chat_message_item"
                        android:padding="12dp"
                        android:clipChildren="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginLeft="2dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginStart="2dp"
                            layout="@layout/user_avatar_layout_mini"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/stub1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <com.narvii.widget.NicknameView
                                    android:textSize="18dp"
                                    android:textColor="#24a4fe"
                                    android:id="@+id/nickname"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="12dp"
                                    android:layout_marginRight="12dp"
                                    android:shadowColor="#40000000"
                                    android:shadowDx="0"
                                    android:shadowDy="1"
                                    android:shadowRadius="1"
                                    android:layout_marginStart="12dp"
                                    android:layout_marginEnd="12dp"/>
                                <TextView
                                    android:textSize="10dp"
                                    android:textStyle="bold"
                                    android:textColor="#000"
                                    android:id="@+id/host_label"
                                    android:background="@drawable/round_white_corner_2"
                                    android:paddingLeft="4dp"
                                    android:paddingTop="2dp"
                                    android:paddingRight="4dp"
                                    android:paddingBottom="2dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/host"
                                    android:maxLines="1"
                                    android:paddingStart="4dp"
                                    android:paddingEnd="4dp"/>
                            </LinearLayout>
                            <com.narvii.widget.ReversibleLinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/stub2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:minWidth="100dp">
                                <com.narvii.monetization.bubble.BubbleViewContainer
                                    android:id="@+id/chat_bubble_container"
                                    android:clipChildren="false"
                                    android:clipToPadding="false"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="4dp"
                                    android:layout_marginRight="4dp"
                                    android:layout_marginStart="4dp"
                                    android:layout_marginEnd="4dp"/>
                                <include layout="@layout/chat_image_sticker"/>
                                <include layout="@layout/chat_mood_sticker"/>
                                <com.narvii.widget.SpinningView
                                    android:layout_gravity="center_vertical"
                                    android:id="@+id/progress"
                                    android:layout_width="@dimen/spin_small_size"
                                    android:layout_height="@dimen/spin_small_size"
                                    narvii:spinSize="@dimen/spin_small_size"/>
                                <com.narvii.widget.FontAwesomeView
                                    android:textSize="16dp"
                                    android:textColor="#f2f2f2"
                                    android:gravity="center"
                                    android:layout_gravity="center_vertical"
                                    android:id="@+id/chat_resend"
                                    android:background="@drawable/chat_resend"
                                    android:padding="4dp"
                                    android:visibility="gone"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:text="@string/fa_repeat"/>
                            </com.narvii.widget.ReversibleLinearLayout>
                        </LinearLayout>
                    </com.narvii.chat.ChatMessageItem>
                    <View
                        android:background="#eee"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/attach_container"
                        android:background="#f3f5ff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.narvii.widget.NVImageView
                            android:id="@+id/attach_screenshot"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="10dp"
                            android:adjustViewBounds="true"
                            android:minHeight="100dp"
                            narvii:defaultDrawable="@color/placeholder"/>
                        <Button
                            android:textSize="20dp"
                            android:textColor="#fff"
                            android:layout_gravity="center"
                            android:id="@+id/chat_see_all"
                            android:background="@drawable/button_round_blue_l"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="30dp"
                            android:text="@string/see_all_chat"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"/>
                    </LinearLayout>
                </LinearLayout>
                <com.narvii.widget.SpinningView
                    android:layout_gravity="center"
                    android:id="@android:id/progress"
                    android:visibility="gone"
                    android:layout_width="@dimen/spin_large_size"
                    android:layout_height="@dimen/spin_large_size"/>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/error_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="18dp"
                        android:textColor="#000"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/error_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <com.narvii.widget.FontAwesomeView
                        android:textColor="@color/button_text_light"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/error_retry"
                        android:padding="12dp"
                        android:clickable="true"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:text="@string/ion_refresh"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>

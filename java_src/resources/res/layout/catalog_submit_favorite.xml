<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/catalog_add"
    android:paddingTop="20dp"
    android:paddingBottom="60dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textColor="@color/gold"
        android:id="@+id/submit_favorite"
        android:background="@drawable/button_round_submit_favorite"
        android:paddingLeft="26dp"
        android:paddingTop="8dp"
        android:paddingRight="26dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/catalog_submit_favorite"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#ffff"
        android:gravity="center"
        android:paddingLeft="26dp"
        android:paddingTop="8dp"
        android:paddingRight="26dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/catalog_submit_favorite_desc"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/drawer_section_others_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="#0000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:gravity="center_vertical"
            android:id="@+id/drawer_others"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="26dp"
            android:text="@string/drawer_options"
            android:singleLine="true"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/drawer_all_members"
        android:background="@drawable/button_rect_transparent"
        android:paddingLeft="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/draw_host_item_min_height"
        android:paddingStart="8dp">
        <ImageView
            android:background="@drawable/circle_dark_transplant"
            android:padding="8dp"
            android:layout_width="@dimen/draw_host_item_size"
            android:layout_height="@dimen/draw_host_item_size"
            android:src="@drawable/left_side_member"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/community_all_members"
            android:layout_weight="1"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <View
        android:background="#0000"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_divider_height"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/drawer_bookmarks"
        android:background="@drawable/button_rect_transparent"
        android:paddingLeft="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/draw_host_item_min_height"
        android:paddingStart="8dp">
        <ImageView
            android:background="@drawable/circle_dark_transplant"
            android:padding="10dp"
            android:layout_width="@dimen/draw_host_item_size"
            android:layout_height="@dimen/draw_host_item_size"
            android:src="@drawable/drawer_bookmark"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/my_saved_post"
            android:layout_weight="1"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <View
        android:background="#0000"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_divider_height"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/drawer_share_community"
        android:background="@drawable/button_rect_transparent"
        android:paddingLeft="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/draw_host_item_min_height"
        android:paddingStart="8dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:background="@drawable/circle_dark_transplant"
            android:padding="10dp"
            android:layout_width="@dimen/draw_host_item_size"
            android:layout_height="@dimen/draw_host_item_size"
            android:src="@drawable/share_community"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:ellipsize="end"
                android:id="@+id/share_community_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/invite_members"
                android:singleLine="true"/>
            <TextView
                android:textSize="10dp"
                android:textColor="#ddd"
                android:id="@+id/share_community_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="#0000"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_divider_height"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/drawer_settings"
        android:background="@drawable/button_rect_transparent"
        android:paddingLeft="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/draw_host_item_min_height"
        android:paddingStart="8dp">
        <ImageView
            android:background="@drawable/circle_dark_transplant"
            android:padding="10dp"
            android:layout_width="@dimen/draw_host_item_size"
            android:layout_height="@dimen/draw_host_item_size"
            android:src="@drawable/more_options"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/prefs_settings"
            android:layout_weight="1"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <View
        android:background="#0000"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_divider_height"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/drawer_guidelines"
        android:background="@drawable/button_rect_transparent"
        android:paddingLeft="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/draw_host_item_min_height"
        android:paddingStart="8dp">
        <ImageView
            android:background="@drawable/circle_dark_transplant"
            android:padding="10dp"
            android:layout_width="@dimen/draw_host_item_size"
            android:layout_height="@dimen/draw_host_item_size"
            android:src="@drawable/ic_drawer_host_guidelines"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/page_guidelines"
            android:layout_weight="1"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <View
        android:background="#0000"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_divider_height"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/drawer_community_detail"
        android:background="@drawable/button_rect_transparent"
        android:paddingLeft="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/draw_host_item_min_height"
        android:paddingStart="8dp">
        <ImageView
            android:background="@drawable/circle_dark_transplant"
            android:padding="10dp"
            android:layout_width="@dimen/draw_host_item_size"
            android:layout_height="@dimen/draw_host_item_size"
            android:src="@drawable/drawer_community_detail"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/drawer_community_detail"
            android:layout_weight="1"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/drawer_create_community_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="#0000"
            android:layout_width="match_parent"
            android:layout_height="@dimen/list_divider_height"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/drawer_create_community"
            android:background="@drawable/button_rect_transparent"
            android:paddingLeft="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/draw_host_item_min_height"
            android:paddingStart="8dp">
            <ImageView
                android:background="@drawable/circle_dark_transplant"
                android:padding="10dp"
                android:layout_width="@dimen/draw_host_item_size"
                android:layout_height="@dimen/draw_host_item_size"
                android:src="@drawable/ic_create_bg"/>
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:layout_width="0px"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="@string/create_your_own_amino"
                android:layout_weight="1"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
    </LinearLayout>
</merge>

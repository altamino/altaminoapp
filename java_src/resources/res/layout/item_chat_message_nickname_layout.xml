<?xml version="1.0" encoding="utf-8"?>
<com.narvii.widget.ReversibleLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/nickname_container"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <com.narvii.widget.NicknameView
        android:textSize="12dp"
        android:textColor="#fff"
        android:id="@+id/nickname"
        android:layout_width="0pt"
        android:layout_height="wrap_content"
        android:shadowColor="#40000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="1"
        android:layout_weight="1"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#000"
        android:id="@+id/host_label"
        android:background="@drawable/round_white_corner_2"
        android:paddingLeft="4dp"
        android:paddingTop="1dp"
        android:paddingRight="4dp"
        android:paddingBottom="1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:text="@string/host"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"/>
</com.narvii.widget.ReversibleLinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingTop="8dp"
    android:paddingRight="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:id="@+id/snippet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
    <com.narvii.widget.ThumbImageView
        android:id="@+id/snippet_image"
        android:padding="1dp"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#333"
        android:id="@+id/snippet_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="6dp">
        <com.narvii.widget.ThumbImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/snippet_favicon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"
            app:defaultDrawable="@drawable/favicon_default_s"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#aaa"
            android:layout_gravity="center_vertical"
            android:id="@+id/snippet_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:textAllCaps="true"/>
    </LinearLayout>
</LinearLayout>

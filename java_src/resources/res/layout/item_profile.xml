<?xml version="1.0" encoding="utf-8"?>
<com.narvii.app.theme.view.NVThemeLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#fff"
    android:paddingLeft="@dimen/item_padding_horizontal_ex"
    android:paddingTop="10dp"
    android:paddingRight="@dimen/item_padding_horizontal_ex"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/item_padding_horizontal_ex"
    android:paddingEnd="@dimen/item_padding_horizontal_ex"
    app:nv_dark_background="@android:color/transparent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="48dp"
            android:layout_height="48dp">
            <include
                android:layout_gravity="center"
                android:layout_width="46dp"
                android:layout_height="46dp"
                layout="@layout/user_avatar_layout_mini_nobadge"/>
        </FrameLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0pt"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp">
            <com.narvii.widget.NicknameView
                android:textSize="17dp"
                android:textColor="#000000"
                android:ellipsize="end"
                android:id="@+id/nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/community_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <com.narvii.widget.CommunityIconView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/community_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    app:defaultDrawable="@drawable/placeholder_community"/>
                <com.narvii.app.theme.view.NVThemeTextView
                    android:textSize="12dp"
                    android:textColor="#aaaaaa"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/community_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:maxLines="1"
                    android:layout_marginStart="6dp"
                    app:nv_dark_textColor="#b3ffffff"/>
            </LinearLayout>
        </LinearLayout>
        <com.narvii.app.theme.view.NVThemeTextView
            android:textSize="14dp"
            android:textColor="@color/profile_edit_text"
            android:layout_gravity="center_vertical"
            android:id="@+id/edit"
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/edit"
            android:layout_marginStart="10dp"
            app:nv_dark_textColor="#b3ffffff"/>
    </LinearLayout>
    <com.narvii.app.theme.view.NVThemeView
        android:background="#f5f5f5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        app:nv_dark_background="#48ffffff"/>
</com.narvii.app.theme.view.NVThemeLinearLayout>

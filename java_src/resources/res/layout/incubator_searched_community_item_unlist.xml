<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/button_round_transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="top"
            android:paddingTop="6dp"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginLeft="10dp"
            android:layout_marginStart="10dp">
            <com.narvii.widget.ThumbImageView
                android:layout_gravity="top"
                android:id="@+id/community_icon"
                android:layout_width="60dp"
                android:layout_height="60dp"
                narvii:cornerRadius="12dp"
                narvii:imageType="community-icon"
                narvii:strokeColor="#ccc"
                narvii:strokeWidth="0dp"
                style="@style/CommunityImageView"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="5dp"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:paddingStart="5dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="5dp">
            <LinearLayout
                android:gravity="top"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.narvii.widget.AutoSizingTextView
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:textColor="#000"
                    android:ellipsize="end"
                    android:gravity="top"
                    android:id="@+id/community_name"
                    android:layout_width="0px"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:maxLines="2"
                    android:layout_weight="1"
                    narvii:autoSizeTextMaxSize="18dp"
                    narvii:autoSizeTextMinSize="16dp"/>
                <ImageView
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/community_invite_lock"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="6dp"
                    android:src="@drawable/locked"
                    android:scaleType="centerInside"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
            <com.github.mmin18.widget.FlexLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">
                <com.narvii.widget.CommunityActivenessBar
                    android:id="@+id/community_activeness_level"
                    narvii:layout_height="this.width*0.125+2dp"
                    narvii:layout_width="55%"/>
            </com.github.mmin18.widget.FlexLayout>
            <TextView
                android:textSize="11dp"
                android:textColor="#fff"
                android:id="@+id/community_amino_id"
                android:background="@drawable/community_language_bg"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ffff"
                android:gravity="start"
                android:id="@+id/extra_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="5dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#aaa"
                android:ellipsize="end"
                android:id="@+id/community_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="#0000"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="12dp"
        android:layout_marginStart="12dp"/>
</LinearLayout>

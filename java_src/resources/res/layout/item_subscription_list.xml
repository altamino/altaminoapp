<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_gravity="bottom"
    android:id="@+id/prop_item_container_root"
    android:background="@drawable/item_selector_white_grey"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="75dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <FrameLayout
        android:layout_width="70dp"
        android:layout_height="wrap_content">
        <com.narvii.widget.NVImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/avatar_frame_icon"
            android:layout_width="70dp"
            android:layout_height="50dp"
            android:scaleType="fitCenter"/>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/layout_main"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15dp"
                android:textColor="#333334"
                android:layout_gravity="center_vertical"
                android:id="@+id/avatar_frame_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <ImageView
                android:id="@+id/amino_plus_badge"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:src="@drawable/ic_amino_plus_mini"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/community_info_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <com.narvii.widget.CommunityIconView
                android:id="@+id/community_icon"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"
                app:cornerRadius="2dp"
                app:defaultDrawable="@drawable/placeholder_community"
                app:scalePlaceholder="true"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#b3b3b3"
                android:ellipsize="end"
                android:id="@+id/community_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="end"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_marginEnd="10dp">
        <TextView
            android:textSize="10dp"
            android:textColor="#d10012"
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
    <com.narvii.widget.TintButton
        android:gravity="center"
        android:id="@+id/chevron_right"
        android:layout_width="10dp"
        android:layout_height="15dp"
        android:layout_marginRight="10dp"
        android:src="@drawable/chevron_right_mirror"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp"/>
</LinearLayout>

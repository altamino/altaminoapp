<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:id="@+id/user_profile_header"
    android:clipChildren="false"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.widget.SlideshowView
        android:id="@+id/slideshow"
        android:background="@drawable/slideshow_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        narvii:hidingHeight2="40dp"/>
    <com.narvii.widget.BubbleBackground
        android:id="@+id/bubble"
        android:background="#303030"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:background="@drawable/shadow_drop_profile"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_alignParentTop="true"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <com.narvii.widget.ThumbImageView
            android:id="@+id/avatar"
            android:layout_width="@dimen/user_profile_header_avatar"
            android:layout_height="@dimen/user_profile_header_avatar"
            narvii:shadowColor="#0000"
            narvii:shadowSize="5dp"
            narvii:strokeWidth="2dp"
            style="@style/AvatarImageView"/>
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#f2f2f2"
            android:ellipsize="end"
            android:id="@+id/nickname"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:singleLine="true"
            android:shadowColor="@color/shadow"
            android:shadowDy="2"
            android:shadowRadius="4"/>
    </LinearLayout>
</RelativeLayout>

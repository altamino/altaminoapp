<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="0dp"
        android:paddingRight="6dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="0dp"
        android:paddingEnd="6dp">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp">
            <com.narvii.widget.ThumbImageView
                android:id="@+id/image"
                android:layout_width="50dp"
                android:layout_height="50dp"/>
            <ImageView
                android:id="@+id/cover_mark"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_cover_mark"/>
        </FrameLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/text"
            android:gravity="start|center_vertical"
            android:id="@+id/text"
            android:layout_width="0px"
            android:layout_height="match_parent"
            android:maxLines="3"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/edit"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:src="@drawable/ic_media_edit"
            android:layout_marginEnd="10dp"/>
        <include layout="@layout/drag_sort_drag_handle"/>
    </LinearLayout>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="#f2f2f2"
        android:gravity="center"
        android:id="@+id/mask"
        android:background="#0000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/post_image_inserted"
        android:shadowColor="#0000"
        android:shadowRadius="8"/>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.narvii.list.refresh.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:background="#fafafa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:background="#fff"
                android:layout_width="match_parent"
                android:layout_height="88dp">
                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginRight="5dp"
                        android:src="@drawable/amino_coin_big"
                        android:scaleType="fitCenter"
                        android:layout_marginEnd="5dp"/>
                    <TextView
                        android:textSize="32dp"
                        android:textStyle="bold"
                        android:textColor="#1a1a1a"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"/>
                </LinearLayout>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#b3b3b3"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/total_balance"/>
            </LinearLayout>
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:gravity="start"
                android:background="#fff"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/trend_in_last_days"/>
            <com.github.mmin18.widget.FlexLayout
                android:background="#f1f7fd"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.narvii.widget.histogram.HistogramView
                    android:id="@+id/histogram_view"
                    android:paddingLeft="20dp"
                    android:paddingTop="@dimen/histogramViewPaddingTop"
                    android:paddingRight="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="230dp"/>
                <com.narvii.util.layouts.NVFlowLayout
                    android:id="@+id/category_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    narvii:layout_top="histogram_view.bottom+5dp"/>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/empty_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    narvii:layout_centerX="histogram_view.centerX"
                    narvii:layout_centerY="histogram_view.centerY">
                    <ImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:src="@drawable/ic_retry"
                        android:scaleType="fitCenter"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#b9b9b9"
                        android:id="@+id/empty_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"/>
                </LinearLayout>
            </com.github.mmin18.widget.FlexLayout>
            <RelativeLayout
                android:background="#fff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="#1a1a1a"
                    android:id="@+id/lifetime_earning_coins"
                    android:padding="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:drawableLeft="@drawable/amino_coin_small"
                    android:drawablePadding="5dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentRight="true"
                    android:drawableStart="@drawable/amino_coin_small"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#666666"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/lifetime_earning"
                    android:padding="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lifetime_earnings"
                    android:layout_toLeftOf="@+id/lifetime_earning_coins"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:layout_toStartOf="@+id/lifetime_earning_coins"
                    android:layout_alignParentStart="true"/>
                <View
                    android:id="@+id/divider_line"
                    android:background="#fafafa"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="15dp"
                    android:layout_below="@+id/lifetime_earning"
                    android:layout_marginStart="15dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="#1a1a1a"
                    android:id="@+id/total_paid_coins"
                    android:padding="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:drawableLeft="@drawable/amino_coin_small"
                    android:drawablePadding="5dp"
                    android:layout_below="@+id/divider_line"
                    android:layout_alignParentRight="true"
                    android:drawableStart="@drawable/amino_coin_small"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#666666"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/total_paid"
                    android:padding="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/total_paid_out"
                    android:layout_toLeftOf="@+id/total_paid_coins"
                    android:layout_below="@+id/divider_line"
                    android:layout_alignParentLeft="true"
                    android:layout_toStartOf="@+id/total_paid_coins"
                    android:layout_alignParentStart="true"/>
            </RelativeLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.narvii.list.refresh.SwipeRefreshLayout>

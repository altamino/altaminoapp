<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto">
    <TextView
        android:text="@string/account_phone_number"
        narvii:layout_top="16dp"
        style="@style/account_edit_title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        narvii:layout_top="prev.bottom+6dp">
        <com.narvii.account.mobile.MyPhoneCountryCodePicker
            android:textSize="26dp"
            android:textColor="#fff"
            android:id="@+id/country_picker"
            android:background="@drawable/button_rect_transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:background="#fff"
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"/>
        <com.narvii.widget.ClearEditText
            android:textSize="26dp"
            android:textColor="#fff"
            android:textColorHint="#fff"
            android:gravity="center_vertical"
            android:id="@+id/edit"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:singleLine="true"
            android:layout_weight="1"
            android:inputType="phone"
            android:textCursorDrawable="@drawable/account_edit_cursor_white"/>
    </LinearLayout>
    <include layout="@layout/flexlayout_edit_line"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#000"
        android:id="@+id/input_error_hint"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/invalid_email"/>
</merge>

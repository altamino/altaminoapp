<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="#555"
        android:paddingTop="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/catalog_no_category_title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/empty_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <com.narvii.widget.FontAwesomeView
            android:textSize="16dp"
            android:textColor="@color/button_text_gray_w"
            android:gravity="center"
            android:padding="13dp"
            android:clickable="true"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="@string/fa_plus"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#555"
            android:gravity="center"
            android:paddingRight="36dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/catalog_no_category_hint"
            android:paddingEnd="36dp"/>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.github.mmin18.widget.FlexLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="#2c2d2c"
        android:ellipsize="end"
        android:id="@+id/title"
        android:tag="main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="4"
        app:layout_left="0"
        app:layout_right="feed_image1.left-8dp"/>
    <FrameLayout
        android:id="@+id/feed_image1"
        app:layout_height="parent.width*0.227"
        app:layout_right="100%"
        app:layout_width="33%">
        <com.narvii.widget.SecretImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:defaultDrawable="@color/placeholder"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#f2f2f2"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/feed_caption1"
            android:background="#0000"
            android:padding="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
    </FrameLayout>
</com.github.mmin18.widget.FlexLayout>

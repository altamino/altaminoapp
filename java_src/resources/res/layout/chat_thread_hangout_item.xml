<?xml version="1.0" encoding="utf-8"?>
<com.narvii.chat.thread.ThreadListItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/default_padding_horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    android:paddingStart="@dimen/default_padding_horizontal">
    <LinearLayout
        android:id="@+id/stub0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true">
        <include layout="@layout/rtc_indicator_container"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/stub1"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/stub0"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/stub0">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.narvii.widget.ThumbImageView
                android:id="@+id/image"
                android:layout_width="54dp"
                android:layout_height="42dp"
                narvii:defaultDrawable="@color/placeholder"
                narvii:imageType="chat-cover"
                narvii:strokeColor="#888"
                narvii:strokeWidth="0.5dp"/>
            <include layout="@layout/fans_only_content_indicator_layout_small"/>
        </FrameLayout>
        <TextView
            android:textSize="9dp"
            android:textColor="#aaa"
            android:id="@+id/chat_thread_public_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-6dp"
            android:layout_marginRight="-6dp"
            android:singleLine="true"
            android:layout_marginStart="-6dp"
            android:layout_marginEnd="-6dp"/>
    </LinearLayout>
    <View
        android:id="@+id/chat_thread_unread"
        android:background="@drawable/chat_thread_unread"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="-6dp"
        android:layout_marginRight="-2dp"
        android:layout_alignTop="@+id/stub1"
        android:layout_alignRight="@+id/stub1"
        android:layout_marginEnd="-2dp"
        android:layout_alignEnd="@+id/stub1"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#90ffffff"
        android:id="@+id/datetime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_alignTop="@+id/title"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="10dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="#222"
        android:id="@+id/title"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="8dp"
        android:singleLine="true"
        android:layout_toLeftOf="@+id/datetime"
        android:layout_toRightOf="@+id/stub1"
        android:layout_alignTop="@+id/image"
        android:layout_alignParentTop="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/datetime"
        android:layout_toEndOf="@+id/stub1"/>
    <include layout="@layout/chat_thread_content_bottom"/>
</com.narvii.chat.thread.ThreadListItem>

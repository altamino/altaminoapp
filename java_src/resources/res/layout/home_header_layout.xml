<?xml version="1.0" encoding="utf-8"?>
<com.narvii.amino.speeddial.SpeedDialHeaderLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/home_header_layout"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.narvii.widget.FakeHeightViewWrapper
        android:id="@+id/fake_height_view_wrapper"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:fake_height="@dimen/speed_dial_header_shadow_height">
        <View
            android:layout_gravity="bottom"
            android:id="@+id/header_main_content_bg"
            android:tag="fakeHeight"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
        <LinearLayout
            android:gravity="bottom"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/header_main_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.narvii.list.overlay.OverlayListPlaceholder
                android:id="@+id/fake_action_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp">
                <com.narvii.widget.CommunityIconView
                    android:layout_gravity="center"
                    android:id="@+id/community_icon"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    app:defaultDrawable="@drawable/placeholder_community_big"
                    app:imageType="community-icon"
                    app:shadowColor="#0000"
                    app:shadowOffsetY="1dp"
                    app:shadowSize="1dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_weight="1"
                    android:layout_marginStart="15dp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.narvii.widget.AutoSizingTextView
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#fff"
                            android:ellipsize="end"
                            android:id="@+id/community_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="40dp"
                            android:maxLines="2"
                            android:includeFontPadding="false"
                            android:shadowColor="#0000"
                            android:shadowDy="1"
                            android:shadowRadius="5"
                            android:lineSpacingExtra="0dp"
                            android:layout_marginEnd="15dp"
                            app:autoSizeTextMaxSize="22dp"
                            app:autoSizeTextMinSize="14dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_goneMarginEnd="0dp"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <LinearLayout
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:id="@+id/member_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="25dp">
                        <com.narvii.widget.AutoSizingTextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@+id/member_count"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:maxWidth="100dp"
                            android:maxLines="1"
                            android:layout_weight="1"
                            app:autoSizeTextMaxSize="16dp"
                            app:autoSizeTextMinSize="10dp"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:id="@+id/member_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/white"
                            android:id="@+id/leaderboard"
                            android:background="@drawable/button_round_leaderboard"
                            android:paddingLeft="5dp"
                            android:paddingTop="2dp"
                            android:paddingRight="5dp"
                            android:paddingBottom="2dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/page_leaderboards"
                            android:drawablePadding="5dp"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:layout_marginStart="8dp"
                            app:drawableStartCompat="@drawable/ic_leaderboard_logo"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/live_marquee_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="150dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:id="@+id/live_marquee_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/tmg_live_and_trending"
                        android:lines="1"
                        android:textAllCaps="true"
                        android:layout_marginStart="15dp"/>
                    <FrameLayout
                        android:layout_gravity="bottom"
                        android:id="@+id/live_marquee_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"/>
                </LinearLayout>
            </FrameLayout>
            <RelativeLayout
                android:id="@+id/checkin_module"
                android:background="#33000000"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginBottom="10dp">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/check_in_streak_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_centerInParent="true">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/check_in_to_earn_the_surprize"
                        android:lines="1"/>
                    <com.narvii.checkin.CheckInStreakBar
                        android:id="@+id/check_in_streak_bar"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="250dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        app:childMaxSize="20dp"
                        app:circleSize="12dp"/>
                    <com.narvii.widget.PushButton
                        android:id="@+id/checkin_button"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginTop="8dp"
                        android:minWidth="110dp"
                        app:pushButtonColor="#52d127"
                        app:pushButtonLift="3dp"
                        app:pushShadowAlpha="0.5">
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#fff"
                            android:layout_gravity="center"
                            android:id="@+id/checkin_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/check_in"/>
                        <ProgressBar
                            android:layout_gravity="center"
                            android:id="@+id/checkin_progress"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="2dp"
                            style="?android:attr/progressBarStyle"/>
                    </com.narvii.widget.PushButton>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/check_in_success_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_centerInParent="true">
                    <FrameLayout
                        android:layout_gravity="center"
                        android:id="@+id/follow_success_layout"
                        android:background="@drawable/button_round_follow_checked_radius_20"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_margin="10dp"
                            android:src="@drawable/ic_white_check"/>
                    </FrameLayout>
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/donw_see_you_tomorrow"/>
                </LinearLayout>
                <com.narvii.widget.TintButton
                    android:id="@+id/checkin_close"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/share_close"
                    android:layout_alignParentEnd="true"
                    app:tintColor="#80ffffff"/>
            </RelativeLayout>
            <com.narvii.amino.speeddial.SpeedDialRecycleView
                android:id="@+id/speed_recycle"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="@dimen/speed_dial_live_item_height"
                android:layout_marginBottom="5dp"
                android:paddingStart="10dp"
                android:paddingEnd="0dp"/>
            <ai.medialab.medialabads2.banners.MediaLabAdView
                android:layout_gravity="center"
                android:id="@+id/ad_item_rectangle"
                android:visibility="gone"
                android:layout_width="300dp"
                android:layout_height="250dp"/>
        </LinearLayout>
    </com.narvii.widget.FakeHeightViewWrapper>
    <LinearLayout
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/add_sr"
            android:background="@drawable/selector_actvite_green_round"
            android:layout_width="0px"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:text="+SR"
            android:layout_weight="1"/>
        <TextView
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/remove_sr"
            android:background="@drawable/selector_actvite_green_round"
            android:layout_width="0px"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:text="-SR"
            android:layout_weight="1"/>
    </LinearLayout>
</com.narvii.amino.speeddial.SpeedDialHeaderLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="65dp"
        android:layout_height="65dp">
        <include
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/user_avatar_layout_mini"/>
        <com.narvii.widget.CircleImageView
            android:id="@+id/avatar_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            narvii:cornerRadius="1000dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/recommend_check"
            android:layout_width="17dp"
            android:layout_height="14dp"
            android:src="@drawable/recommend_follow_check"/>
        <com.narvii.widget.SpinningView
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:layout_width="20dp"
            android:layout_height="20dp"
            narvii:spinColor="#eee"
            narvii:spinSize="20dp"
            narvii:spinStyle="2"/>
    </FrameLayout>
    <com.narvii.widget.NicknameView
        android:textSize="11dp"
        android:textColor="#666"
        android:layout_gravity="center_horizontal"
        android:id="@+id/nickname"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        narvii:hideMembershipBadge="true"
        narvii:hideRole="true"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#fff"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/role"
        android:background="@drawable/role_bg_default"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:singleLine="true"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"/>
</LinearLayout>

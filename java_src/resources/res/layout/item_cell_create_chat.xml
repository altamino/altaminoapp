<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:background="@drawable/click_color_transparent"
    android:paddingLeft="17dp"
    android:paddingRight="17dp"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <com.narvii.widget.RadiusLayout
        android:layout_width="54dp"
        android:layout_height="42dp"
        android:alpha="0.6"
        app:layout_corner_radius="5dp"
        app:radius_stroke_color="#fff"
        app:radius_stroke_dash_gap_width="2dp"
        app:radius_stroke_dash_width="2dp"
        app:radius_stroke_width="2dp">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:src="@drawable/follow_plus"/>
    </com.narvii.widget.RadiusLayout>
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="#99ffffff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="13dp"
        android:text="@string/create_a_new_chat"
        android:layout_marginStart="13dp"/>
</LinearLayout>

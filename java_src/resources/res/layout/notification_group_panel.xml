<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#19ffffff"
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="110dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/group_follow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.narvii.widget.NVImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_notification_group_follow"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/user_followers"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/group_vote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.narvii.widget.NVImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_notification_group_vote"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/likes"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/group_comment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.narvii.widget.NVImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_notification_group_comment"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/comments"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

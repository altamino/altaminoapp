<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/default_section_color"
    android:paddingLeft="@dimen/default_padding_horizontal"
    android:paddingTop="6dp"
    android:paddingRight="0dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/default_padding_horizontal"
    android:paddingEnd="0dp">
    <TextView
        android:textSize="@dimen/community_search_section_text_size"
        android:textColor="#ffff"
        android:id="@+id/pre_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>

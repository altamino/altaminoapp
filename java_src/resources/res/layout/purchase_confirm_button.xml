<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/confirm_button_container"
        android:background="@drawable/selector_subscribe_green"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/confirm_button_loading"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="10dp"
                android:src="@drawable/ic_loading_circle"
                android:layout_marginEnd="10dp"/>
            <ImageView
                android:id="@+id/confirm_button_coin"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="10dp"
                android:src="@drawable/amino_coin_small"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/confirm_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/confirm"/>
        </LinearLayout>
    </FrameLayout>
</merge>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.list.overlay.OverlayListPlaceholder
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.narvii.scene.view.PlayerContainerLayout
            android:layout_gravity="center"
            android:id="@+id/player_container"
            android:background="@android:color/black"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <com.narvii.scene.view.ScenePreviewLayout
                android:id="@+id/preview_layout"
                android:background="@android:color/black"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:keepScreenOn="true"/>
            <ImageView
                android:id="@+id/video_play_button"
                android:visibility="visible"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_sr_media_play"
                android:layout_centerInParent="true"/>
        </com.narvii.scene.view.PlayerContainerLayout>
    </FrameLayout>
    <com.narvii.scene.view.EditSceneBGMLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/edit_scene_BGM_Layout"
        android:background="@android:color/black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp">
        <com.narvii.scene.view.AudioOptionPanel
            android:id="@+id/options_panel"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_margin="10dp"/>
        <com.narvii.video.widget.MediaTimeLineComponent
            android:id="@+id/video_time_line_component"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/video_editor_time_line_item_height"
            android:layout_marginTop="8dp"
            narvii:controllerHandlerWidth="@dimen/video_editor_controller_handler_width_small"
            narvii:frameCountInBaseRect="10"
            narvii:frameCountInHighlightRect="8">
            <com.narvii.widget.HorizontalRecyclerView
                android:id="@+id/video_time_line"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/media_retrieve_controller_text_size"/>
            <com.narvii.video.widget.MediaRetrieveController
                android:id="@+id/retrieve_controller"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.narvii.video.widget.MediaTimeLineComponent>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:textSize="12dp"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:text="@string/balance"
                android:layout_marginEnd="12dp"/>
            <com.narvii.widget.TintButton
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_volume_high_white"
                narvii:tintColor="@android:color/white"/>
            <com.narvii.scene.view.BalanceSeekBar
                android:id="@+id/balance_seek_bar"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="10dp"
                android:layout_weight="1"/>
            <com.narvii.widget.TintButton
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_music"
                narvii:tintColor="@android:color/white"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="25dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/selector_fade_in_and_out_text_color"
                android:id="@+id/fade_in_view"
                android:background="@drawable/selector_fade_in_and_out_bg"
                android:paddingLeft="12dp"
                android:paddingTop="7dp"
                android:paddingRight="12dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:text="@string/fade_in"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/selector_fade_in_and_out_text_color"
                android:id="@+id/fade_out_view"
                android:background="@drawable/selector_fade_in_and_out_bg"
                android:paddingLeft="12dp"
                android:paddingTop="7dp"
                android:paddingRight="12dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:text="@string/fade_out"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="6dp"/>
        </LinearLayout>
    </com.narvii.scene.view.EditSceneBGMLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#130e43"
    android:paddingLeft="72px"
    android:paddingRight="72px"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="720px"
    android:layout_height="1280px">
    <com.narvii.widget.ThumbImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/author_bg_user_avatar"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="160px"
        android:layout_height="160px"
        android:layout_marginTop="260px"
        android:scaleType="fitCenter"
        app:cornerRadius="1000dp"
        app:defaultDrawable="@drawable/user_avatar_placeholder"
        app:groundingColor="@color/user_avatar_placeholder"
        app:strokeColor="#ffffff"
        app:strokeWidth="1dp"/>
    <TextView
        android:textSize="48px"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:id="@+id/author_bg_user_name"
        android:layout_width="wrap_content"
        android:layout_height="70px"
        android:layout_marginTop="20px"
        android:maxLines="1"
        android:singleLine="true"/>
    <TextView
        android:textSize="24px"
        android:textColor="#99ffffff"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:id="@+id/author_bg_community_name_or_amino_id"
        android:layout_width="wrap_content"
        android:layout_height="36px"
        android:maxLines="1"
        android:singleLine="true"/>
    <TextView
        android:textSize="24px"
        android:textColor="#99ffffff"
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/author_bg_community_amino_id"
        android:background="@drawable/watermark_community_id_bg"
        android:paddingLeft="8px"
        android:paddingTop="5px"
        android:paddingRight="8px"
        android:paddingBottom="5px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15px"
        android:maxLines="1"
        android:singleLine="true"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="244px"
        android:layout_height="167px"
        android:layout_marginTop="360px"
        android:src="@drawable/watermark_creator_logo"
        android:scaleType="fitCenter"/>
</LinearLayout>

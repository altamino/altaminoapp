<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="15dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/source_view_container"
        android:background="#ecf0f5"
        android:layout_width="match_parent"
        android:layout_height="36dp">
        <include
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            layout="@layout/sticker_pack_item_author_layout"/>
    </FrameLayout>
    <com.narvii.monetization.utils.StoreItemNameView
        android:textSize="20dp"
        android:id="@+id/sticker_collection_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/author_layout"
        android:paddingLeft="16dp"
        android:paddingTop="2dp"
        android:paddingRight="16dp"
        android:paddingBottom="2dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12dp"
            android:textColor="#b9b9b9"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:text="@string/submitted_by"
            android:layout_marginEnd="5dp"/>
        <include
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            layout="@layout/user_avatar_layout_mini_nobadge"/>
        <com.narvii.widget.NicknameView
            android:textSize="12dp"
            android:textColor="#4a90e2"
            android:id="@+id/nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginStart="2dp"
            app:hideRole="true"/>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="#717379"
        android:gravity="center_horizontal"
        android:id="@+id/collection_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="16dp"/>
    <com.narvii.monetization.StoreItemStatusView
        android:layout_gravity="center_horizontal"
        android:id="@+id/store_item_status_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#717379"
        android:id="@+id/used_times"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="16dp"
        android:singleLine="true"/>
</LinearLayout>

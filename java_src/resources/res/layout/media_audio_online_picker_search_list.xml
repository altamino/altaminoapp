<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#1b1b21"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.widget.SearchBar
        android:id="@+id/search_bar"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="54dp">
        <com.narvii.widget.TintButton
            android:id="@+id/search_back"
            android:background="@drawable/button_rect_transparent_dark"
            android:paddingLeft="8dp"
            android:paddingRight="0dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="-12dp"
            android:src="@drawable/ic_back_mirror"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:paddingStart="8dp"
            android:paddingEnd="0dp"
            android:layout_marginEnd="-12dp"
            android:layout_alignParentStart="true"/>
        <View
            android:background="@drawable/online_audio_search_bg"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginLeft="12dp"
            android:layout_toLeftOf="@+id/search_cancel"
            android:layout_toRightOf="@+id/search_back"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toStartOf="@+id/search_cancel"
            android:layout_toEndOf="@+id/search_back"/>
        <Button
            android:textSize="16dp"
            android:textColor="#ffff"
            android:id="@+id/search_cancel"
            android:background="@drawable/button_rect_transparent_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
        <com.narvii.widget.TintButton
            android:gravity="center"
            android:id="@+id/search_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="20dp"
            android:src="@drawable/ic_searchr"
            android:scaleType="centerInside"
            android:layout_toRightOf="@+id/search_back"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"
            android:layout_toEndOf="@+id/search_back"
            app:tintColor="#d6d6d6"/>
        <EditText
            android:textSize="14dp"
            android:textColor="#fff"
            android:textColorHint="#ffff"
            android:ellipsize="end"
            android:id="@+id/search_text"
            android:background="@null"
            android:paddingLeft="10dp"
            android:paddingRight="30dp"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:hint="@string/search"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/search_cancel"
            android:layout_toRightOf="@+id/search_icon"
            android:layout_centerVertical="true"
            android:inputType="textCapSentences"
            android:imeOptions="actionSearch"
            android:textCursorDrawable="@drawable/edit_cursor_white_normal"
            android:paddingStart="10dp"
            android:paddingEnd="30dp"
            android:layout_toStartOf="@+id/search_cancel"
            android:layout_toEndOf="@+id/search_icon"/>
        <com.narvii.widget.FontAwesomeView
            android:textColor="#d4d3db"
            android:gravity="center_vertical"
            android:id="@+id/search_clear"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="-26dp"
            android:text="@string/ion_close_circled"
            android:layout_toRightOf="@+id/search_text"
            android:layout_centerVertical="true"
            android:layout_marginStart="-26dp"
            android:layout_toEndOf="@+id/search_text"/>
    </com.narvii.widget.SearchBar>
    <include layout="@layout/media_audio_online_picker_list"/>
</LinearLayout>

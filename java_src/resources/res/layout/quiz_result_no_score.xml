<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="18dp"
        android:textColor="#fff"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/have_no_score"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/quiz_play_layout"
        android:background="@drawable/button_quizzes_play"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="10dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_quiz_no_score_play"/>
        <TextView
            android:textSize="25dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/play_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/start_quiz"
            android:maxLines="1"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/share_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp">
        <com.narvii.widget.EmojioneView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="2dp"
            android:layout_marginEnd="2dp"
            app:emojiShortName="love_letter"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/tapable_text_color"
            android:id="@+id/share"
            android:background="@drawable/button_rect_transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tell_friend"/>
        <com.narvii.widget.EmojioneView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="2dp"
            android:layout_marginStart="2dp"
            app:emojiShortName="love_letter"/>
    </LinearLayout>
</LinearLayout>

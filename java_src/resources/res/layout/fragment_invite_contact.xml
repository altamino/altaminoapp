<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.widget.SearchBar
        android:id="@+id/search"
        android:background="@color/color_default"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textSize="16dp"
            android:textColor="#222"
            android:textColorHint="@color/hint_color"
            android:id="@+id/search_text"
            android:background="@drawable/search_bg"
            android:paddingLeft="36dp"
            android:paddingRight="32dp"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_margin="8dp"
            android:hint="@string/search"
            android:layout_centerVertical="true"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:paddingStart="36dp"
            android:paddingEnd="32dp"/>
        <ImageView
            android:gravity="center"
            android:padding="8dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/icon_search"
            android:layout_alignLeft="@+id/search_text"
            android:layout_centerVertical="true"
            android:layout_alignStart="@+id/search_text"/>
        <com.narvii.widget.FontAwesomeView
            android:textSize="16dp"
            android:textColor="#aaa"
            android:gravity="center"
            android:id="@+id/search_clear"
            android:padding="8dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="@string/fa_times_circle"
            android:layout_alignRight="@+id/search_text"
            android:layout_centerVertical="true"
            android:layout_alignEnd="@+id/search_text"/>
    </com.narvii.widget.SearchBar>
    <TextView
        android:textStyle="bold"
        android:textColor="#fff"
        android:id="@+id/final_step"
        android:background="#0076ff"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"/>
    <include layout="@layout/item_invite_contact_invitee"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/list_layout"/>
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/send"
            android:background="@drawable/radius_green"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"/>
    </FrameLayout>
</LinearLayout>

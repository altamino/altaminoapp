<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:id="@+id/favorites"
    android:paddingBottom="14dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/user_collection"
        android:background="@drawable/button_rect_transparent"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentTop="true">
        <TextView
            android:textSize="15dp"
            android:textColor="#888"
            android:id="@+id/user_collection_n"
            android:paddingLeft="10dp"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"
            android:paddingStart="10dp"/>
        <com.narvii.widget.TintButton
            android:gravity="center"
            android:id="@+id/user_collection_chevron"
            android:layout_width="10dp"
            android:layout_height="15dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/chevron_right_mirror"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            narvii:tintColor="#888"/>
    </LinearLayout>
    <com.narvii.user.profile.UserFavoriteGallery
        android:id="@+id/pager"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_below="@+id/user_collection"/>
    <com.narvii.widget.SpinningView
        android:id="@+id/user_loading_collection"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_card_height"
        android:layout_alignTop="@+id/pager"
        narvii:spinSize="@dimen/spin_middle_size"/>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="#aaa"
        android:gravity="center"
        android:id="@+id/user_no_collection"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_card_height"
        android:text="@string/user_no_collection"
        android:layout_alignTop="@+id/pager"/>
</RelativeLayout>

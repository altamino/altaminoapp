<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <com.narvii.widget.ThumbImageView
        android:id="@+id/icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        narvii:defaultDrawable="@color/album_cover_placeholder"
        narvii:imageType="shared-folder-image"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:layout_weight="1">
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="#222"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#222"
            android:id="@+id/text2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
    </LinearLayout>
    <include layout="@layout/drag_sort_drag_handle"/>
</LinearLayout>

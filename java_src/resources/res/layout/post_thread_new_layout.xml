<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/chat_bg_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:tag="resizeTarget"
        android:background="#66000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.narvii.list.overlay.OverlayListPlaceholder
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.narvii.widget.NVScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:layout_weight="0.9">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/root"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:background="@drawable/chat_cover_new_bg"
                    android:layout_width="match_parent"
                    android:layout_height="172dp"
                    android:layout_marginTop="20dp">
                    <com.narvii.widget.ThumbImageView
                        android:id="@+id/image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:imageType="chat-cover"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#f2f2f2"
                        android:layout_gravity="center"
                        android:id="@+id/cover_image_hint"
                        android:background="@drawable/bg_rect_black_10_corner"
                        android:padding="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/post_thread_change_cover"/>
                    <LinearLayout
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/add_cover_image_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center_horizontal"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginBottom="10dp"
                            android:src="@drawable/ic_post_photo_add"/>
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#f2f2f2"
                            android:layout_gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/post_thread_cover"/>
                    </LinearLayout>
                </FrameLayout>
                <EditText
                    android:textSize="16dp"
                    android:textColor="#f2f2f2"
                    android:textColorHint="#ccf2f2f2"
                    android:gravity="start|center_vertical"
                    android:id="@+id/title"
                    android:background="@drawable/rtc_post_bg_round"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="32dp"
                    android:hint="@string/post_title"
                    android:singleLine="true"
                    android:inputType="textCapSentences"
                    android:textCursorDrawable="@drawable/account_edit_cursor_white"/>
                <com.narvii.widget.EditTextIMG
                    android:textSize="16dp"
                    android:textColor="#f2f2f2"
                    android:textColorHint="#ccf2f2f2"
                    android:gravity="start|top"
                    android:id="@+id/content"
                    android:background="@drawable/rtc_post_bg_round"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="@string/welcome_message_hint"
                    android:minLines="6"
                    android:maxLength="65535"
                    android:inputType="textMultiLine"
                    android:textCursorDrawable="@drawable/account_edit_cursor_white"/>
                <FrameLayout
                    android:id="@+id/topic_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:textSize="20dp"
                        android:textColor="#80ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="#"/>
                    <com.narvii.util.layouts.NVFlowLayout
                        android:id="@+id/topic_parent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginStart="16dp"
                        app:flow_gravity="-1"/>
                </FrameLayout>
                <com.narvii.chat.ChatBackgroundPickerRecycler
                    android:id="@+id/chat_background_picker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:overScrollMode="never"/>
                <View
                    android:background="#ffff"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#e5e5e5"
                    android:gravity="center_horizontal"
                    android:id="@+id/chat_show_guideline"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="80dp"
                    android:text="@string/post_thread_guidelines"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="80dp"/>
            </LinearLayout>
        </com.narvii.widget.NVScrollView>
    </LinearLayout>
</FrameLayout>

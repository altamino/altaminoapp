<?xml version="1.0" encoding="utf-8"?>
<com.github.mmin18.widget.FlexLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reputation_gained_layout"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.github.mmin18.widget.FlexLayout
        android:id="@+id/main_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_height="wrap_content"
        app:layout_centerX="50%"
        app:layout_top="30%"
        app:layout_width="parent.width*0.75">
        <com.narvii.widget.ThumbImageView
            android:layout_width="match_parent"
            app:cornerRadius="10dp"
            app:defaultDrawable="@android:color/transparent"
            app:layout_height="main.height"
            app:shadowColor="#0000"
            app:shadowOffsetX="2dp"
            app:shadowOffsetY="2dp"
            app:shadowSize="2dp"/>
        <com.narvii.widget.RoundedRealtimeBlurView
            android:layout_width="match_parent"
            app:blurCornerRadius="10dp"
            app:layout_height="main.height"
            app:realtimeOverlayColor="@color/real_time_blur_bg"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/main"
            android:paddingTop="50dp"
            android:paddingBottom="20dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="17dp"
                android:textColor="#fff"
                android:gravity="center"
                android:id="@+id/reputation_gained"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#fff"
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.narvii.widget.ExactRankingTitleView
                android:id="@+id/ranking_title_view"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                app:showReputation="true"/>
        </LinearLayout>
    </com.github.mmin18.widget.FlexLayout>
    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_reputation_gained"
        app:layout_centerX="50%"
        app:layout_centerY="30%"/>
    <com.narvii.widget.StrokedTextView
        android:textSize="25dp"
        android:id="@+id/rp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_centerX="50%"
        app:layout_centerY="30%"
        app:st_strokeColor="@color/stroke_color"/>
</com.github.mmin18.widget.FlexLayout>

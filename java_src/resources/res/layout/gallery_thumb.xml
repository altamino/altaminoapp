<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:padding="2dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.narvii.widget.ThumbImageView
        android:id="@+id/image"
        android:layout_width="160dp"
        android:layout_height="140dp"
        narvii:defaultDrawable="@color/placeholder"/>
    <TextView
        android:textSize="11dp"
        android:textColor="#f8f8f8"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/text"
        android:background="#0000"
        android:padding="1dp"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:maxLines="2"/>
</FrameLayout>

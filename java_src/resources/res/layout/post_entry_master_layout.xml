<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:id="@+id/post_entry_dialog"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="#0000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.narvii.post.entry.PostEntrySnakeLayout
        android:id="@+id/post_snake_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_above="@+id/community_container">
        <com.narvii.widget.RoundedRealtimeBlurView
            android:layout_gravity="bottom"
            android:id="@+id/background_1"
            android:tag="@string/entry_bg_tag"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            narvii:blurCornerRadius="10dp"
            narvii:realtimeBlurRadius="100dp"
            narvii:realtimeOverlayColor="#4b000000"/>
    </com.narvii.post.entry.PostEntrySnakeLayout>
    <RelativeLayout
        android:id="@+id/community_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_above="@+id/post_entry_dismiss">
        <FrameLayout
            android:id="@+id/background"
            android:background="@drawable/post_entry_master_community_bg"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <com.narvii.widget.TintButton
                android:layout_gravity="center_vertical"
                android:background="@drawable/post_entry_master_add_community_bg"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/chat_plus"
                android:scaleType="centerInside"/>
            <com.narvii.widget.AutoSizingTextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="@string/create_your_community"
                android:maxLines="1"
                android:textAllCaps="true"
                android:layout_marginStart="12dp"
                narvii:autoSizeTextMaxSize="14dp"
                narvii:autoSizeTextMinSize="8dp"
                narvii:textAllCaps="false"/>
        </LinearLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/post_entry_dismiss"
        android:padding="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <com.narvii.widget.ThumbImageView
            android:layout_gravity="center"
            android:id="@+id/post_entry_btn2"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:layout_marginBottom="2dp"
            narvii:cornerRadius="16dp"
            narvii:shadowColor="#0000"
            narvii:shadowSize="4dp"/>
        <com.narvii.widget.TintButton
            android:layout_gravity="center"
            android:id="@+id/post_entry_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginBottom="2dp"/>
    </FrameLayout>
</RelativeLayout>

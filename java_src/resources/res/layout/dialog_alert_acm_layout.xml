<?xml version="1.0" encoding="utf-8"?>
<com.github.mmin18.widget.FlexLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="#0000"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/dialog_listview_round"
        android:clipChildren="false"
        android:clipToPadding="false"
        narvii:layout_centerX="50%"
        narvii:layout_centerY="50%"
        narvii:layout_height="wrap_content"
        narvii:layout_width="parent.width*0.8">
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="#000"
            android:gravity="center"
            android:id="@+id/alert_dialog_title"
            android:paddingLeft="30dp"
            android:paddingTop="15dp"
            android:paddingRight="30dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#363636"
            android:gravity="center"
            android:id="@+id/alert_dialog_message"
            android:paddingLeft="15dp"
            android:paddingTop="20dp"
            android:paddingRight="10dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="20"
            android:paddingStart="15dp"
            android:paddingEnd="10dp"/>
        <include layout="@layout/list_divider"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/alert_dialog_buttons"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"/>
    </LinearLayout>
</com.github.mmin18.widget.FlexLayout>

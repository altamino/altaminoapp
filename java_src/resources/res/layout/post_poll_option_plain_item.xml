<?xml version="1.0" encoding="utf-8"?>
<com.narvii.widget.SwipeToDeleteLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/post_poll_option"
    android:layout_width="match_parent"
    android:layout_height="50dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/post_quiz_question_bg"
        android:layout_width="match_parent"
        android:layout_height="46dp">
        <com.narvii.widget.FullHitFrameLayout
            android:paddingLeft="6dp"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:paddingStart="6dp">
            <com.narvii.widget.ThumbImageView
                android:layout_gravity="center"
                android:id="@+id/poll_opt_image"
                android:layout_width="26dp"
                android:layout_height="26dp"
                app:defaultDrawable="@drawable/post_quiz_question_placeholder"
                app:strokeColor="#ccc"
                app:strokeWidth="0.5dp"/>
        </com.narvii.widget.FullHitFrameLayout>
        <EditText
            android:textSize="15dp"
            android:textColor="#333"
            android:textColorHint="#ccc"
            android:gravity="center_vertical"
            android:id="@+id/poll_opt_title"
            android:background="@null"
            android:layout_width="0px"
            android:layout_height="match_parent"
            android:layout_marginRight="10dp"
            android:singleLine="true"
            android:maxLength="30"
            android:layout_weight="1"
            android:inputType="textCapSentences"
            android:layout_marginEnd="10dp"/>
    </LinearLayout>
    <TextView
        android:textSize="11dp"
        android:textColor="#aaa"
        android:layout_gravity="end|bottom"
        android:id="@+id/post_poll_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="2dp"
        android:layout_marginEnd="4dp"/>
    <Button
        android:textSize="14dp"
        android:textColor="#fff"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/delete"
        android:background="@drawable/swipe_to_delete_btn"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:text="@string/delete"/>
</com.narvii.widget.SwipeToDeleteLayout>

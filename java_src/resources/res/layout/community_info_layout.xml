<?xml version="1.0" encoding="utf-8"?>
<com.narvii.community.widget.CommunitySummaryInfoLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/community_icon_name"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginRight="6dp"
        android:layout_weight="1"
        android:layout_marginEnd="6dp">
        <com.narvii.widget.ThumbImageView
            android:id="@+id/community_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:cornerRadius="3dp"
            app:defaultDrawable="@drawable/placeholder_community"
            app:imageType="community-icon"
            app:scalePlaceholder="true"/>
        <com.narvii.widget.ShrinkLayout
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginStart="4dp">
            <TextView
                android:textSize="13dp"
                android:textStyle="bold"
                android:textColor="#ffff"
                android:ellipsize="end"
                android:id="@+id/community_name"
                android:tag="shrink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#ffff"
                android:id="@+id/feed_date_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp"/>
        </com.narvii.widget.ShrinkLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/member_info_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/online_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#38d89c"
            android:id="@+id/membersInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:singleLine="true"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</com.narvii.community.widget.CommunitySummaryInfoLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="0px"
    android:layout_height="130dp"
    android:layout_weight="1">
    <com.narvii.widget.ThumbImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shadowColor="#f5a623"
        app:shadowOffsetX="0px"
        app:shadowOffsetY="2dp"
        app:shadowSize="5dp"
        app:strokeColor="#f5a623"
        app:strokeWidth="2dp"/>
    <View
        android:id="@+id/top_shadow"
        android:background="@drawable/membership_subscribe_top_shadow"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:layout_marginLeft="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginRight="1dp"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="32dp"
            android:textStyle="bold"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:gravity="center_horizontal"
            android:id="@+id/text2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <TextView
            android:textSize="12dp"
            android:id="@+id/saved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:textSize="11dp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/badge"
        android:background="@drawable/membership_subscribe_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-10dp"
        android:minWidth="106dp"
        android:singleLine="true"
        android:textAllCaps="true"/>
</FrameLayout>

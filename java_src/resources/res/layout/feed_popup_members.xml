<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/feed_member1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginLeft="4dp"
        android:layout_marginStart="4dp">
        <com.narvii.widget.ThumbImageView
            android:id="@+id/avatar_1"
            android:tag="@string/avatar_tag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/AvatarImageView"/>
        <com.narvii.widget.VoteIcon
            android:layout_gravity="end|bottom"
            android:id="@+id/icon_1"
            android:tag="@string/icon_tag"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="-4dp"
            android:layout_marginBottom="-2dp"
            android:layout_marginEnd="-4dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/feed_member2"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginLeft="4dp"
        android:layout_marginStart="4dp">
        <com.narvii.widget.ThumbImageView
            android:id="@+id/avatar_2"
            android:tag="@string/avatar_tag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/AvatarImageView"/>
        <com.narvii.widget.VoteIcon
            android:layout_gravity="end|bottom"
            android:id="@+id/icon_2"
            android:tag="@string/icon_tag"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="-4dp"
            android:layout_marginBottom="-2dp"
            android:layout_marginEnd="-4dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/feed_member3"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginLeft="4dp"
        android:layout_marginStart="4dp">
        <com.narvii.widget.ThumbImageView
            android:id="@+id/avatar_3"
            android:tag="@string/avatar_tag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/AvatarImageView"/>
        <com.narvii.widget.VoteIcon
            android:layout_gravity="end|bottom"
            android:id="@+id/icon_3"
            android:tag="@string/icon_tag"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="-4dp"
            android:layout_marginBottom="-2dp"
            android:layout_marginEnd="-4dp"/>
        <com.narvii.widget.SpinningView
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            narvii:spinColor="#888"
            narvii:spinSize="@dimen/spin_tiny_size"
            narvii:spinStyle="2"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/feed_member4"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginLeft="4dp"
        android:layout_marginStart="4dp">
        <com.narvii.widget.ThumbImageView
            android:id="@+id/avatar_4"
            android:tag="@string/avatar_tag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/AvatarImageView"/>
        <com.narvii.widget.VoteIcon
            android:layout_gravity="end|bottom"
            android:id="@+id/icon_4"
            android:tag="@string/icon_tag"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="-4dp"
            android:layout_marginBottom="-2dp"
            android:layout_marginEnd="-4dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/feed_member5"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp">
        <com.narvii.widget.ThumbImageView
            android:id="@+id/avatar_5"
            android:tag="@string/avatar_tag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/AvatarImageView"/>
        <com.narvii.widget.FontAwesomeView
            android:textSize="6dp"
            android:textColor="#ffff"
            android:gravity="center"
            android:id="@+id/more"
            android:background="@drawable/oval_mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/fa_circle_3"/>
        <com.narvii.widget.VoteIcon
            android:layout_gravity="end|bottom"
            android:id="@+id/icon_5"
            android:tag="@string/icon_tag"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="-4dp"
            android:layout_marginBottom="-2dp"
            android:layout_marginEnd="-4dp"/>
    </FrameLayout>
</LinearLayout>

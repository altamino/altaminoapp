<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/link_preview"
    android:background="@drawable/round_grey"
    android:paddingRight="10dp"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:layout_alignParentRight="true"
    android:layout_alignParentBottom="true"
    android:paddingEnd="10dp"
    android:layout_alignParentEnd="true">
    <com.narvii.widget.ThumbImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.narvii.widget.ThumbImageView
        android:id="@+id/link_icon"
        android:padding="6dp"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="#444"
        android:ellipsize="end"
        android:id="@+id/link_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="6dp"
        android:singleLine="true"
        android:layout_toRightOf="@+id/link_icon"
        android:layout_alignParentTop="true"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_toEndOf="@+id/link_icon"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#333"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/link_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        android:maxLines="2"
        android:layout_toRightOf="@+id/link_icon"
        android:layout_below="@+id/link_title"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_toEndOf="@+id/link_icon"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/link_icon"
        android:layout_below="@+id/link_description"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:layout_toEndOf="@+id/link_icon">
        <com.narvii.widget.ThumbImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/snippet_favicon"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:scaleType="centerInside"
            app:defaultDrawable="@drawable/favicon_default_s"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#888"
            android:layout_gravity="center_vertical"
            android:id="@+id/snippet_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:maxLines="1"
            android:singleLine="true"
            android:textAllCaps="true"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</RelativeLayout>

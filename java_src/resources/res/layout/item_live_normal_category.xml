<?xml version="1.0" encoding="utf-8"?>
<com.narvii.amino.speeddial.LiveCategoryItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:id="@+id/normal_item"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="80dp"
    android:layout_height="@dimen/speed_dial_live_item_height"
    android:layout_marginRight="10dp"
    android:layout_marginEnd="10dp">
    <com.narvii.widget.ThumbImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        narvii:cornerRadius="8dp"
        narvii:defaultDrawable="@color/speed_dial_live_category_item_bg"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.narvii.widget.NVImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/live_indicator"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="5dp"
            android:scaleType="fitCenter"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="2"
            android:shadowColor="#000"
            android:shadowRadius="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/active_member_container"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/oval_green"/>
            <TextView
                android:textSize="10dp"
                android:textColor="#fff"
                android:layout_gravity="center_vertical"
                android:id="@+id/member_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:maxLength="6"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>
</com.narvii.amino.speeddial.LiveCategoryItemView>

        android:background="@drawable/button_rect_transparent"
        android:layout_width="0px"
        android:layout_height="44dp"
        android:text="@string/see_all_contributors"
        android:layout_toRightOf="@+id/stub1"
        android:layout_below="@+id/contributor3"
        android:layout_alignParentRight="true"
        android:layout_toEndOf="@+id/stub1"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#888"
        android:gravity="center"
        android:id="@+id/retry"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="@string/normal_error"
        android:layout_below="@+id/text"/>
    <com.narvii.widget.SpinningView
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_below="@+id/text"
        narvii:spinSize="@dimen/spin_small_size"/>

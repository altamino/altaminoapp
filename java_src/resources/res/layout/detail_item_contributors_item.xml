<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/stub1"
        android:layout_width="0px"
        android:layout_height="0px"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/contributor_original"
        android:background="@drawable/button_rect_transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <include
            android:layout_width="@dimen/detail_avatar_size"
            android:layout_height="@dimen/detail_avatar_size"
            android:layout_marginLeft="10dp"
            android:layout_marginStart="10dp"
            layout="@layout/user_avatar_layout_mini"
            style="@style/AvatarImageView"/>
        <com.narvii.widget.NicknameView
            android:textSize="15dp"
            android:textColor="@color/text_clickable"
            android:id="@+id/nickname_contributor_original"
            android:tag="nickname"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            narvii:hideRole="true"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/contributor1"
        android:background="@drawable/button_rect_transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0px"
        android:layout_height="44dp"
        android:layout_toLeftOf="@+id/stub1"
        android:layout_below="@+id/contributor_original"
        android:layout_alignParentLeft="true"
        android:layout_toStartOf="@+id/stub1"
        android:layout_alignParentStart="true">
        <include
            android:layout_width="@dimen/detail_avatar_size"
            android:layout_height="@dimen/detail_avatar_size"
            android:layout_marginLeft="10dp"
            android:layout_marginStart="10dp"

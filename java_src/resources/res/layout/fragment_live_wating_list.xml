<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13dp"
            android:textColor="#4a90e2"
            android:gravity="center"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/clear_btn"
            android:background="@drawable/button_round_transparent"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/clear_all"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#000000"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:text="@string/waiting_list"/>
        <FrameLayout
            android:layout_gravity="end"
            android:id="@+id/close_btn"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <com.narvii.widget.TintButton
                android:layout_gravity="center"
                android:background="@drawable/button_oval_gray"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_bottom"/>
        </FrameLayout>
    </FrameLayout>
    <View
        android:background="#d8d8d8"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_divider_height"/>
    <com.narvii.app.theme.view.NVThemeFrameLayout
        android:id="@+id/recycle_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:nv_dark_background="@color/color_default_primary">
        <com.narvii.widget.recycleview.NVRecyclerView
            android:id="@+id/recycle_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.narvii.paging.state.PageStatusView
            android:id="@+id/status_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.narvii.app.theme.view.NVThemeFrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/apply_talk_layout"
        android:background="@drawable/bg_apply_to_talk"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <com.narvii.widget.NVImageView
            android:id="@+id/apply_talk_image"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="5dp"
            android:src="@drawable/ic_apply_to_talk"
            android:layout_marginEnd="5dp"
            app:showPressedMask="false"/>
        <TextView
            android:textColor="#ffffff"
            android:id="@+id/apply_to_talk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/apply_to_talk"/>
    </LinearLayout>
</LinearLayout>

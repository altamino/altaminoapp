<?xml version="1.0" encoding="utf-8"?>
<com.narvii.post.entry.ComposeEntryItem xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="78dp"
    android:layout_height="96dp">
    <com.narvii.widget.PopButton
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/post_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:scaleType="center"/>
    <FrameLayout
        android:layout_gravity="end|top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:layout_marginRight="12dp"
        android:layout_marginEnd="12dp">
        <com.narvii.widget.TintButton
            android:layout_gravity="center"
            android:id="@+id/level_lock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/compose_level_limit"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/plus_icon"
            android:paddingTop="9dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_amino_plus_text_icon"/>
        <TextView
            android:textSize="8dp"
            android:textStyle="bold"
            android:textColor="#b3b9cd"
            android:layout_gravity="center"
            android:id="@+id/level_no"
            android:paddingTop="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <TextView
        android:textSize="11dp"
        android:textColor="#fff"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/post_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="68dp"
        android:layout_marginRight="10dp"
        android:text="@string/post_entry_new_blog"
        android:maxLines="2"
        android:lines="2"/>
</com.narvii.post.entry.ComposeEntryItem>

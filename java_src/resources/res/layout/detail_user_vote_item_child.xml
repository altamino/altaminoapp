<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/vote_btn"
        android:background="@drawable/detail_vote_btn"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginRight="12dp"
        android:minWidth="80dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true">
        <com.narvii.widget.VoteIcon
            android:id="@+id/vote_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="10dp"
            android:scaleType="centerInside"
            android:layout_marginStart="10dp"/>
        <com.narvii.widget.SpinningView
            android:id="@+id/vote_progress"
            android:visibility="gone"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginLeft="10dp"
            android:layout_marginStart="10dp"
            narvii:spinColor="#fff"
            narvii:spinStyle="2"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#555"
            android:gravity="center"
            android:id="@+id/vote_count"
            android:duplicateParentState="true"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="10dp"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/user_layout"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginRight="10dp"
        android:layout_toLeftOf="@+id/vote_btn"
        android:layout_marginEnd="10dp"
        android:layout_toStartOf="@+id/vote_btn">
        <include
            android:layout_width="@dimen/detail_avatar_size"
            android:layout_height="@dimen/detail_avatar_size"
            android:layout_marginLeft="10dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_alignParentStart="true"
            layout="@layout/user_avatar_layout_mini"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/user_avatar_layout"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/user_avatar_layout">
            <com.narvii.widget.NicknameView
                android:textSize="15dp"
                android:textColor="@color/text_clickable"
                android:id="@+id/nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginStart="10dp"
                narvii:hideRole="true"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/datetime"
                android:id="@+id/datetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>

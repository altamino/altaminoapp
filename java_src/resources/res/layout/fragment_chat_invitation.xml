<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/invitation_container"
    android:background="#fff"
    android:padding="4dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="@dimen/chat_invitation_bar_height">
    <com.narvii.chat.MultiAvatarView
        android:id="@+id/chat_avatars"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"/>
    <com.narvii.widget.ThumbImageView
        android:id="@+id/chat_cover"
        android:layout_width="64dp"
        android:layout_height="42dp"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"
        app:defaultDrawable="@color/placeholder"
        app:imageType="chat-cover"
        app:strokeColor="#888"
        app:strokeWidth="0.5dp"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#000"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/subTitle"
        android:layout_width="0pt"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="6dp"
        android:maxLines="2"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"/>
    <Button
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:id="@+id/action"
        android:background="@drawable/button_round_green_chat_invite"
        android:paddingLeft="6dp"
        android:paddingTop="4dp"
        android:paddingRight="6dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginRight="8dp"
        android:minWidth="76dp"
        android:text="@string/chat_accept"
        android:singleLine="true"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:layout_marginEnd="8dp"/>
    <com.narvii.widget.SpinningView
        android:id="@+id/progress"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="36dp"
        app:spinColor="#eee"
        app:spinStyle="2"/>
</LinearLayout>

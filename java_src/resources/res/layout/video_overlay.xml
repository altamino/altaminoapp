<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <FrameLayout
        android:id="@+id/video_overlay_frame"
        android:layout_width="1px"
        android:layout_height="1px">
        <View
            android:id="@+id/video_overlay_bg"
            android:background="#000"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.narvii.widget.SpinningView
                android:layout_gravity="center"
                android:id="@+id/video_overlay_loading"
                android:visibility="invisible"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:spinColor="#ffff"
                app:spinStyle="2"/>
            <com.narvii.widget.FullHitFrameLayout
                android:layout_gravity="end|bottom"
                android:layout_width="40dp"
                android:layout_height="40dp">
                <com.narvii.widget.EasyButton
                    android:layout_gravity="end|bottom"
                    android:id="@+id/video_overlay_volume"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="6dp"
                    android:layout_marginEnd="10dp"/>
            </com.narvii.widget.FullHitFrameLayout>
            <com.narvii.widget.FullHitFrameLayout
                android:layout_gravity="top|right"
                android:layout_width="30dp"
                android:layout_height="30dp">
                <com.narvii.widget.EasyButton
                    android:layout_gravity="top|right"
                    android:id="@+id/video_overlay_share"
                    android:background="@drawable/button_round_dark"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginRight="5dp"
                    android:src="@drawable/ic_community_share"/>
            </com.narvii.widget.FullHitFrameLayout>
        </FrameLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/video_overlay_controls"
        android:visibility="invisible"
        android:layout_width="200dp"
        android:layout_height="150dp">
        <TextView
            android:textSize="12dp"
            android:textColor="#fff"
            android:layout_gravity="start|top"
            android:id="@+id/debug_video_status"
            android:background="#0000"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="Fetching url..."
            android:layout_marginStart="2dp"/>
        <com.narvii.widget.FullHitFrameLayout
            android:layout_gravity="end|bottom"
            android:layout_width="40dp"
            android:layout_height="40dp">
            <com.narvii.widget.EasyButton
                android:layout_gravity="end|bottom"
                android:id="@+id/video_overlay_right_corner_volume"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="6dp"
                android:layout_marginEnd="10dp"/>
        </com.narvii.widget.FullHitFrameLayout>
    </FrameLayout>
</FrameLayout>

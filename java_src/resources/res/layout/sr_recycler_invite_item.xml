    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center"
        android:background="@drawable/oval_mask_3000"
        android:layout_width="@dimen/sr_live_user_avatar_size"
        android:layout_height="@dimen/sr_live_user_avatar_size">

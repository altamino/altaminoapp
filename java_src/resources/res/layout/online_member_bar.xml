<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/mainLayout"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_gravity="end|center_vertical"
        android:id="@+id/onlineTextLayout"
        android:layout_width="wrap_content"
        android:layout_height="24dp">
        <com.narvii.widget.NVImageView
            android:id="@+id/bar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="#cc000000"
            android:layout_alignLeft="@+id/content"
            android:layout_alignRight="@+id/content"
            android:layout_alignStart="@+id/content"
            android:layout_alignEnd="@+id/content"
            app:cornerMask="6"
            app:cornerRadius="12dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <View
                android:id="@+id/green_oval"
                android:background="@drawable/oval_green"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginLeft="23dp"
                android:layout_marginRight="4dp"
                android:layout_marginStart="23dp"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#fff"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/onlineMemberCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:singleLine="true"
                android:layout_marginEnd="12dp"/>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>

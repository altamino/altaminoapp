<?xml version="1.0" encoding="utf-8"?>
<com.narvii.drawer.DrawerRightHost xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#333"
    android:layout_width="@dimen/drawer_right_width"
    android:layout_height="match_parent">
    <com.narvii.drawer.DrawerRealtimeBlurView
        android:id="@+id/blur_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:realtimeBlurRadius="30dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="46dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/search"
            android:background="@drawable/drawer_right_search_btn"
            android:layout_width="0px"
            android:layout_height="30dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_weight="1">
            <com.narvii.widget.FontAwesomeView
                android:textColor="#fff"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginLeft="6dp"
                android:text="@string/fa_search"
                android:layout_marginStart="6dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#ffff"
                android:layout_width="0px"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="@string/join_more_community"
                android:layout_weight="1"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
    </LinearLayout>
    <com.narvii.list.refresh.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="46dp">
        <com.narvii.widget.NVListView
            android:id="@android:id/list"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.narvii.list.refresh.SwipeRefreshLayout>
</com.narvii.drawer.DrawerRightHost>

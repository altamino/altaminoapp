<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <com.narvii.widget.ThumbImageView
        android:id="@+id/option_iv"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginRight="6dp"
        android:layout_marginEnd="6dp"
        app:cornerRadius="6dp"
        app:defaultDrawable="@drawable/poll_option_default_icon"/>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.narvii.widget.LongPushButton
            android:id="@+id/push_btn"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            app:pushButtonWider="1dp">
            <com.narvii.widget.AutoSizingTextView
                android:textColor="#fff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/title1"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:shadowColor="#333"
                android:shadowDy="1"
                app:autoSizeTextMaxSize="15dp"
                app:autoSizeTextMinSize="10dp"/>
            <TextView
                android:textSize="13dp"
                android:textStyle="bold"
                android:textColor="#f4f4f4"
                android:layout_gravity="center"
                android:id="@+id/hold_longer"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hold_longer"/>
            <com.narvii.widget.SpinningView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/progress"
                android:visibility="invisible"
                android:layout_width="32dp"
                android:layout_height="20dp"
                android:layout_marginRight="10dp"
                android:layout_marginEnd="10dp"
                app:spinColor="#fff"/>
        </com.narvii.widget.LongPushButton>
        <com.narvii.poll.VoteBar
            android:id="@+id/vote_bar"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">
                <com.narvii.widget.FontAwesomeView
                    android:textColor="#fff"
                    android:id="@+id/check"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginRight="6dp"
                    android:text="@string/fa_check"
                    android:layout_marginEnd="6dp"/>
                <com.narvii.widget.AutoSizingTextView
                    android:textColor="#fff"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/title2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:maxLines="1"
                    android:shadowColor="#333"
                    android:shadowDy="1"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:autoSizeTextMaxSize="15dp"
                    app:autoSizeTextMinSize="10dp"/>
                <TextView
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="#fff"
                    android:gravity="center_vertical"
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/vote_bar_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.narvii.poll.VoteBar>
    </FrameLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/check_in_bottom_bar_background"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="65dp">
    <include
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="15dp"
        android:layout_marginStart="15dp"
        layout="@layout/user_avatar_layout_mini"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="5dp"
        android:layout_weight="1"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="5dp">
        <com.narvii.widget.NicknameView
            android:textSize="14dp"
            android:textColor="#fff"
            android:id="@+id/nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/streak_lost_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginRight="6dp"
                android:src="@drawable/ic_check_in_streak_lost"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#b2ffffff"
                android:id="@+id/check_in_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="15dp"
        android:layout_marginEnd="15dp">
        <com.narvii.widget.PushButton
            android:id="@+id/checkin_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:minHeight="27dp"
            app:pushButtonColor="#52d127"
            app:pushButtonLift="3dp"
            app:pushShadowAlpha="0.5">
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:layout_gravity="center"
                android:id="@+id/checkin_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/check_in"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/checkin_progress"
                android:visibility="gone"
                android:layout_width="15dp"
                android:layout_height="15dp"
                style="?android:attr/progressBarStyle"/>
        </com.narvii.widget.PushButton>
        <ImageView
            android:id="@+id/has_check_in_today"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginLeft="10dp"
            android:src="@drawable/ic_check_in_streak_checked"
            android:layout_marginStart="10dp"/>
    </FrameLayout>
</LinearLayout>

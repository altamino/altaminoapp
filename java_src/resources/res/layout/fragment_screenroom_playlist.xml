<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:dslv="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/click_remove_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.narvii.widget.SwipeableLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:background="#ffffff"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:orientation="vertical"
                android:id="@+id/title_layout"
                android:layout_width="match_parent"
                android:layout_height="46dp">
                <TextView
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="#4a4a4a"
                    android:layout_gravity="center"
                    android:id="@+id/list_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_videos"/>
                <Button
                    android:textSize="15dp"
                    android:textColor="@color/dialog_option_blue"
                    android:gravity="center"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/clear_all_button"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="15dp"
                    android:text="Clear all"
                    android:singleLine="true"
                    android:layout_marginStart="15dp"/>
                <FrameLayout
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/minimize_area"
                    android:layout_width="40dp"
                    android:layout_height="40dp">
                    <com.narvii.widget.TintButton
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/minimize"
                        android:background="@drawable/circle_dark_transplant_clickable"
                        android:padding="6dp"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_down"
                        android:scaleType="centerInside"/>
                </FrameLayout>
            </FrameLayout>
            <View
                android:background="#e6e5e8"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <FrameLayout
                android:id="@+id/list_frame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <com.mobeta.android.dslv.DragSortListView
                    android:id="@android:id/list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:listSelector="@drawable/list_selector"
                    android:headerDividersEnabled="true"
                    android:footerDividersEnabled="true"
                    dslv:collapsed_height="2dp"
                    dslv:drag_enabled="true"
                    dslv:drag_scroll_start="0.33"
                    dslv:float_alpha="0.6"
                    dslv:max_drag_scroll_speed="1"
                    dslv:slide_shuffle_speed="0.6"
                    dslv:track_drag_sort="false"
                    dslv:use_default_controller="false"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@android:id/empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.narvii.widget.FontAwesomeView
                        android:textColor="@color/button_text_gray_w"
                        android:gravity="center"
                        android:id="@+id/empty_retry"
                        android:padding="12dp"
                        android:clickable="true"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:text="@string/ion_refresh"/>
                    <TextView
                        android:textSize="18dp"
                        android:textStyle="bold"
                        android:textColor="@color/empty_text_color"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:padding="10dp"
                        android:paddingTop="40dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/screen_room_playlist_empty_text"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/select_frame"
                android:background="#fff"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="56dp">
                <View
                    android:background="#e0dee3"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"/>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/screenroom_playlist_video_statics_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp">
                    <TextView
                        android:textSize="18dp"
                        android:textStyle="bold"
                        android:textColor="#7e7e7e"
                        android:id="@+id/screenroom_playlist_video_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#7e7e7e"
                        android:id="@+id/screenroom_playlist_video_time_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <FrameLayout
                    android:layout_gravity="end"
                    android:id="@+id/screen_room_add_video"
                    android:background="#00ce7d"
                    android:layout_width="160dp"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#ffffff"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/screen_room_playlist_add"
                        android:drawableTop="@drawable/ic_screen_room_playlist_add"
                        android:drawablePadding="6dp"/>
                </FrameLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/start_frame"
                android:background="#fff"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/btn_start"
                    android:background="@drawable/chat_screenroom_playlist_bg"
                    android:layout_width="match_parent"
                    android:layout_height="47dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/start"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
            </FrameLayout>
        </LinearLayout>
    </com.narvii.widget.SwipeableLayout>
</FrameLayout>

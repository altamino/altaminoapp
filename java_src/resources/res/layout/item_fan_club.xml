<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_margin="10dp"
        layout="@layout/user_avatar_layout_mini"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_weight="1"
        android:layout_marginEnd="10dp">
        <com.narvii.widget.NicknameView
            android:textSize="17dp"
            android:textColor="#4a4a4a"
            android:id="@+id/nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            app:hideInfluencerBadge="false"
            app:hideRankingBadge="true"
            app:hideRole="true"
            app:roleScale="0.65"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/community_info_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <com.narvii.widget.CommunityIconView
                android:id="@+id/community_icon"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"
                app:cornerRadius="2dp"
                app:defaultDrawable="@drawable/placeholder_community"
                app:scalePlaceholder="true"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#b3b3b3"
                android:ellipsize="end"
                android:id="@+id/community_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="end"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_marginEnd="10dp">
        <TextView
            android:textSize="10dp"
            android:id="@+id/fake_status_placeholder"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <ImageView
            android:id="@+id/fan_club_icon"
            android:layout_width="22dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_fan_club_logo"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#d10012"
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
    <com.narvii.widget.TintButton
        android:gravity="center"
        android:id="@+id/chevron_right"
        android:layout_width="10dp"
        android:layout_height="15dp"
        android:layout_marginRight="10dp"
        android:src="@drawable/chevron_right_mirror"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/_frame_layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.widget.FullscreenBackgroundView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include layout="@layout/not_available_layout"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/list_layout"/>
    <com.narvii.list.overlay.OverlayLayout
        android:id="@+id/overlay"
        android:clipChildren="false"
        android:clipToPadding="true"
        android:layout_width="match_parent"
        android:layout_height="0px"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/not_activated"
        android:background="#fd9938"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.narvii.list.overlay.OverlayListPlaceholder
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#fff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/account_not_activated"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#ffff"
            android:id="@+id/activate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/tap_to_activate"/>
    </LinearLayout>
    <include
        android:id="@+id/disabled_bar"
        layout="@layout/detail_disabled_bar"/>
    <com.narvii.list.refresh.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.github.mmin18.widget.FlexLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="#74000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.github.mmin18.widget.FlexLayout
        app:layout_height="next.height-65dp"
        app:layout_left="next.left"
        app:layout_top="next.top"
        app:layout_width="next.width">
        <com.narvii.widget.StatusBarPlaceHolder
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:background="@drawable/optin_ads_popup_bg"
            android:layout_width="match_parent"
            app:layout_height="parent.height-status.height"
            app:layout_top="status.bottom"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/optin_ads_popup_bg1"
            app:layout_centerX="50%"
            app:layout_top="status.bottom"/>
    </com.github.mmin18.widget.FlexLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container_ll"
        android:layout_height="wrap_content"
        app:layout_centerX="50%"
        app:layout_centerY="50%"
        app:layout_width="max(parent.width*0.83,300dp)">
        <com.narvii.widget.StatusBarPlaceHolder
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.github.mmin18.widget.FlexLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/optin_ads_popup_ic1"
                app:layout_left="18dp"
                app:layout_top="32dp"/>
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="center"
                android:id="@+id/ads_title"
                android:scrollbars="vertical"
                android:text="@string/earn_free_coins_with_ads"
                android:maxLines="3"
                android:shadowColor="#0000"
                android:shadowRadius="3"
                app:layout_centerY="icon.centerY"
                app:layout_height="parent.width*0.3"
                app:layout_left="icon.right+12dp"
                app:layout_right="parent.width-18dp"/>
        </com.github.mmin18.widget.FlexLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="#fff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/ads_text"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="23dp"
            android:layout_marginRight="23dp"
            android:text="@string/earn_more_coins_popup_message"
            android:shadowColor="#0000"
            android:shadowRadius="2"
            android:layout_weight="1"
            android:layout_marginStart="23dp"
            android:layout_marginEnd="23dp"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/ads_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="14dp"
            android:text="@string/manage_ads_setting"
            android:shadowColor="#0000"
            android:shadowRadius="2"/>
        <com.narvii.widget.PushButton
            android:id="@+id/button_ok"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="20dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:pushButtonColor="#fff">
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="#e77b31"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/got_it2"/>
        </com.narvii.widget.PushButton>
        <com.narvii.widget.PopButton
            android:layout_gravity="center"
            android:id="@+id/close"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:src="@drawable/ic_dialog_close_circle"
            android:alpha="0.8"
            app:tintColor="#fff"/>
    </LinearLayout>
</com.github.mmin18.widget.FlexLayout>

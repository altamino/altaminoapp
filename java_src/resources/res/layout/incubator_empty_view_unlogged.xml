<?xml version="1.0" encoding="utf-8"?>
<com.github.mmin18.widget.FlexLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_centerX="50%"
        app:layout_centerY="50%-0.5*@dimen/master_tab_bar_height"
        app:layout_width="max(@dimen/master_push_button_width, 76%)">
        <TextView
            android:textSize="22dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/incubator_login_hint"
            android:maxLines="2"
            android:minLines="2"
            app:layout_left="12%"
            app:layout_right="88%"/>
        <com.narvii.widget.PushButton
            android:layout_gravity="center"
            android:id="@+id/login"
            android:paddingLeft="@dimen/master_push_button_padding_horizontal"
            android:paddingTop="@dimen/master_push_button_padding_vertical"
            android:paddingRight="@dimen/master_push_button_padding_horizontal"
            android:paddingBottom="@dimen/master_push_button_padding_vertical"
            android:layout_width="@dimen/master_push_button_width"
            android:layout_height="@dimen/master_push_button_height"
            android:layout_marginTop="50dp"
            android:minWidth="200dp"
            android:paddingStart="@dimen/master_push_button_padding_horizontal"
            android:paddingEnd="@dimen/master_push_button_padding_horizontal"
            app:pushButtonColor="#f5a623"
            app:pushButtonColorDark="#ba7b14">
            <TextView
                android:textSize="20dp"
                android:textColor="#fff"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_login"/>
        </com.narvii.widget.PushButton>
    </LinearLayout>
</com.github.mmin18.widget.FlexLayout>

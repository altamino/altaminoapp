<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#0000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/click_remove_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#ffffff"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#4a4a4a"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/purchase_dialog_title"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="#f9fafb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="70dp">
                <com.narvii.widget.NVImageView
                    android:id="@+id/store_item_icon"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_margin="12dp"
                    app:showPressedMask="false"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp">
                    <com.narvii.monetization.utils.StoreItemNameView
                        android:id="@+id/store_item_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#4a4a4a"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/store_item_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/amino_coin_small"
                        android:drawablePadding="4dp"
                        android:drawableStart="@drawable/amino_coin_small"/>
                    <TextView
                        android:textSize="11dp"
                        android:textColor="#9b9b9b"
                        android:id="@+id/store_item_original_price_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/purchase_benefits_amino_plus_hint"
                android:background="@drawable/rect_round_white"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="7dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="14dp"
                    android:layout_marginRight="6dp"
                    android:src="@drawable/ic_monetization_store_gift"
                    android:scaleType="centerInside"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="bold"
                    android:textColor="#b3b3b3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/purchase_benefits_amino_plus_hint_title"/>
            </LinearLayout>
        </LinearLayout>
        <com.narvii.wallet.RedeemCouponComponent
            android:id="@+id/redeem_coupon_component"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</FrameLayout>

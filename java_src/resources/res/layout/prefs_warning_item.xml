<?xml version="1.0" encoding="utf-8"?>
<com.narvii.app.theme.view.NVThemeRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/prefs_default_size"
    app:nv_dark_background="#1affffff">
    <com.narvii.app.theme.view.NVThemeTintButton
        android:gravity="center"
        android:id="@+id/chevron_right"
        android:layout_width="10dp"
        android:layout_height="15dp"
        android:layout_marginRight="10dp"
        android:src="@drawable/chevron_right_mirror"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp"
        android:layout_alignParentEnd="true"
        app:nv_dark_tintColor="@color/dark_theme_chevron_right"
        app:tintColor="@color/pref_warning"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/prefs_left_margin"
        android:layout_marginRight="12dp"
        android:layout_toLeftOf="@+id/chevron_right"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/prefs_left_margin"
        android:layout_marginEnd="12dp"
        android:layout_toStartOf="@+id/chevron_right">
        <TextView
            android:textSize="@dimen/pref_main_text_size"
            android:textColor="@color/pref_warning"
            android:layout_gravity="center_vertical"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:orientation="vertical"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp">
            <TextView
                android:textSize="@dimen/pref_sub_text_size"
                android:textColor="@color/pref_warning"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/text2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="9dp"
                android:textColor="#fff"
                android:layout_gravity="end"
                android:id="@+id/warning_info"
                android:background="@drawable/account_warning_round_orange"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/account_email_not_verified"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"/>
        </LinearLayout>
    </LinearLayout>
</com.narvii.app.theme.view.NVThemeRelativeLayout>

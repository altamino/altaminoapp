<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:background="@drawable/item_selector_white_grey"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:layout_width="match_parent"
    android:layout_height="75dp">
    <FrameLayout
        android:background="@drawable/sticker_pack_add_bg"
        android:layout_width="50dp"
        android:layout_height="50dp">
        <com.narvii.widget.TintButton
            android:layout_gravity="center"
            android:id="@+id/avatar_placeholder"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/account_avatar_placeholder"
            app:tintColor="#b9b9b9"/>
    </FrameLayout>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="#777777"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/create_a_new_sticker_pack"
        android:singleLine="true"/>
</LinearLayout>

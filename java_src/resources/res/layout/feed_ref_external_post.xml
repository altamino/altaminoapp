<?xml version="1.0" encoding="utf-8"?>
<com.narvii.feed.FeedListItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ref_quote"
    android:paddingLeft="@dimen/ref_post_padding_horizantol"
    android:paddingTop="@dimen/ref_post_padding_vertical"
    android:paddingRight="@dimen/ref_post_padding_horizantol"
    android:paddingBottom="@dimen/ref_post_padding_vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/ref_post_padding_horizantol"
    android:paddingEnd="@dimen/ref_post_padding_horizantol"
    narvii:isRef="true">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/user_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp">
        <com.narvii.widget.ThumbImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/avatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            android:maxWidth="20dp"
            style="@style/AvatarImageView"/>
        <com.narvii.widget.NicknameView
            android:textSize="12dp"
            android:textColor="@color/text_clickable"
            android:layout_gravity="center_vertical"
            android:id="@+id/nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            narvii:hideRole="true"/>
    </LinearLayout>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="#333"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:layout_below="@+id/user_info_container"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#555"
        android:ellipsize="end"
        android:id="@+id/content"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:layout_below="@+id/title"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
    <include
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_below="@+id/content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        layout="@layout/feed_image3_secret"/>
    <include layout="@layout/fans_only_content_indicator_ref_layout"/>
</com.narvii.feed.FeedListItem>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.narvii.widget.FontAwesomeView
        android:textSize="16dp"
        android:textColor="#666"
        android:gravity="center"
        android:id="@+id/search_icon"
        android:padding="4dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:text="@string/ion_ios_search"/>
    <com.narvii.widget.BoundedLinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:max_width="250dp">
        <HorizontalScrollView
            android:id="@+id/search_thumb_scroller"
            android:scrollbars="none"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/thumb_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </HorizontalScrollView>
    </com.narvii.widget.BoundedLinearLayout>
    <com.narvii.widget.SearchBar
        android:id="@+id/search_bar"
        android:layout_width="0px"
        android:layout_height="match_parent"
        android:minWidth="400dp"
        android:layout_weight="1">
        <EditText
            android:textSize="16dp"
            android:textColor="#222"
            android:id="@+id/search_text"
            android:background="@null"
            android:paddingLeft="0dp"
            android:paddingRight="32dp"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:hint="@string/search"
            android:layout_centerVertical="true"
            android:inputType="textCapSentences"
            android:imeOptions="actionSearch"
            android:paddingStart="0dp"
            android:paddingEnd="32dp"/>
        <com.narvii.widget.FontAwesomeView
            android:textSize="16dp"
            android:textColor="#999"
            android:gravity="center"
            android:id="@+id/search_clear"
            android:padding="4dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:text="@string/ion_ios_close_outline"
            android:layout_alignRight="@+id/search_text"
            android:layout_centerVertical="true"
            android:layout_alignEnd="@+id/search_text"/>
    </com.narvii.widget.SearchBar>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.narvii.scene.view.NVSceneView
                android:id="@+id/scene_view"
                android:layout_width="120dp"
                android:layout_height="64dp">
                <com.narvii.widget.ThumbImageView
                    android:id="@+id/iv_cover_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    narvii:cornerRadius="9dp"
                    narvii:defaultDrawable="@color/scene_default_cover"/>
                <ImageView
                    android:id="@+id/iv_add_video"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="22.5dp"
                    android:src="@drawable/ic_add_video"
                    android:layout_centerHorizontal="true"/>
                <View
                    android:id="@+id/ic_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <TextView
                    android:textSize="10dp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:ellipsize="end"
                    android:id="@+id/tv_title"
                    android:layout_width="95dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:maxLines="1"
                    android:lines="1"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="@android:color/white"
                    android:ellipsize="end"
                    android:id="@+id/tv_time"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:lines="1"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentStart="true"/>
                <com.narvii.widget.NVImageView
                    android:id="@+id/iv_playing_icon"
                    android:visibility="gone"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_margin="8dp"
                    android:scaleType="centerInside"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentStart="true"/>
            </com.narvii.scene.view.NVSceneView>
            <RelativeLayout
                android:id="@+id/border_layout"
                android:visibility="gone"
                android:layout_width="120dp"
                android:layout_height="64dp">
                <View
                    android:id="@+id/border_view"
                    android:background="@drawable/ic_scene_border_normal_mirror"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </RelativeLayout>
            <com.narvii.widget.NVImageView
                android:layout_gravity="center"
                android:id="@+id/edit_tag"
                android:background="@drawable/bg_rect_black_20_corner"
                android:padding="10dp"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_secen_edit_handle"
                android:alpha="0.9"/>
        </FrameLayout>
        <View
            android:id="@+id/split_view"
            android:background="@drawable/story_dash_line"
            android:visibility="gone"
            android:layout_width="8dp"
            android:layout_height="1.5dp"
            android:layout_marginLeft="12dp"
            android:layerType="software"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/attached"
        android:layout_width="42dp"
        android:layout_height="40dp"
        android:layout_marginLeft="-21dp"
        android:src="@drawable/ic_scene_attach_empty"
        android:layout_alignRight="@+id/layout_item"
        android:layout_centerVertical="true"
        android:layout_marginStart="-21dp"
        android:layout_alignEnd="@+id/layout_item"/>
</RelativeLayout>

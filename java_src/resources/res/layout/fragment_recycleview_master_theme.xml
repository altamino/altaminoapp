<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.app.theme.view.NVThemeFrameLayout
        android:id="@+id/recycle_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:nv_dark_background="@color/color_default_primary">
        <FrameLayout
            android:id="@+id/master_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.narvii.widget.recycleview.NVRecyclerView
            android:id="@+id/recycle_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.narvii.paging.state.PageStatusView
            android:id="@+id/status_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.narvii.app.theme.view.NVThemeFrameLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

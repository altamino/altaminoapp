<?xml version="1.0" encoding="utf-8"?>
<com.narvii.list.select.SelectableFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    narvii:selectOffAlpha="0.7"
    narvii:selectPadding="10dp">
    <View
        android:id="@+id/selectable_back_on"
        android:background="#8888"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.narvii.widget.FontAwesomeView
        android:textSize="28dp"
        android:textColor="#fff"
        android:gravity="center"
        android:layout_gravity="end|top"
        android:id="@+id/selectable_check_off"
        android:padding="4dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:text="@string/ion_android_radio_button_off"
        android:layout_marginEnd="16dp"/>
    <FrameLayout
        android:layout_gravity="end|top"
        android:id="@+id/selectable_check_on"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp">
        <View
            android:background="@drawable/selectable_check_on_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="3dp"/>
        <com.narvii.widget.FontAwesomeView
            android:textSize="28dp"
            android:textColor="@color/light_blue"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/ion_ios_checkmark"/>
    </FrameLayout>
</com.narvii.list.select.SelectableFrame>

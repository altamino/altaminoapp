<?xml version="1.0" encoding="utf-8"?>
<com.github.mmin18.widget.FlexLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_height="wrap_content"
        app:layout_centerY="50%"
        app:layout_left="0%"
        app:layout_right="18%">
        <com.narvii.widget.FontAwesomeView
            android:layout_gravity="center"
            android:id="@+id/template_type_icon"
            android:padding="6dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:text="@string/ion_flag"
            app:layout_left="12dp"/>
        <TextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/template_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:id="@+id/message_title"
        android:layout_height="wrap_content"
        android:maxLines="2"
        app:layout_left="20%"
        app:layout_right="90%"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/message_content"
        android:layout_height="100dp"
        app:layout_bottom="message_title.bottom+104dp"
        app:layout_left="20%"
        app:layout_right="90%"
        app:layout_top="message_title.bottom+4dp"/>
    <LinearLayout
        android:layout_height="match_parent"
        app:layout_centerY="50%"
        app:layout_left="92%"
        app:layout_right="98%">
        <com.narvii.widget.FontAwesomeView
            android:textColor="#bbb"
            android:layout_gravity="center"
            android:padding="4dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:text="@string/ion_chevron_right"/>
    </LinearLayout>
</com.github.mmin18.widget.FlexLayout>

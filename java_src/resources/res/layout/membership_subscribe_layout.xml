<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlay"
    android:background="#0000"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.narvii.widget.SpinningView
        android:layout_gravity="center"
        android:id="@android:id/progress"
        android:layout_width="@dimen/spin_large_size"
        android:layout_height="@dimen/spin_large_size"/>
    <com.github.mmin18.widget.FlexLayout
        android:layout_gravity="bottom"
        android:id="@+id/root"
        android:visibility="invisible"
        android:clickable="true"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/title"
            android:background="@drawable/subscribe_dialog_header_bg"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:src="@drawable/amino_plus_icon"
            android:scaleType="centerInside"/>
        <ImageView
            android:id="@+id/back"
            android:background="@drawable/actionbar_left_btn"
            android:visibility="invisible"
            android:clickable="true"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back_mirror"
            android:scaleType="center"
            app:layout_centerY="title.centerY"
            app:layout_left="6dp"/>
        <View
            android:background="#fff"
            android:layout_width="match_parent"
            app:layout_bottom="100%"
            app:layout_top="title.bottom-1dp"/>
        <com.narvii.widget.OrderedLinearLayout
            android:orientation="horizontal"
            android:id="@+id/sublist"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="90dp"
            app:layout_top="title.bottom"/>
        <com.narvii.widget.SpinningView
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:layout_width="@dimen/spin_middle_size"
            android:layout_height="@dimen/spin_middle_size"
            app:layout_centerX="50%"
            app:layout_centerY="sublist.centerY"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#333"
            android:gravity="center"
            android:id="@+id/error"
            android:visibility="invisible"
            android:layout_height="wrap_content"
            app:layout_centerX="50%"
            app:layout_centerY="sublist.centerY"
            app:layout_width="80%"/>
        <com.narvii.widget.FontAwesomeView
            android:textColor="@color/button_text_gray_w"
            android:gravity="center"
            android:id="@+id/retry"
            android:padding="12dp"
            android:visibility="invisible"
            android:clickable="true"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:text="@string/ion_refresh"
            app:layout_centerX="50%"
            app:layout_top="error.bottom+20dp"/>
        <com.narvii.widget.ThumbImageView
            android:id="@+id/purchase"
            android:layout_height="40dp"
            app:cornerRadius="20dp"
            app:layout_centerX="50%"
            app:layout_top="sublist.bottom+22dp"
            app:layout_width="purchase_text.width"/>
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/purchase_text"
            android:paddingLeft="36dp"
            android:paddingRight="36dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="205dp"
            android:text="@string/membership_purchase"
            app:layout_centerX="50%"
            app:layout_top="purchase.top"/>
        <com.narvii.wallet.RedeemCouponComponent
            android:id="@+id/redeem_coupon_component"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_top="sublist.bottom"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#888888"
            android:gravity="center_vertical"
            android:id="@+id/membership_info_text"
            android:background="@drawable/button_round_transparent"
            android:paddingLeft="10dp"
            android:paddingTop="3dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subscription_message"
            android:drawablePadding="5dp"
            app:layout_centerX="50%"
            app:layout_top="purchase.bottom+16dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#aaa"
            android:gravity="center_vertical"
            android:id="@+id/switch_redeem"
            android:background="@drawable/button_round_transparent"
            android:paddingLeft="10dp"
            android:paddingTop="3dp"
            android:paddingRight="20dp"
            android:paddingBottom="10dp"
            android:visibility="invisible"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/redeem_with_coin"
            android:drawableLeft="@drawable/amino_coin_small"
            android:drawablePadding="5dp"
            app:layout_centerX="50%"
            app:layout_top="membership_info_text.bottom+16dp"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#888888"
            android:gravity="center"
            android:id="@+id/purchase_directly"
            android:background="#dddddd"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/purchase_membership"
            app:layout_top="redeem_coupon_component.bottom+10dp"/>
    </com.github.mmin18.widget.FlexLayout>
</FrameLayout>

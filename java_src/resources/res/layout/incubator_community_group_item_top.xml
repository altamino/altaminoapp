<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cell_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <RelativeLayout
            android:id="@+id/community_group_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/master_home_section_header_size"
                android:textStyle="bold"
                android:textColor="#ff736c6c"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/title"
                android:paddingLeft="8dp"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:singleLine="true"
                android:layout_alignParentLeft="true"
                android:paddingStart="8dp"
                android:layout_alignParentStart="true"/>
            <LinearLayout
                android:id="@+id/see_all_button"
                android:background="@drawable/button_rect_transparent_0x2000"
                android:paddingLeft="8dp"
                android:paddingRight="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                android:layout_alignParentEnd="true">
                <TextView
                    android:textSize="@dimen/master_home_section_header_sub_size"
                    android:textColor="#ff736c6c"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/seeall_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/see_all"/>
                <com.narvii.widget.TintButton
                    android:layout_gravity="center_vertical"
                    android:id="@+id/see_all_arrow"
                    android:padding="6dp"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/see_all_mirror"
                    app:tintColor="#ff736c6c"/>
            </LinearLayout>
        </RelativeLayout>
        <com.narvii.widget.HorizontalRecyclerView
            android:id="@+id/gallery"
            android:paddingLeft="10dp"
            android:paddingRight="0dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="10dp"
            android:paddingEnd="0dp"/>
    </LinearLayout>
</FrameLayout>

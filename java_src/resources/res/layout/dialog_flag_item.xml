<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="18dp"
                android:textColor="#000"
                android:id="@+id/flag_name"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#555"
                android:id="@+id/flag_name_hint"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <com.narvii.widget.FontAwesomeView
            android:textColor="#fafafa"
            android:id="@+id/flag_right_check_1"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="8dp"
            android:text="@string/ion_checkmark_round"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true"/>
        <CheckBox
            android:id="@+id/flag_right_check_2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginRight="10dp"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/flag_item_divider"
        android:background="#ccc"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"/>
</LinearLayout>

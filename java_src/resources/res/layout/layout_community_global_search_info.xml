<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/community_info"
    android:layout_width="0px"
    android:layout_height="wrap_content"
    android:layout_marginLeft="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginRight="10dp"
    android:layout_toRightOf="@+id/stub1"
    android:layout_below="@+id/title"
    android:layout_alignParentRight="true"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="10dp"
    android:layout_toEndOf="@+id/stub1"
    android:layout_alignParentEnd="true">
    <TextView
        android:textSize="12dp"
        android:textColor="#b2ffffff"
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/from"/>
    <com.narvii.widget.CommunityIconView
        android:id="@+id/community_icon"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_marginLeft="8dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="8dp"
        app:defaultDrawable="@drawable/placeholder_community"
        app:scalePlaceholder="true"
        app:shadowColor="#333"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#b2ffffff"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/community_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:maxLines="1"
        android:layout_marginStart="6dp"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingLeft="0dp"
    android:paddingTop="4dp"
    android:paddingRight="4dp"
    android:paddingBottom="4dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="0dp"
    android:paddingEnd="4dp"
    android:elevation="5dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/audience_count_container"
        android:background="@drawable/rtc_audience_count_bg"
        android:paddingLeft="10dp"
        android:paddingRight="26dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/rtc_small_avatar_size"
        android:paddingStart="10dp"
        android:paddingEnd="26dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_rtc_audience"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#fff"
            android:layout_gravity="center_vertical"
            android:id="@+id/audience_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:shadowColor="#30000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="1"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <com.narvii.widget.ReverseDrawingOrderLinearLayout
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/avatar1"
            android:layout_width="@dimen/rtc_small_avatar_size"
            android:layout_height="@dimen/rtc_small_avatar_size"
            android:layout_marginLeft="-20dp"
            android:layout_marginStart="-20dp"
            app:shadowColor="#000"
            app:shadowSize="1dp"
            layout="@layout/user_avatar_layout_mini_nobadge"
            style="@style/AvatarImageView"/>
        <include
            android:id="@+id/avatar2"
            android:layout_width="@dimen/rtc_small_avatar_size"
            android:layout_height="@dimen/rtc_small_avatar_size"
            android:layout_marginLeft="@dimen/rtc_small_avatar_n_half_size"
            android:layout_marginStart="@dimen/rtc_small_avatar_n_half_size"
            app:shadowColor="#000"
            app:shadowSize="1dp"
            layout="@layout/user_avatar_layout_mini_nobadge"
            style="@style/AvatarImageView"/>
        <include
            android:id="@+id/avatar3"
            android:layout_width="@dimen/rtc_small_avatar_size"
            android:layout_height="@dimen/rtc_small_avatar_size"
            android:layout_marginLeft="@dimen/rtc_small_avatar_n_half_size"
            android:layout_marginStart="@dimen/rtc_small_avatar_n_half_size"
            app:shadowColor="#000"
            app:shadowSize="1dp"
            layout="@layout/user_avatar_layout_mini_nobadge"
            style="@style/AvatarImageView"/>
        <FrameLayout
            android:id="@+id/last_avatar_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="@dimen/rtc_small_avatar_size"
            android:layout_height="@dimen/rtc_small_avatar_size"
            android:layout_marginLeft="@dimen/rtc_small_avatar_n_half_size"
            android:layout_marginStart="@dimen/rtc_small_avatar_n_half_size">
            <include
                android:id="@+id/avatar4"
                android:layout_width="@dimen/rtc_small_avatar_size"
                android:layout_height="@dimen/rtc_small_avatar_size"
                app:shadowColor="#000"
                app:shadowSize="1dp"
                layout="@layout/user_avatar_layout_mini_nobadge"
                style="@style/AvatarImageView"/>
            <com.narvii.widget.NVImageView
                android:layout_gravity="center"
                android:id="@+id/overlay"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="#40000000"
                android:scaleType="centerInside"
                app:cornerRadius="1000dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/more"
                android:padding="6dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_more_online_bar"
                android:scaleType="centerInside"/>
        </FrameLayout>
    </com.narvii.widget.ReverseDrawingOrderLinearLayout>
</LinearLayout>

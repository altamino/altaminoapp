<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/headline_feed_detail_bottom_container"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_width="0pt"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/healine_bottom_vote_container"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.narvii.widget.BottomVoteIcon
            android:id="@+id/headline_vote_icon"
            android:layout_width="21dp"
            android:layout_height="18dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_bottom_vote_normal"
            android:scaleType="centerInside"
            narvii:vote_normal_icon="@drawable/ic_bottom_vote_normal"
            narvii:vote_voted_icon="@drawable/ic_bottom_voted"/>
        <com.narvii.widget.SpinningView
            android:id="@+id/headline_vote_progress"
            android:visibility="gone"
            android:layout_width="21dp"
            android:layout_height="18dp"
            android:layout_marginTop="4dp"
            narvii:spinColor="#adaebb"
            narvii:spinStyle="2"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#fff"
            android:gravity="center"
            android:layout_gravity="start|top"
            android:id="@+id/headline_vote_count"
            android:background="@drawable/feed_bottom_vote_count_bg"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginStart="15dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/healine_bottom_comment_container"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.narvii.widget.TintButton
            android:id="@+id/headline_comment_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_bottom_comment"
            android:scaleType="centerInside"
            narvii:tintColor="#adaebb"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#fff"
            android:gravity="center"
            android:layout_gravity="start|top"
            android:id="@+id/headline_comment_count"
            android:background="@drawable/feed_bottom_vote_count_bg"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginStart="15dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/healine_bottom_share_container"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <com.narvii.widget.TintButton
            android:layout_gravity="center_vertical"
            android:id="@+id/headline_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_share"
            android:scaleType="centerInside"
            narvii:tintColor="#adaebb"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/healine_bottom_more_container"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <com.narvii.widget.TintButton
            android:id="@+id/headline_more"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ic_share_more"
            android:scaleType="centerInside"
            narvii:tintColor="#adaebb"/>
    </FrameLayout>
</LinearLayout>

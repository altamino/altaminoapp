<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:padding="7dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/mentioned_user_item_height">
    <include
        android:layout_width="36dp"
        android:layout_height="36dp"
        layout="@layout/user_avatar_layout_mini"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="0px"
        android:layout_height="match_parent"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="14dp"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="14dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <com.narvii.widget.NicknameView
                android:textSize="14dp"
                android:textColor="#fff"
                android:id="@+id/nickname"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"/>
            <TextView
                android:textSize="10dp"
                android:textColor="#000"
                android:layout_gravity="center_vertical"
                android:id="@+id/host_label"
                android:background="@drawable/round_white_corner_2"
                android:paddingLeft="4dp"
                android:paddingTop="2dp"
                android:paddingRight="4dp"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:maxLines="1"/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="#aaa"
            android:ellipsize="end"
            android:id="@+id/address"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#aaa"
            android:ellipsize="end"
            android:id="@+id/amino_id"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#aaa"
            android:ellipsize="end"
            android:id="@+id/extra_info"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="true"/>
    </LinearLayout>
    <com.narvii.widget.FullHitFrameLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <TextView
            android:textSize="12dp"
            android:textColor="#fff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/disabled"
            android:background="@drawable/radius_red"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/disabled"/>
    </com.narvii.widget.FullHitFrameLayout>
</LinearLayout>

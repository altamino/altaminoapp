<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:narvii="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="@dimen/template_picker_padding_h"
    android:paddingTop="5dp"
    android:paddingRight="@dimen/template_picker_padding_h"
    android:paddingBottom="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.narvii.transition.TransitionLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.narvii.widget.GradientView
            android:id="@+id/gradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include layout="@layout/amino_template_picker_item_collapse"/>
        <include layout="@layout/amino_template_picker_item_expand"/>
        <com.narvii.widget.TintButton
            android:layout_gravity="end"
            android:id="@+id/chevron"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/chevron_right_mirror"
            android:layout_marginEnd="10dp"
            narvii:tintColor="#fff"/>
    </com.narvii.transition.TransitionLayout>
</FrameLayout>

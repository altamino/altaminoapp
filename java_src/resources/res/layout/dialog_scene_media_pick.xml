<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/blur_bg"
        android:background="#74000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.narvii.widget.RadiusLayout
        android:layout_gravity="bottom"
        android:id="@+id/media_content_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_corner_radius_left_top="15dp"
        app:layout_corner_radius_right_top="15dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/content_view"
            android:background="#1f1a2e"
            android:paddingTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/recent_media_container"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recent_video"
                    android:alpha="0.4"/>
                <RelativeLayout
                    android:id="@+id/recent_media"
                    android:background="@drawable/button_round_purple_gray"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp">
                    <FrameLayout
                        android:id="@+id/recent_media_icon_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.narvii.widget.ThumbImageView
                            android:layout_gravity="center"
                            android:id="@+id/recent_media_icon"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:scaleType="centerCrop"
                            app:cornerRadius="5dp"
                            app:hidePlayButton="true"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="31dp"
                            android:layout_height="31dp"
                            android:src="@drawable/ic_sr_media_play"/>
                    </FrameLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_toRightOf="@+id/recent_media_icon_layout"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="15dp"
                        android:layout_toEndOf="@+id/recent_media_icon_layout">
                        <TextView
                            android:textSize="16dp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:ellipsize="end"
                            android:id="@+id/recent_media_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:lines="1"/>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="@color/white"
                            android:ellipsize="end"
                            android:id="@+id/recent_media_path"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:lines="1"/>
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/photo_library"
                    android:background="@drawable/button_round_purple_gray"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp">
                    <ImageView
                        android:layout_width="41dp"
                        android:layout_height="41dp"
                        android:layout_marginBottom="6dp"
                        android:src="@drawable/ic_photo_library"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/white"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/photo_library"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/online_video"
                    android:background="@drawable/button_round_purple_gray"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp">
                    <ImageView
                        android:layout_width="41dp"
                        android:layout_height="41dp"
                        android:layout_marginBottom="6dp"
                        android:src="@drawable/ic_video_online"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/white"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/online_video"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/video_template_layout"
                    android:background="@drawable/button_round_purple_gray"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp">
                    <ImageView
                        android:layout_width="41dp"
                        android:layout_height="41dp"
                        android:layout_marginBottom="6dp"
                        android:src="@drawable/ic_video_template"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/white"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/video_template"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/video_template"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="45dp">
                <com.narvii.widget.TintButton
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginRight="6dp"
                    android:src="@drawable/ic_video_template"
                    app:tintColor="#0cf2be"/>
                <TextView
                    android:textColor="#0cf2be"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_video_template"/>
            </LinearLayout>
            <TextView
                android:textSize="14dp"
                android:textColor="#7d7d9f"
                android:gravity="center"
                android:id="@+id/cancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="45dp"
                android:text="@string/cancel"/>
        </LinearLayout>
    </com.narvii.widget.RadiusLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:background="#0000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="#0000"
        android:layout_width="280dp"
        android:layout_height="340dp">
        <com.narvii.widget.ThumbImageView
            android:id="@+id/rate_background"
            android:background="@drawable/rate_round_white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cornerRadius="8dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="#0000"
            android:layout_width="match_parent"
            android:layout_height="340dp">
            <LinearLayout
                android:orientation="vertical"
                android:background="#0000"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="240dp">
                <com.narvii.widget.AutoSizingTextView
                    android:textSize="20dp"
                    android:textColor="#fff"
                    android:gravity="center_horizontal"
                    android:id="@+id/rate_community_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="6dp"
                    android:maxLines="2"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:autoSizeTextMaxSize="20dp"
                    app:autoSizeTextMinSize="14dp"/>
                <com.narvii.widget.ThumbImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/rate_community_icon"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:cornerRadius="10dp"
                    app:defaultDrawable="@drawable/placeholder_community"
                    app:imageType="community-icon"/>
                <com.narvii.widget.AutoSizingTextView
                    android:textSize="14dp"
                    android:textColor="#fff"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/rate_community_name"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="3dp"
                    android:maxLines="1"
                    app:autoSizeTextMaxSize="14dp"
                    app:autoSizeTextMinSize="8dp"
                    app:minTextSize="8dp"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.narvii.widget.ShinyTitle
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="35dp">
                        <ImageView
                            android:id="@+id/rate_one_star"
                            android:padding="1dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/rate_star"/>
                        <ImageView
                            android:id="@+id/rate_two_star"
                            android:padding="1dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/rate_star"/>
                        <ImageView
                            android:padding="1dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/rate_star"/>
                        <ImageView
                            android:id="@+id/rate_four_star"
                            android:padding="1dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/rate_star"/>
                        <ImageView
                            android:id="@+id/rate_five_star"
                            android:padding="1dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/rate_star"/>
                    </com.narvii.widget.ShinyTitle>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/rate_now"
                android:background="@drawable/rate_love_background"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="50dp">
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="#fff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rate_app_rate_now"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/rate_love_icon"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/rate_never"
                android:background="@drawable/rate_round_bottom"
                android:layout_width="match_parent"
                android:layout_height="50dp">
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="#270b9f"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rate_app_do_not_like"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/rate_feedback_icon"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:layout_gravity="start|top"
            android:id="@+id/rate_close"
            android:background="@drawable/button_round_transparent"
            android:padding="8dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/rate_close_icon"
            android:layout_marginStart="2dp"/>
    </FrameLayout>
</LinearLayout>

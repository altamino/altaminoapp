<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="4dp"/>
            <solid android:color="#d4d3db"/>
            <stroke
                android:width="0.5sp"
                android:color="#0000"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="4dp"/>
            <solid android:color="#583699"/>
            <stroke
                android:width="0.5sp"
                android:color="#0000"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="4dp"/>
            <solid android:color="#583699"/>
            <stroke
                android:width="0.5sp"
                android:color="#0000"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="4dp"/>
            <solid android:color="#9359ff"/>
            <stroke
                android:width="0.5sp"
                android:color="#0000"/>
        </shape>
    </item>
</selector>

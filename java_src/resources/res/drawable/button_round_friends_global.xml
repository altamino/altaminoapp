<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="5dp"/>
            <gradient
                android:startColor="#9349b3"
                android:endColor="#8e40b3"
                android:angle="0"/>
            <stroke
                android:width="0.5sp"
                android:color="#0000"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="5dp"/>
            <gradient
                android:startColor="#d168ff"
                android:endColor="#ca5bff"
                android:angle="0"/>
            <stroke
                android:width="0.5sp"
                android:color="#0000"/>
        </shape>
    </item>
</selector>

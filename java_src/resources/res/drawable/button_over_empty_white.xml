<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#0000"/>
            <stroke
                android:width="1dp"
                android:color="#aaa"
                android:dashWidth="3dp"
                android:dashGap="2dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#0000"/>
            <stroke
                android:width="1dp"
                android:color="#aaa"
                android:dashWidth="3dp"
                android:dashGap="2dp"/>
        </shape>
    </item>
</selector>

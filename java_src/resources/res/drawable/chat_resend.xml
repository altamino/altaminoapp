<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <stroke
                android:width="0.5dp"
                android:color="#0000"/>
            <solid android:color="#ae0017"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <stroke
                android:width="0.5dp"
                android:color="#0000"/>
            <solid android:color="#ae0017"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="0.5dp"
                android:color="#0000"/>
            <solid android:color="#ed1b25"/>
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#0f000000"/>
            <size
                android:height="27dp"
                android:width="27dp"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="oval">
            <solid android:color="#fff"/>
            <stroke
                android:width="2dp"
                android:color="#fff"/>
            <size
                android:height="25dp"
                android:width="25dp"/>
        </shape>
    </item>
</layer-list>

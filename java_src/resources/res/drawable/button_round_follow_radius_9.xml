<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="9dp"/>
            <gradient
                android:startColor="#00bee3"
                android:endColor="#2c9ed6"
                android:angle="0"/>
            <stroke
                android:width="0.5sp"
                android:color="#0000"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="9dp"/>
            <solid android:color="@color/user_follow_bg"/>
            <gradient
                android:startColor="#00d5ff"
                android:endColor="#31bbff"
                android:angle="0"/>
            <stroke
                android:width="0.5sp"
                android:color="#0000"/>
        </shape>
    </item>
</selector>

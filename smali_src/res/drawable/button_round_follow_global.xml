<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="5.0dp" />
            <gradient android:startColor="#0095b3" android:endColor="#2282b3" android:angle="0.0" />
            <stroke android:width="0.5sp" android:color="#1000" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="5.0dp" />
            <gradient android:startColor="#00d5ff" android:endColor="#31bbff" android:angle="0.0" />
            <stroke android:width="0.5sp" android:color="#1000" />
        </shape>
    </item>
</selector>

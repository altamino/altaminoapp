<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#4011f7d1" />
            <corners android:radius="5.0dp" />
            <stroke android:width="1.0dp" android:color="#8011f7d1" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#1911f7d1" />
            <corners android:radius="5.0dp" />
            <stroke android:width="1.0dp" android:color="#8011f7d1" />
        </shape>
    </item>
</selector>

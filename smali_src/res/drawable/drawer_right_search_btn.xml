<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="4.0dp" />
            <solid android:color="#3fff" />
            <stroke android:width="0.5dp" android:color="#cfff" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="4.0dp" />
            <solid android:color="#3000" />
            <stroke android:width="0.5dp" android:color="#8fff" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="17.0dp" />
            <solid android:color="#d78f91" />
            <padding android:left="5.0dp" />
            <stroke android:width="0.5sp" android:color="#a8a8a8" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="17.0dp" />
            <solid android:color="#d78f91" />
            <padding android:left="5.0dp" />
            <stroke android:width="0.5sp" android:color="#a8a8a8" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="17.0dp" />
            <solid android:color="#f9d6d6" />
            <padding android:left="5.0dp" />
            <stroke android:width="0.5sp" android:color="#a8a8a8" />
        </shape>
    </item>
</selector>
